@page
@model YIS.Pages.Sellers.IndexModel
@{
    ViewData["Title"] = "Seller Account";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    @if (Model.Seller != null)
    {
        <!-- Seller Info Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-shop me-2"></i>
                    Seller Information
                </h5>
                <a href="/Sellers/Create" class="btn btn-light btn-sm">
                    <i class="bi bi-pencil me-1"></i>
                    Edit Seller
                </a>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold text-muted small">Seller Name</label>
                        <p class="mb-0 fw-medium">@Model.Seller.SellerName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold text-muted small">Contact</label>
                        <p class="mb-0 fw-medium">@Model.Seller.SellerContact</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold text-muted small">Email</label>
                        <p class="mb-0 fw-medium">@Model.Seller.SellerEmail</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold text-muted small">Address</label>
                        <p class="mb-0 fw-medium">@Model.Seller.SellerAddress</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Company Profiles Card -->
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-building me-2"></i>
                    Company Profiles
                </h5>
                <a href="/CompanyProfile/Index" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>
                    Manage Profiles
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.CompanyProfiles != null && Model.CompanyProfiles.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 px-4 py-3">Company Name</th>
                                    <th class="border-0 px-4 py-3">NTN</th>
                                    <th class="border-0 px-4 py-3">Province</th>
                                    <th class="border-0 px-4 py-3 text-center">Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var profile in Model.CompanyProfiles)
                                {
                                    <tr class="@(profile.UcpId == Model.CurrentUcpId ? "table-success" : "")">
                                        <td class="px-4 py-3">
                                            <span class="fw-semibold">@profile.UcpCompanyName</span>
                                        </td>
                                        <td class="px-4 py-3">@profile.UcpCompanyNtn</td>
                                        <td class="px-4 py-3">@profile.UcpCompanyProvince</td>
                                        <td class="px-4 py-3 text-center">
                                            <form method="post" asp-page-handler="ToggleActive" asp-route-profileId="@profile.UcpId" style="display:inline;">
                                                <div class="form-check form-switch d-inline-block">
                                                     <input class="form-check-input" 
                                                            type="checkbox" 
                                                            @(profile.UcpId == Model.CurrentUcpId ? "checked" : "")
                                                           onchange="this.form.submit()"
                                                           style="cursor: pointer; width: 3rem; height: 1.5rem;">
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-building text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">No Company Profiles</h5>
                        <p class="text-muted">Add company profiles from the manage profiles page</p>
                        <a href="/CompanyProfile/Index" class="btn btn-info">
                            <i class="bi bi-plus-lg me-1"></i>
                            Add Company Profile
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- No Seller Card -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-shop text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">No Seller Account</h4>
                <p class="text-muted mb-4">Create your seller account to get started</p>
                <a href="/Sellers/Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>
                    Create Seller Account
                </a>
            </div>
        </div>
    }
</div>
