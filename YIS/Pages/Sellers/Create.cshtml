@page
@model YIS.Pages.Sellers.CreateModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Seller Account" : "Create Seller Account";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header @(Model.IsEditMode ? "bg-info" : "bg-primary") text-white">
                <h5 class="mb-0">
                    <i class="bi @(Model.IsEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @ViewData["Title"]
                </h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                    @if (Model.IsEditMode)
                    {
                        <input type="hidden" asp-for="Seller.SellerId" />
                        <div class="alert alert-info py-2 small mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            Editing existing seller account. System is restricted to one seller only.
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Seller.SellerName" class="form-label fw-bold">Seller / Business Name</label>
                        <input asp-for="Seller.SellerName" class="form-control" placeholder="Enter your business name" required />
                        <span asp-validation-for="Seller.SellerName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Seller.SellerContact" class="form-label fw-bold">Contact Number</label>
                            <input asp-for="Seller.SellerContact" class="form-control" placeholder="e.g. +92 300 1234567" />
                            <span asp-validation-for="Seller.SellerContact" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Seller.SellerEmail" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Seller.SellerEmail" class="form-control" type="email" placeholder="email@example.com" />
                            <span asp-validation-for="Seller.SellerEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Seller.SellerAddress" class="form-label fw-bold">Business Address</label>
                        <textarea asp-for="Seller.SellerAddress" class="form-control" rows="3" placeholder="Full business address"></textarea>
                        <span asp-validation-for="Seller.SellerAddress" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Sellers/Index" class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i>Back to Account
                        </a>
                        <button type="submit" class="btn @(Model.IsEditMode ? "btn-info" : "btn-primary") px-4">
                            <i class="bi bi-save me-2"></i>@(Model.IsEditMode ? "Update Account" : "Create Account")
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.IsEditMode)
        {
            <div class="mt-4 text-center">
                <p class="text-muted small">
                    To manage company profiles for this seller, go to the 
                    <a href="/CompanyProfile/Index" class="text-decoration-none fw-bold">Company Profiles</a> section.
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
