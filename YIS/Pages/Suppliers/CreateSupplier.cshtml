@page
@model YIS.Pages.Suppliers.CreateSupplierModel
@{
    ViewData["Title"] = (Model.Supplier?.SupplierId > 0 ? "Edit Supplier" : "Create Supplier");
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end">
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" novalidate id="supplierForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <h5 class="card-title mb-4">@(Model.Supplier?.SupplierId > 0 ? "Edit Supplier" : "Create Supplier")</h5>

            <!-- Hidden ID for edit mode -->
            @if(Model.Supplier?.SupplierId > 0)
            {
                <input type="hidden" asp-for="Supplier.SupplierId" />
            }

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.SupplierName" class="form-label">Supplier Name <span class="text-danger">*</span></label>
                    <input asp-for="Supplier.SupplierName" class="form-control" placeholder="Enter supplier name" required data-val="true" data-val-required="Supplier Name is required" />
                    <span asp-validation-for="Supplier.SupplierName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.SupplierContact" class="form-label">Contact Number</label>
                    <input asp-for="Supplier.SupplierContact" class="form-control" placeholder="Enter contact number" />
                    <span asp-validation-for="Supplier.SupplierContact" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Supplier.SupplierAddress" class="form-label">Address</label>
                    <textarea asp-for="Supplier.SupplierAddress" class="form-control" rows="2" placeholder="Enter address"></textarea>
                    <span asp-validation-for="Supplier.SupplierAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.SupplierEmail" class="form-label">Email Address</label>
                    <input asp-for="Supplier.SupplierEmail" class="form-control" placeholder="Enter email" type="email" />
                    <span asp-validation-for="Supplier.SupplierEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.SupplierDeactiveOn" class="form-label">Deactive On (Date)</label>
                    <input asp-for="Supplier.SupplierDeactiveOn" class="form-control" type="date" />
                    <div class="form-text">Leave blank if the supplier is active.</div>
                    <span asp-validation-for="Supplier.SupplierDeactiveOn" class="text-danger"></span>
                </div>
            </div>

            <!-- GL ACCOUNTS MAPPING (5 ACCOUNTS) -->
            <h6 class="mt-4 mb-3 text-muted border-bottom pb-2"><i class="bi bi-journal-bookmark me-1"></i> GL / Ledger Account Settings</h6>

            <div class="row">
                <!-- 1. Supplier Payable / Creditor Account -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.AccountId" class="form-label fw-semibold">Supplier Payable Account (Creditor)</label>
                    <select asp-for="Supplier.AccountId" class="form-select" asp-items="Model.AccountList">
                        <option value="">-- Select Supplier Ledger / Creditor Account --</option>
                    </select>
                    <div class="form-text">Supplier credit amount on purchase will post to this account.</div>
                    <span asp-validation-for="Supplier.AccountId" class="text-danger"></span>
                </div>

                <!-- 2. Purchase / Inventory Account -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Supplier.PurchaseAccountId" class="form-label fw-semibold">Default Purchase Account (Inventory/Expense)</label>
                    <select asp-for="Supplier.PurchaseAccountId" class="form-select" asp-items="Model.AccountList">
                        <option value="">-- Default (Purchase / Inventory) --</option>
                    </select>
                    <div class="form-text">Debit entry for yarn/material purchase will go here.</div>
                    <span asp-validation-for="Supplier.PurchaseAccountId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- 3. Tax Account -->
                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.TaxAccountId" class="form-label fw-semibold">Input Tax Account (GST)</label>
                    <select asp-for="Supplier.TaxAccountId" class="form-select" asp-items="Model.AccountList">
                        <option value="">-- Default (Input Sales Tax) --</option>
                    </select>
                    <div class="form-text">Debit entry for input tax will go here.</div>
                    <span asp-validation-for="Supplier.TaxAccountId" class="text-danger"></span>
                </div>

                <!-- 4. Commission Expense Account -->
                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.CommExpenseAccountId" class="form-label fw-semibold">Commission Expense Account</label>
                    <select asp-for="Supplier.CommExpenseAccountId" class="form-select" asp-items="Model.AccountList">
                        <option value="">-- Default (Commission Expense) --</option>
                    </select>
                    <div class="form-text">Debit entry for broker/agent commission.</div>
                    <span asp-validation-for="Supplier.CommExpenseAccountId" class="text-danger"></span>
                </div>

                <!-- 5. Commission Payable Account -->
                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.CommPayableAccountId" class="form-label fw-semibold">Commission Payable Account</label>
                    <select asp-for="Supplier.CommPayableAccountId" class="form-select" asp-items="Model.AccountList">
                        <option value="">-- Default (Commission Payable) --</option>
                    </select>
                    <div class="form-text">Credit entry for agent commission payable.</div>
                    <span asp-validation-for="Supplier.CommPayableAccountId" class="text-danger"></span>
                </div>
            </div>

            <h6 class="mt-4 mb-3 text-muted border-bottom pb-2">Tax & Identity Information</h6>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.SupplierNtnNo" class="form-label">NTN No</label>
                    <input asp-for="Supplier.SupplierNtnNo" class="form-control" placeholder="1234567-8" maxlength="9" />
                    <span asp-validation-for="Supplier.SupplierNtnNo" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.SupplierStrNo" class="form-label">STRN No</label>
                    <input asp-for="Supplier.SupplierStrNo" class="form-control" placeholder="Enter STRN" />
                    <span asp-validation-for="Supplier.SupplierStrNo" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Supplier.SupplierCnic" class="form-label">CNIC <span class="text-muted small">(Format: 35401-2342361-9)</span></label>
                    <input asp-for="Supplier.SupplierCnic" class="form-control" placeholder="00000-0000000-0" maxlength="15" />
                    <span asp-validation-for="Supplier.SupplierCnic" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Suppliers/Index" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-outline-success px-4">
                        Save
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ntnInput = document.getElementById('Supplier_SupplierNtnNo');
            const cnicInput = document.getElementById('Supplier_SupplierCnic');

            // CNIC Mask: 35401-2342361-9
            if (cnicInput) {
                cnicInput.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 13) value = value.substring(0, 13);

                    let formattedValue = '';
                    if (value.length > 0) formattedValue = value.substring(0, 5);
                    if (value.length > 5) formattedValue += '-' + value.substring(5, 12);
                    if (value.length > 12) formattedValue += '-' + value.substring(12, 13);
                    
                    e.target.value = formattedValue;
                });
            }

            // NTN Mask: 1234567-8
            if (ntnInput) {
                ntnInput.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/[^a-zA-Z0-9]/g, '');
                    if (value.length > 8) value = value.substring(0, 8);

                    let formattedValue = '';
                    if (value.length > 0) formattedValue = value.substring(0, 7);
                    if (value.length > 7) formattedValue += '-' + value.substring(7, 8);
                    
                    e.target.value = formattedValue;
                });
            }
        });
    </script>
}
