@page
@model YIS.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Suppliers";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get">
                        <div class="position-relative">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input" 
                                   id="supplierSearch" 
                                   placeholder="Search suppliers..."
                                   value="@Model.SearchTerm">
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    @if (Model.Suppliers != null && Model.Suppliers.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Suppliers :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end">
                    <a href="/Suppliers/CreateSupplier" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Supplier
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Supplier Name</th>
                            <th class="border-0 px-4 py-3">Contact</th>
                            <th class="border-0 px-4 py-3">Email</th>
                            <th class="border-0 px-4 py-3">NTN</th>
                            <th class="border-0 px-4 py-3">CNIC</th>
                            <th class="border-0 px-4 py-3">Status</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Suppliers != null && Model.Suppliers.Any())
                        {
                            foreach (var item in Model.Suppliers)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Suppliers/CreateSupplier?id=@item.SupplierId"
                                           class="text-decoration-none fw-semibold text-danger">
                                            @item.SupplierName
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.SupplierContact</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.SupplierEmail</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.SupplierNtnNo</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.SupplierCnic</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.SupplierDeactiveOn.HasValue)
                                        {
                                            <span class="badge bg-danger">Deactivated: @item.SupplierDeactiveOn.Value.ToString("MMM dd, yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <form method="post" 
                                              asp-page-handler="Delete" 
                                              asp-route-id="@item.SupplierId" 
                                              style="display:inline;" 
                                              onsubmit="return confirm('Are you sure you want to delete this supplier?');">
                                            <button type="submit"
                                                    class="btn btn-link p-0 border-0 bg-transparent"
                                                    title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-truck text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Suppliers Found</h5>
                                        <p class="text-muted">Create your first supplier to get started</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@* Server-side search implemented *@
