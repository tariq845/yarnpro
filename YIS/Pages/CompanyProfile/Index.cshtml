@page
@model YIS.Pages.CompanyProfile.IndexModel
@{
    ViewData["Title"] = "Company Profile(s)";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Action Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get">
                        <div class="position-relative">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input" 
                                   id="profileSearch" 
                                   placeholder="Search profiles..."
                                   value="@Model.SearchTerm"
                                   hx-get="/CompanyProfile/Index"
                                   hx-trigger="input changed delay:500ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    @if (Model.Profiles != null && Model.Profiles.Any())
                    {
                        <div class="text-center">
                            <h6 class="text-muted text-uppercase mb-0" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Total Profiles: <span class="fw-bold text-dark">@Model.Profiles.Count</span>
                            </h6>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addProfileCollapse" aria-expanded="false">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Profile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Profile Form (Collapsible) -->
    <div class="collapse @(Model.Input.UcpId > 0 ? "show" : "") mb-4" id="addProfileCollapse">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-building-add me-2"></i>
                    @(Model.Input.UcpId > 0 ? "Edit Profile" : "Add New Company Profile")
                </h5>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Input.UcpId" />
                    <input type="hidden" asp-for="Input.SellerId" />

                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label asp-for="Input.UcpCompanyName" class="form-label fw-semibold">Company Name</label>
                            <input asp-for="Input.UcpCompanyName" class="form-control" placeholder="e.g. ABC Textiles" required />
                            <span asp-validation-for="Input.UcpCompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Input.UcpCompanyNtn" class="form-label fw-semibold">NTN #</label>
                            <input asp-for="Input.UcpCompanyNtn" class="form-control" placeholder="1234567-8" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Company Logo</label>
                            <input type="file" asp-for="ProfileImage" class="form-control" accept="image/*" />
                            <div class="small text-muted mt-1">Upload a new image to update the company logo.</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Input.UcpPath))
                        {
                            <div class="col-md-6 mb-3 d-flex align-items-center">
                                <div class="ms-3">
                                    <div class="small fw-semibold mb-1 text-muted">Current Logo:</div>
                                    <img src="@Model.Input.UcpPath" alt="Company Logo" class="img-thumbnail shadow-sm" style="height: 60px; object-fit: contain;" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Input.UcpCompanyProvince" class="form-label fw-semibold">Province</label>
                            <select asp-for="Input.UcpCompanyProvince" class="form-select">
                                <option value="">Select Province</option>
                                <option value="Punjab">Punjab</option>
                                <option value="Sindh">Sindh</option>
                                <option value="KPK">KPK</option>
                                <option value="Balochistan">Balochistan</option>
                                <option value="Gilgit-Baltistan">Gilgit-Baltistan</option>
                                <option value="Azad Kashmir">Azad Kashmir</option>
                                <option value="Islamabad">Islamabad</option>
                            </select>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label asp-for="Input.UcpCompanyAddress" class="form-label fw-semibold">Physical Address</label>
                            <input asp-for="Input.UcpCompanyAddress" class="form-control" placeholder="Full business address" />
                        </div>
                    </div>

                    <hr class="my-4 text-muted border-top border-1" />
                    <h6 class="text-primary mb-3"><i class="bi bi-shield-lock me-2"></i>API & Token Settings</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.UcpSandboxToken" class="form-label fw-semibold">Sandbox Token</label>
                            <input asp-for="Input.UcpSandboxToken" class="form-control" placeholder="Enter sandbox API token" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.UcpProductionToken" class="form-label fw-semibold">Production Token</label>
                            <input asp-for="Input.UcpProductionToken" class="form-control" placeholder="Enter production API token" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-4 mb-4 mt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Input.IsProductionToken">
                            <label class="form-check-label fw-medium" asp-for="Input.IsProductionToken">Enable Production Mode</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Input.UcpIsActive">
                            <label class="form-check-label fw-medium" asp-for="Input.UcpIsActive">Set as Default Active Profile</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        @if (Model.Input.UcpId > 0)
                        {
                            <a href="/CompanyProfile/Index" class="btn btn-light border">Cancel</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-light border" data-bs-toggle="collapse" data-bs-target="#addProfileCollapse">Close</button>
                        }
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-2"></i>@(Model.Input.UcpId > 0 ? "Update Profile" : "Save Profile")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Company Details</th>
                            <th class="border-0 px-4 py-3">Location</th>
                            <th class="border-0 px-4 py-3">Mode</th>
                            <th class="border-0 px-4 py-3 text-center">Status</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Profiles != null && Model.Profiles.Any())
                        {
                            foreach (var profile in Model.Profiles)
                            {
                                <tr class="@(profile.UcpId == Model.CurrentUcpId ? "table-success-subtle" : "")">
                                    <td class="px-4 py-3 d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(profile.UcpPath))
                                        {
                                            <img src="@profile.UcpPath" alt="Logo" class="rounded-circle me-3 border" style="width: 48px; height: 48px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 border" style="width: 48px; height: 48px;">
                                                <i class="bi bi-building text-muted fs-5"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-primary">@profile.UcpCompanyName</div>
                                            <div class="small text-muted">
                                                NTN: @(string.IsNullOrEmpty(profile.UcpCompanyNtn) ? "N/A" : profile.UcpCompanyNtn)
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="fw-medium text-dark">@profile.UcpCompanyProvince</div>
                                        <div class="small text-muted">@profile.UcpCompanyAddress</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (profile.IsProductionToken)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">PRODUCTION</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3">SANDBOX</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        @if (profile.UcpId == Model.CurrentUcpId)
                                        {
                                            <span class="badge bg-success border border-success text-success bg-opacity-10 px-3 py-2">
                                                 <i class="bi bi-check-circle-fill me-1"></i> ACTIVE
                                            </span>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="SetActive" asp-route-id="@profile.UcpId">
                                                <button type="submit" class="btn btn-outline-info btn-sm rounded-pill px-3">
                                                     Set Active
                                                </button>
                                            </form>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <div class="btn-group">
                                            <a href="/CompanyProfile/Index?id=@profile.UcpId" class="btn btn-sm btn-light border" title="Edit">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@profile.UcpId" 
                                                  onsubmit="return confirm('Are you sure you want to delete this profile?');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-light border" title="Delete">
                                                    <i class="bi bi-trash-fill text-danger"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-building-x text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Profiles Found</h5>
                                        <p class="text-muted">Click the "Add Profile" button to get started.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .table-success-subtle {
            background-color: rgba(25, 135, 84, 0.05);
        }
    </style>
}
