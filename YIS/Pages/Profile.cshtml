@page
@model YIS.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<style>
    /* Remove button effects for eye icon */
    .password-toggle:hover,
    .password-toggle:focus,
    .password-toggle:active {
        background-color: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
    }
</style>

<div class="row">
    <!-- User Information Card -->
    <div class="col-md-5 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title">User Information</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <div style="width: 80px; height: 80px; background-color: var(--primary-color); border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 600; margin: 0 auto;">
                        @{
                            string initials = "U";
                            if (!string.IsNullOrEmpty(Model.CurrentUser?.UmName))
                            {
                                var parts = Model.CurrentUser.UmName.Split(' ');
                                if (parts.Length > 1) { initials = $"{parts[0][0]}{parts[1][0]}".ToUpper(); }
                                else { initials = Model.CurrentUser.UmName.Substring(0, 1).ToUpper(); }
                            }
                        }
                        @initials
                    </div>
                    <h5 class="mt-3 mb-1">@Model.CurrentUser?.UmName</h5>
                    <p class="text-muted">@Model.CurrentUser?.UmUsername</p>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Full Name</span>
                        <span class="fw-medium">@Model.CurrentUser?.UmName</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Username</span>
                        <span class="fw-medium">@Model.CurrentUser?.UmUsername</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Contact</span>
                        <span class="fw-medium">@(string.IsNullOrEmpty(Model.CurrentUser?.UmContact) ? "Not set" : Model.CurrentUser.UmContact)</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Account Created</span>
                        <span class="fw-medium">@(Model.CurrentUser?.CreationOn?.ToString("dd MMM yyyy") ?? "-")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Last Login</span>
                        <span class="fw-medium">@(Model.CurrentUser?.LastLogin?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Password Card -->
    <div class="col-md-7 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Security Settings</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showToast('Test Toast!', 'info')">
                    Test Toast
                </button>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="ChangePassword" 
                      hx-post="@Url.Page("/Profile", "ChangePassword")" 
                      hx-target="body" 
                      hx-swap="outerHTML">
                    <h6 class="mb-3">Change Password</h6>
                    <p class="text-muted small mb-4">
                        To ensure your account's security, you must provide your current password correctly before setting a new one.
                    </p>

                    <div class="mb-3">
                        <label asp-for="ChangePasswordInput.CurrentPassword" class="form-label"></label>
                        <div class="input-group position-relative">
                            <input asp-for="ChangePasswordInput.CurrentPassword" class="form-control pe-5" id="currentPassword" />
                            <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3 password-toggle" data-target="currentPassword" style="z-index: 5;">
                                <i class="bi bi-eye text-muted"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangePasswordInput.CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ChangePasswordInput.NewPassword" class="form-label"></label>
                            <div class="input-group position-relative">
                                <input asp-for="ChangePasswordInput.NewPassword" class="form-control pe-5" id="newPassword" />
                                <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3 password-toggle" data-target="newPassword" style="z-index: 5;">
                                    <i class="bi bi-eye text-muted"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ChangePasswordInput.NewPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ChangePasswordInput.ConfirmPassword" class="form-label"></label>
                            <div class="input-group position-relative">
                                <input asp-for="ChangePasswordInput.ConfirmPassword" class="form-control pe-5" id="confirmPassword" />
                                <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3 password-toggle" data-target="confirmPassword" style="z-index: 5;">
                                    <i class="bi bi-eye text-muted"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ChangePasswordInput.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-lock"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleButtons = document.querySelectorAll('.password-toggle');
            
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                });
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
