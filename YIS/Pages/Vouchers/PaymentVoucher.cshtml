@page
@model YIS.Pages.Vouchers.PaymentVoucherModel
@{
    ViewData["Title"] = "Payment Voucher";
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-4 text-end"></div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-4">
            Payment Voucher
            <span class="badge bg-light text-dark fs-6 float-end">@Model.DisplayEntryNumber</span>
            @if (Model.IsPosted)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success me-2 float-end fs-6">
                    <i class="bi bi-check-circle-fill me-1"></i> Posted
                </span>
            }
        </h5>

        @if (Model.IsPosted)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-lock-fill flex-shrink-0 me-2 fs-4"></i>
                <div>
                    <strong>Locked:</strong> This voucher has been posted to the ledger and cannot be edited.
                </div>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Entry.EntryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Entry.EntryDate" class="form-label fs-6">Date <span
                                    class="text-danger">*</span></label>
                            <input asp-for="Entry.EntryDate" type="date" class="form-control fs-6" readonly required
                                disabled="@Model.IsPosted" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fs-6">Supplier</label>
                            <select id="supplierDropdown" asp-for="Entry.EntryAttribute2" asp-items="Model.SupplierList"
                                class="form-select fs-6" disabled="@Model.IsPosted">
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>
                        @* Removed Bank/Cash Account from header as per request *@

                    </div>

                </div>
                <div class="col-md-8">
                    <label class="form-label">Notes</label>
                    <textarea asp-for="Entry.EntryRemarks" class="form-control fs-6" rows="4"
                        placeholder="Enter voucher remarks..." disabled="@Model.IsPosted"></textarea>
                </div>
                <!-- EntryAttribute1: Bank/Cash Account -->


            </div>

            <div class="mb-4">
                <h6 class="mb-3 text-muted border-bottom pb-2">Line Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 25%;">Account <span class="text-danger">*</span></th>
                                <th style="width: 15%;">Cheque No</th>
                                <th style="width: 15%;">Cheque Date</th>
                                <th style="width: 25%;">Description</th>
                                <th style="width: 15%;">Amount <span class="text-danger">*</span></th>
                            </tr>
                        </thead>
                        <tbody id="pBody">
                            @for (int i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr class="p-row">
                                    <input type="hidden" name="LineItems[@i].EntryId" value="@Model.LineItems[i].EntryId" />
                                    <td>
                                        <select name="LineItems[@i].LinkedAccountId" class="form-select form-select-sm"
                                            required disabled="@Model.IsPosted">
                                            <option value="">-- Select Account --</option>
                                            @foreach (var acc in Model.BankCashAccountList)
                                            {
                                                if (Model.LineItems[i].LinkedAccountId?.ToString() == acc.Value)
                                                {
                                                    <option value="@acc.Value" selected>@acc.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@acc.Value">@acc.Text</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td><input type="text" name="LineItems[@i].ChequeNo"
                                            value="@Model.LineItems[i].ChequeNo" class="form-control form-control-sm"
                                            placeholder="Cheque #" disabled="@Model.IsPosted" /></td>
                                    <td><input type="date" name="LineItems[@i].ChequeDate"
                                            value="@Model.LineItems[i].ChequeDate?.ToString("yyyy-MM-dd")"
                                            class="form-control form-control-sm" disabled="@Model.IsPosted" /></td>
                                    @* <td><input type="text" name="LineItems[@i].Description"
                                value="@Model.LineItems[i].Description" row="2" class="form-control form-control-sm"
                                placeholder="Description" /></td> *@
                                    <td><textarea name="LineItems[@i].Description" class="form-control form-control-sm"
                                            style="font-size:smaller;" rows="2" placeholder="Description"
                                            disabled="@Model.IsPosted">@Model.LineItems[i].Description</textarea></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Amount"
                                            value="@Model.LineItems[i].Amount"
                                            class="form-control form-control-sm amt-input text-end" placeholder="0.00"
                                            required disabled="@Model.IsPosted" /></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="bg-light fw-bold">
                                <td colspan="4" class="text-end py-2 align-middle text-uppercase text-muted small">
                                    <span>Grand Total:</span>
                                </td>
                                <td><input type="text" id="grandTotal"
                                        class="form-control form-control-sm fw-bold text-end border-0 bg-transparent fs-6 text-success"
                                        readonly /></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Vouchers/PaymentVoucherIndex" class="btn btn-outline-secondary px-4">Cancel</a>
                    @if (!Model.IsPosted)
                    {
                        <button type="submit" class="btn btn-outline-success px-5">Save</button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.getElementById('pBody');

            function calcTotal() {
                let total = 0;
                document.querySelectorAll('.amt-input').forEach(i => {
                    total += parseFloat(i.value) || 0;
                });
                const display = document.getElementById('grandTotal');
                if (display) display.value = total.toFixed(2);
            }

            // Input Event
            body.addEventListener('input', function (e) {
                if (e.target.classList.contains('amt-input')) {
                    calcTotal();
                }
            });

            calcTotal();
        });
    </script>
}
