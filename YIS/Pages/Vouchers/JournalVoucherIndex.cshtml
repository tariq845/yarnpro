@page
@model YIS.Pages.Vouchers.JournalVoucherIndexModel
@{
    ViewData["Title"] = "Journal Vouchers";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" id="jvSearchForm" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SortDir" id="sortDirInput" value="@Model.SortDir" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />

                        <div class="position-relative flex-grow-1">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input pe-4" 
                                   id="voucherSearch" 
                                   list="jvSearchDatalist"
                                   placeholder="Search (e.g. jv-1, 1, account)..."
                                   value="@Model.SearchTerm"
                                   autocomplete="off"
                                   hx-get="/Vouchers/JournalVoucherIndex"
                                   hx-include="#jvSearchForm"
                                   hx-trigger="input changed delay:400ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="javascript:void(0)" 
                                   onclick="clearSearchInput('voucherSearch', 'jvSearchForm')"
                                   class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none"
                                   title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </a>
                            }
                            <datalist id="jvSearchDatalist">
                                @foreach (var item in Model.SearchSuggestions)
                                {
                                    <option value="@item">@item</option>
                                }
                            </datalist>
                        </div>

                        <!-- Up to Down / Down to Up Sort Direction Button -->
                        <button type="button" 
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                id="btnToggleSort"
                                onclick="toggleSortDirection('sortDirInput', 'jvSearchForm')"
                                title="@(Model.SortDir == "asc" ? "Sort: Oldest first (Up to Down). Click for Newest first." : "Sort: Newest first (Down to Up). Click for Oldest first.")">
                            <i class="bi @(Model.SortDir == "asc" ? "bi-sort-up text-primary fw-bold" : "bi-sort-down text-dark fw-bold") fs-6"></i>
                            <span class="small d-none d-lg-inline">@(Model.SortDir == "asc" ? "Oldest First" : "Newest First")</span>
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                     @if (Model.VoucherList != null && Model.VoucherList.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Vouchers :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end d-flex justify-content-end align-items-center gap-2">
                    <a asp-page-handler="DownloadExcel" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success text-nowrap" title="Export to Excel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                    <a href="/Vouchers/JournalVoucher" class="btn btn-primary text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add New Voucher
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Voucher #</th>
                            <th class="border-0 px-4 py-3">Date</th>
                            <th class="border-0 px-4 py-3 text-center">Items</th>
                            <th class="border-0 px-4 py-3 text-end">Total Amount</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.VoucherList != null && Model.VoucherList.Any())
                        {
                            foreach (var item in Model.VoucherList)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a asp-page="./JournalVoucher" asp-route-id="@item.EntryId" class="text-decoration-none fw-semibold text-danger">
                                            JV-@item.EntryNumber
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@(item.EntryDate?.ToString("dd-MM-yyyy"))</span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="badge bg-secondary rounded-pill">@item.ItemCount</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <span class="fw-bold text-dark">@item.Amount?.ToString("N2")</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        @if (item.IsPosted)
                                        {
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                <span class="d-inline-flex align-items-center px-2 py-1 rounded-2 fw-medium text-success bg-success bg-opacity-10 border border-success border-opacity-25" style="font-size: 0.75rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Posted
                                                </span>
                                                <form method="post" asp-page-handler="UnpostFromLedger" asp-route-id="@item.EntryId" class="d-inline" onsubmit="return confirm('Unpost JV-@item.EntryNumber from ledger?\n\nThis will remove GL entries and unlock this voucher for editing.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning p-1 border-0" title="Unpost from Ledger">
                                                        <i class="bi bi-arrow-counterclockwise text-warning fs-6"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="PostToLedger" asp-route-id="@item.EntryId" class="d-inline" onsubmit="return confirm('Post this Journal voucher to ledger?');">
                                                <button type="submit" class="btn btn-link p-0 border-0 bg-transparent me-2" title="Post to Ledger">
                                                    <i class="bi bi-journal-check text-info"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.EntryId" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this voucher?');">
                                                <button type="submit" class="btn btn-link p-0 border-0 bg-transparent" title="Delete">
                                                    <i class="bi bi-trash text-danger"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                             <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Journal Vouchers Found</h5>
                                        <p class="text-muted">Click "Add New Voucher" to create one.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('submit', function (e) {
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');

            if (btn && (btn.title === 'Post to Ledger' || form.getAttribute('asp-page-handler') === 'PostToLedger' || btn.title === 'Unpost from Ledger' || form.getAttribute('asp-page-handler') === 'UnpostFromLedger')) {
                // Wait for the confirm dialog (if any) to finish
                setTimeout(() => {
                    if (!e.defaultPrevented) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm text-warning" role="status" aria-hidden="true"></span>';
                    }
                }, 10);
            }
        });
    </script>
}
