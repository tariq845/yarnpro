@page
@model YIS.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
    Layout = "_LoginLayout";
}

<style>
    /* Remove Bootstrap blue focus ring/shadow */
    .form-control:focus {
        box-shadow: none !important;
        border-color: #dee2e6 !important; /* Keep border gray or use #4f46e5 for brand */
    }
    .input-group-text {
        border-color: #dee2e6 !important;
    }
</style>

<div class="row w-100 g-0 ">
    <!-- Left Side: Branding (Hidden on mobile) -->
    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center align-items-center text-white position-relative overflow-hidden">
        
    

        <div class="position-relative z-1 text-center" style='height: 100vh;width: 100%;'>
           
                <img src="~/img/3.png" alt="Yarn Pro" class="img-fluid" />
    
        </div>
        
       
    </div>

    <!-- Right Side: Login Form -->
    <div class="col-lg-6 d-flex flex-column justify-content-center align-items-center bg-white px-4 px-lg-5 py-5">
        <div class="w-100" style="max-width: 420px;">
            <div class="mb-5 text-center text-lg-start">
                <img src="~/img/Favicon.png" alt="Yarn Pro" class="d-lg-none mb-3" style="height: 48px; width: auto;" />
                <h2 class="fw-bold text-dark mb-2">Sign In</h2>
                <p class="text-secondary">Please enter your credentials to continue.</p>
            </div>

            <form method="post" novalidate>
                 <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 small py-2 px-3" role="alert"></div>

                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 11px;">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-secondary ps-3 border rounded-start-2">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Username" class="form-control bg-light border-start-0 ps-2 py-2 border rounded-end-2" placeholder="Enter username" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px; font-size: 11px;">Password</label>
                     <div class="input-group position-relative">
                        <span class="input-group-text bg-light border-end-0 text-secondary ps-3 border rounded-start-2">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" id="passwordInput" class="form-control bg-light border-start-0 ps-2 py-2 border rounded-end-2 pe-5" placeholder="••••••••" />
                        
                        <!-- Eye Icon Overlay -->
                        <button type="button" id="togglePassword" class="position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3" style="right: 0px; z-index: 10;">
                            <i class="bi bi-eye text-muted" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                     
                    <!-- Forgot password link placeholder -->
                    <!-- <a href="#" class="text-primary text-decoration-none small fw-semibold">Forgot password?</a> -->
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-4" style="background-color: #4f46e5; border-color: #4f46e5;">
                    Sign In <i class="bi bi-arrow-right ms-2"></i>
                </button>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePassword')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
