@page
@model YIS.Pages.Sales.SaleReturnModel
@{
    ViewData["Title"] = "Sale Return (Credit Note)";
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-4 text-end"></div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form method="post" id="returnForm">
            <h5 class="card-title mb-4 fw-bold text-dark">
                Credit Note (Sale Return)
                <span class="badge bg-light text-dark fs-6 float-end shadow-sm">@Model.DisplayEntryNumber</span>
                @if (Model.IsPosted)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success me-2 float-end fs-6">
                        <i class="bi bi-bank me-1"></i> Ledger Posted
                    </span>
                }
            </h5>

            @if (Model.IsPosted)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-lock-fill flex-shrink-0 me-2 fs-4"></i>
                    <div>
                        <strong>Locked:</strong> This credit note has been posted to the ledger and cannot be edited.
                    </div>
                </div>
            }
            
            <input type="hidden" asp-for="Entry.EntryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Header Info -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryDate" class="form-label small fw-bold">Date <span class="text-danger">*</span></label>
                    <input asp-for="Entry.EntryDate" type="date" class="form-control" required disabled="@Model.IsPosted" />
                    <span asp-validation-for="Entry.EntryDate" class="text-danger small"></span>
                </div>
                <div class="col-md-9 mb-3">
                    <label asp-for="Entry.EntryAttribute1" class="form-label small fw-bold">Customer <span class="text-danger">*</span></label>
                    <select asp-for="Entry.EntryAttribute1" class="form-select" asp-items="Model.CustomerList" id="ddlCustomer" required disabled="@Model.IsPosted">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="Entry.EntryAttribute1" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryRefId" class="form-label small fw-bold">Against Sale Invoice <span class="text-danger small">(3-Tier Filtering)</span></label>
                    <select asp-for="Entry.EntryRefId" class="form-select" asp-items="Model.SaleInvoiceList" id="ddlRef" disabled="@Model.IsPosted">
                        <option value="">-- Select Sale Invoice --</option>
                    </select>
                    <small class="text-muted d-block mt-1" id="refDetails"></small>
                    <input type="hidden" asp-for="Entry.EntryRefNo" id="hfRefNo" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryTermsDays" class="form-label small fw-bold">Terms (Days)</label>
                    <input asp-for="Entry.EntryTermsDays" type="number" class="form-control" placeholder="0" disabled="@Model.IsPosted" />
                </div>
            </div>

            <!-- Line Items -->
            <div class="mt-4 mb-4">
                <h6 class="text-muted border-bottom pb-2 mb-3 small fw-bold font-monospace text-uppercase">Return Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm" id="lineItemsTable">
                        <thead class="table-light text-center small">
                            <tr>
                                <th style="width: 25%;">Item <span class="text-danger">*</span></th>
                                <th style="width: 10%;">Qty <span class="text-danger">*</span></th>
                                <th style="width: 10%;">LBS</th>
                                <th style="width: 10%;">Rate <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Amount</th>
                                <th style="width: 8%;">GST %</th>
                                <th style="width: 10%;">GST Amt</th>
                                <th style="width: 12%;">Net Amt</th>
                                <th style="width: 3%;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineItemsBody">
                            @for (int i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr class="line-item-row">
                                    <input type="hidden" name="LineItems[@i].EntryId" value="@Model.LineItems[i].EntryId" />
                                    <td>
                                        <select name="LineItems[@i].ItemId" class="form-select form-select-sm item-select" required disabled="@Model.IsPosted">
                                            <option value="">-- Select Item --</option>
                                            @if (Model.ItemList != null)
                                            {
                                                foreach (var item in Model.ItemList)
                                                {
                                                    if (Model.LineItems[i].ItemId?.ToString() == item.Value)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <small class="text-info item-balance-info" style="display:none;"></small>
                                    </td>
                                    <td><input type="number" step="0.01" min="0" name="LineItems[@i].Qty" value="@Model.LineItems[i].Qty" class="form-control form-control-sm qty-input text-end" required disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" min="0" name="LineItems[@i].Lbs" value="@Model.LineItems[i].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.0001" min="0" name="LineItems[@i].Rate" value="@(Model.LineItems[i].Rate?.ToString("F4"))" class="form-control form-control-sm rate-input text-end" required disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Amount" value="@Model.LineItems[i].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstPer" value="@Model.LineItems[i].GstPer" class="form-control form-control-sm gstper-input text-end" disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstAmt" value="@Model.LineItems[i].GstAmt" class="form-control form-control-sm gstamt-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].NetAmount" value="@Model.LineItems[i].NetAmount" class="form-control form-control-sm total-input text-end fw-bold bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td class="text-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="4" class="text-end fw-bold py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-primary btn-sm px-3" id="addRowBtn">
                                                Add +
                                            </button>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span class="small text-muted text-uppercase">Grand Totals:</span>
                                    </div>
                                </td>
                                <td><input type="text" id="footerTotalAmount" class="form-control form-control-sm fw-bold text-end bg-transparent border-0" readonly value="0.00" /></td>
                                <td></td>
                                <td><input type="text" id="footerTotalGst" class="form-control form-control-sm fw-bold text-end bg-transparent border-0" readonly value="0.00" /></td>
                                <td><input type="text" id="grandTotal" class="form-control form-control-sm fw-bold text-end text-primary bg-transparent border-0" readonly value="0.00" /></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Remarks & Totals Section -->
            <div class="row">
                <div class="col-md-7 mb-3">
                    <label asp-for="Entry.EntryRemarks" class="form-label small fw-bold">Remarks</label>
                    <textarea asp-for="Entry.EntryRemarks" class="form-control" rows="8" placeholder="Enter return reason or remarks" disabled="@Model.IsPosted"></textarea>
                </div>
                <div class="col-md-5 mb-3">
                    <div class="card bg-light border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-muted mb-4 small text-uppercase">Commission & Summary</h6>
                            
                            <!-- Commission Details -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-5"><label class="small text-muted mb-0">Comm Agent</label></div>
                                <div class="col-7">
                                    <input asp-for="Entry.EntryAttribute4" class="form-control form-control-sm" id="txtCommAgent" placeholder="Agent Name" disabled="@Model.IsPosted" />
                                </div>
                            </div>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-5"><label class="small text-muted mb-0">Comm (%) / Amt</label></div>
                                <div class="col-3">
                                    <input asp-for="Entry.EntryCommPer" class="form-control form-control-sm text-end" id="txtCommPer" placeholder="%" disabled="@Model.IsPosted" />
                                </div>
                                <div class="col-4">
                                    <input asp-for="Entry.EntryCommAmt" class="form-control form-control-sm text-end bg-white" id="txtCommAmt" readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Sukri</label></div>
                                <div class="col-6 text-end fw-bold">
                                    <input asp-for="Entry.EntryCommSukri" class="form-control form-control-sm text-end" id="txtSukri" type="number" step="0.01" min="0" value="@(Model.Entry?.EntryCommSukri?.ToString("0.00") ?? "0.00")" disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <hr class="my-3" />

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Total Quantity</label></div>
                                <div class="col-6 text-end fw-bold">
                                    <input asp-for="Entry.Qty" class="form-control form-control-sm text-end border-0 bg-transparent fw-bold" id="txtTotalQty" readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Total GST Amount</label></div>
                                <div class="col-6 text-end fw-bold text-danger">
                                    <input asp-for="Entry.TaxAmount" class="form-control form-control-sm text-end border-0 bg-transparent fw-bold text-danger" id="txtTotalTax" readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <hr class="my-3" />

                            <div class="row mb-2 align-items-center">
                                <div class="col-5">
                                    <h5 class="mb-0 fw-bold">Net Total</h5>
                                </div>
                                <div class="col-7">
                                    <input asp-for="Entry.Amount" class="form-control form-control-lg text-end fw-bold text-success border-0 bg-transparent" id="txtNetTotal" readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Sales/SaleReturnIndex" class="btn btn-secondary px-4">Cancel</a>
                    @if (!Model.IsPosted)
                    {
                        <button type="submit" class="btn btn-outline-success px-5 shadow-sm" id="btnSave">Save</button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Template for new row -->
<template id="lineItemRowTemplate">
    <tr class="line-item-row">
        <input type="hidden" name="LineItems[__INDEX__].EntryId" value="0" />
        <td>
            <select name="LineItems[__INDEX__].ItemId" class="form-select form-select-sm item-select" required>
                <option value="">-- Select Item --</option>
                @if (Model.ItemList != null)
                {
                    foreach (var item in Model.ItemList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
            <small class="text-info item-balance-info" style="display:none;"></small>
        </td>
        <td><input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Qty" class="form-control form-control-sm qty-input text-end" required /></td>
        <td><input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.0001" min="0" name="LineItems[__INDEX__].Rate" class="form-control form-control-sm rate-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstPer" class="form-control form-control-sm gstper-input text-end" /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstAmt" class="form-control form-control-sm gstamt-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].NetAmount" class="form-control form-control-sm total-input text-end fw-bold bg-light" readonly /></td>
        <td class="text-center">
            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn" title="Delete">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const invoiceData = {};
        @if (Model.SaleInvoicesForJs != null)
        {
            foreach (var inv in Model.SaleInvoicesForJs)
            {
                var itemsJson = System.Text.Json.JsonSerializer.Serialize(inv.Items?.Select(i => new { itemId = i.ItemId, itemName = i.ItemName, originalQty = i.OriginalQty, remainingQty = i.RemainingQty, rate = i.Rate }));
                @:invoiceData['@inv.EntryId'] = { entryNumber: '@inv.EntryNumber', customerId: '@inv.CustomerId', displayText: '@Html.Raw(inv.DisplayText)', items: @Html.Raw(itemsJson) };
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const body = document.getElementById('lineItemsBody');
            const addRowBtn = document.getElementById('addRowBtn');
            const template = document.getElementById('lineItemRowTemplate');
            const ddlRef = document.getElementById('ddlRef');
            const ddlCust = document.getElementById('ddlCustomer');
            const refDetails = document.getElementById('refDetails');
            const hfRefNo = document.getElementById('hfRefNo');

            // Footer Total Elements
            const footerTotalAmount = document.getElementById('footerTotalAmount');
            const footerTotalGst = document.getElementById('footerTotalGst');
            const grandTotalInput = document.getElementById('grandTotal');
            
            // Sidebar Total Elements
            const txtTotalQty = document.getElementById('txtTotalQty');
            const txtTotalTax = document.getElementById('txtTotalTax');
            const netTotalInput = document.getElementById('txtNetTotal');

            // --- Calculation Logic ---

            function calcRow(row) {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;

                // Auto-calculate LBs = Qty * 100
                const lbsInput = row.querySelector('.lbs-input');
                lbsInput.value = (qty * 100).toFixed(2);

                const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
                
                const amount = qty * rate;
                row.querySelector('.amount-input').value = amount.toFixed(2);
                
                const gstPer = parseFloat(row.querySelector('.gstper-input').value) || 0;
                const gstAmt = (amount * gstPer) / 100;
                row.querySelector('.gstamt-input').value = gstAmt.toFixed(2);
                
                const total = amount + gstAmt;
                row.querySelector('.total-input').value = total.toFixed(2);
            }

            function calcTotals() {
                let totalNet = 0;
                let totalQty = 0;
                let totalTax = 0;
                let totalBase = 0;

                body.querySelectorAll('.line-item-row').forEach(row => {
                     totalNet += parseFloat(row.querySelector('.total-input').value) || 0;
                     totalQty += parseFloat(row.querySelector('.qty-input').value) || 0;
                     totalTax += parseFloat(row.querySelector('.gstamt-input').value) || 0;
                     totalBase += parseFloat(row.querySelector('.amount-input').value) || 0;
                });
                
                // Comm Calc
                const commPerField = document.getElementById('txtCommPer');
                if(commPerField) {
                    const commPer = parseFloat(commPerField.value) || 0;
                    const commAmt = (totalBase * commPer) / 100;
                    const commAmtField = document.getElementById('txtCommAmt');
                    if(commAmtField) commAmtField.value = commAmt.toFixed(2);
                }
                
                if(footerTotalAmount) footerTotalAmount.value = totalBase.toFixed(2);
                if(footerTotalGst) footerTotalGst.value = totalTax.toFixed(2);
                if(grandTotalInput) grandTotalInput.value = totalNet.toFixed(2);
                
                if(txtTotalQty) txtTotalQty.value = totalQty.toFixed(2);
                if(txtTotalTax) txtTotalTax.value = totalTax.toFixed(2);
                if(netTotalInput) netTotalInput.value = totalNet.toFixed(2);
            }

            // --- Row Management ---
             function reindex() {
                  Array.from(body.children).forEach((row, idx) => {
                    row.querySelectorAll('input, select').forEach(i => {
                        const name = i.getAttribute('name');
                        if(name) i.setAttribute('name', name.replace(/LineItems\[\d+\]/, `LineItems[${idx}]`));
                    });
                });
            }

            if(addRowBtn) {
                addRowBtn.addEventListener('click', function() {
                    const idx = body.children.length;
                    const clone = template.content.cloneNode(true);
                    clone.querySelectorAll('input, select').forEach(i => {
                         const name = i.getAttribute('name');
                         if(name) i.setAttribute('name', name.replace('__INDEX__', idx));
                    });
                    
                    body.appendChild(clone);
                    filterItemDropdowns();
                    updateItemSelection();
                });
            }

            body.addEventListener('input', function(e) {
                if(e.target.matches('.qty-input, .rate-input, .gstper-input')) {
                     calcRow(e.target.closest('tr'));
                     calcTotals();
                     if (e.target.matches('.qty-input')) validateRowQty(e.target.closest('tr'));
                }
            });

            const commPerInput = document.getElementById('txtCommPer');
            if(commPerInput) commPerInput.addEventListener('input', calcTotals);

            body.addEventListener('change', function(e) {
                if(e.target.matches('.item-select')) {
                    updateItemSelection();
                    const row = e.target.closest('tr');
                    const itemId = e.target.value;
                    const invId = ddlRef.value;
                    const infoSpan = row.querySelector('.item-balance-info');

                    // Auto-fill GST if empty
                    const gstInput = row.querySelector('.gstper-input');
                    if (gstInput && (gstInput.value === '' || gstInput.value === null)) {
                        gstInput.value = '0.00';
                    }
                    
                    if(invId && invoiceData[invId] && itemId) {
                        const itemData = invoiceData[invId].items.find(i => i.itemId == itemId);
                        if(itemData) {
                             infoSpan.textContent = `Available to Return: ${itemData.remainingQty}`;
                             infoSpan.style.display = 'block';
                             row.querySelector('.qty-input').max = itemData.remainingQty;
                             if(itemData.rate) row.querySelector('.rate-input').value = parseFloat(itemData.rate).toFixed(4);
                             validateRowQty(row);
                             calcRow(row);
                             calcTotals();
                        } else {
                            infoSpan.style.display = 'none';
                        }
                    } else {
                        infoSpan.style.display = 'none';
                    }
                }
            });
            
            body.addEventListener('click', function(e) {
                if(e.target.closest('.remove-row-btn')) {
                     if(body.children.length > 1) {
                         e.target.closest('tr').remove();
                         reindex();
                         calcTotals();
                         updateItemSelection();
                     } else {
                         alert("At least one item is required.");
                     }
                }
            });

            // --- 3-Tier Filtering Logic ---

            function filterPurchaseOptions() {
                const customerId = ddlCust.value;
                const currentVal = ddlRef.value;
                
                Array.from(ddlRef.options).forEach(opt => {
                    if (opt.value === "") return;
                    const inv = invoiceData[opt.value];
                    if (customerId === "" || (inv && inv.customerId == customerId)) {
                        opt.style.display = "";
                        opt.disabled = false;
                    } else {
                        opt.style.display = "none";
                        opt.disabled = true;
                    }
                });

                if (currentVal && ddlRef.options[ddlRef.selectedIndex].style.display === "none") {
                    ddlRef.value = "";
                    ddlRef.dispatchEvent(new Event('change'));
                }
            }

            function filterItemDropdowns() {
                const invId = ddlRef.value;
                const selects = document.querySelectorAll('.item-select');
                
                selects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;
                        let isAvailable = true;
                        if (invId && invoiceData[invId] && invoiceData[invId].items) {
                            isAvailable = invoiceData[invId].items.some(i => i.itemId == option.value);
                        }
                        option.style.display = isAvailable ? '' : 'none';
                        option.disabled = !isAvailable;
                    });
                    if (currentValue && select.options[select.selectedIndex]?.style.display === 'none') {
                        select.value = "";
                        const row = select.closest('tr');
                        if(row) row.querySelector('.item-balance-info').style.display = 'none';
                    }
                });
            }

            function updateItemSelection() {
                const selects = document.querySelectorAll('.item-select');
                const selectedItems = Array.from(selects).map(s => s.value).filter(v => v !== "");
                selects.forEach(select => {
                    const current = select.value;
                    Array.from(select.options).forEach(opt => {
                        if (opt.value === "" || opt.style.display === 'none') return;
                        opt.disabled = selectedItems.includes(opt.value) && opt.value !== current;
                    });
                });
            }

             function validateRowQty(row) {
                 const qtyInput = row.querySelector('.qty-input');
                 const itemSelect = row.querySelector('.item-select');
                 const invId = ddlRef.value;
                 if(invId && invoiceData[invId] && itemSelect.value) {
                     const itemData = invoiceData[invId].items.find(i => i.itemId == itemSelect.value);
                     if(itemData) {
                         const max = itemData.remainingQty;
                         const qty = parseFloat(qtyInput.value) || 0;
                         if(qty > max) qtyInput.classList.add('is-invalid');
                         else qtyInput.classList.remove('is-invalid');
                     }
                 }
             }

             if(ddlCust) {
                 ddlCust.addEventListener('change', function() {
                     filterPurchaseOptions();
                 });
             }

             if(ddlRef) {
                 ddlRef.addEventListener('change', function() {
                     const val = this.value;
                     if(val && invoiceData[val]) {
                         ddlCust.value = invoiceData[val].customerId;
                         refDetails.textContent = `Invoice: SAL-${invoiceData[val].entryNumber} | Selected Items Only`;
                         hfRefNo.value = invoiceData[val].entryNumber;
                     } else {
                         refDetails.textContent = '';
                         hfRefNo.value = '';
                     }
                     
                     // Reset lines if manual change (not on initial load)
                     if(window.isInitialLoadCompleted) {
                        body.innerHTML = '';
                        const clone = template.content.cloneNode(true);
                        clone.querySelectorAll('input, select').forEach(i => {
                             const name = i.getAttribute('name');
                             if(name) i.setAttribute('name', name.replace('__INDEX__', 0));
                        });
                        body.appendChild(clone);
                     }
                     
                     filterItemDropdowns();
                     updateItemSelection();
                     calcTotals();
                 });
             }

             // Form Submit Validation
             const returnForm = document.getElementById('returnForm');
             if(returnForm) {
                 returnForm.addEventListener('submit', function(e) {
                     if(document.querySelectorAll('.is-invalid').length > 0) {
                         e.preventDefault();
                         alert("Please fix errors. Quantity cannot exceed available invoiced quantity.");
                     }
                 });
             }

             // Initialization
             filterPurchaseOptions();
             filterItemDropdowns();
             body.querySelectorAll('.line-item-row').forEach(row => calcRow(row));
             calcTotals();
             updateItemSelection();
             window.isInitialLoadCompleted = true;
        });
    </script>
}
