@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Data Map
        const ssdData = {};
        const purData = {};
        const psdSalesData = {};
        @if (Model.SsdEntriesForJs != null)
        {
            foreach (var p in Model.SsdEntriesForJs)
            {
                var itemsJson = p.Items != null && p.Items.Any()
                ? System.Text.Json.JsonSerializer.Serialize(p.Items.Select(i => new { itemId = i.ItemId, remainingQty = i.RemainingQty, originalQty = i.OriginalQty, rate = i.Rate, lbs = i.Lbs, gstPer = i.GstPer }))
                : "[]";

                @:ssdData['@p.EntryId'] = {
                @:date: '@(p.EntryDate.HasValue ? p.EntryDate.Value.ToString("yyyy-MM-dd") : "")',
                @:remainingQty: @p.RemainingQty,
                @:customerId: '@p.CustomerId',
                @:paymentMode: '@p.PaymentMode',
                @:termsDays: '@p.TermsDays',
                @:applyCommission: '@p.ApplyCommission',
                @:commAgent: '@p.CommAgent',
                @:commPer: @(p.CommPer ?? 10),
                @:commAmt: @(p.CommAmt ?? 0),
                @:sukri: @(p.Sukri ?? 0),
                @:psdId: '@p.PsdId',
                @:items: @Html.Raw(itemsJson)
                @:};
            }
        }
        @if (Model.PurEntriesForJs != null)
        {
            foreach (var p in Model.PurEntriesForJs)
            {
                var itemsJson = p.Items != null && p.Items.Any()
                ? System.Text.Json.JsonSerializer.Serialize(p.Items.Select(i => new { itemId = i.ItemId, itemName = i.ItemName, qty = i.Qty, remainingQty = i.RemainingQty, rate = i.Rate, lbs = i.Lbs }))
                : "[]";

                @:purData['@p.EntryNumber'] = {
                @:date: '@p.Date',
                @:totalQty: @p.TotalQty,
                @:totalRemainingQty: @p.TotalRemainingQty,
                @:psdId: '@p.PsdId',
                @:items: @Html.Raw(itemsJson)
                @:};
            }
        }

            document.addEventListener('DOMContentLoaded', function () {
                const body = document.getElementById('lineItemsBody');
                const addRowBtn = document.getElementById('addRowBtn');
                const template = document.getElementById('lineItemRowTemplate');
                const ddlRef = document.getElementById('ddlRef');
                const ddlPur = document.getElementById('Entry_EntryRefNo');
                const ddlCust = document.getElementById('ddlCustomer');
                const refDetails = document.getElementById('refDetails');
                const purDetails = document.getElementById('purDetails');

                // Footer Total Elements
                const footerTotalAmount = document.getElementById('footerTotalAmount');
                const footerTotalGst = document.getElementById('footerTotalGst');
                const grandTotalInput = document.getElementById('grandTotal');

                // Sidebar Total Elements
                const txtTotalQty = document.getElementById('txtTotalQty');
                const txtTotalTax = document.getElementById('txtTotalTax');
                const netTotalInput = document.getElementById('txtNetTotal');

                // --- Calculation Logic ---

                function calcRow(row) {
                    const lbs = parseFloat(row.querySelector('.lbs-input').value) || 0;
                    const rate = parseFloat(row.querySelector('.rate-input').value) || 0;

                    // Using Lbs * Rate per request
                    const amount = lbs * rate;
                    row.querySelector('.amount-input').value = amount.toFixed(2);

                    // GST
                    const gstPer = parseFloat(row.querySelector('.gstper-input').value) || 0;
                    const gstAmt = (amount * gstPer) / 100;
                    row.querySelector('.gstamt-input').value = gstAmt.toFixed(2);

                    const total = amount + gstAmt;
                    row.querySelector('.total-input').value = total.toFixed(2);
                }

                function calcTotals() {
                    let totalNet = 0; // Total Amount inc Tax of all Lines
                    let totalQty = 0;
                    let totalTax = 0;
                    let totalBase = 0; // Sum of Amounts (pre-tax)

                    body.querySelectorAll('.line-item-row').forEach(row => {
                        totalNet += parseFloat(row.querySelector('.total-input').value) || 0;
                        totalQty += parseFloat(row.querySelector('.qty-input').value) || 0;
                        totalTax += parseFloat(row.querySelector('.gstamt-input').value) || 0;
                        totalBase += parseFloat(row.querySelector('.amount-input').value) || 0;
                    });

                    // Update Footer
                    if (footerTotalAmount) footerTotalAmount.value = totalBase.toFixed(2);
                    if (footerTotalGst) footerTotalGst.value = totalTax.toFixed(2);
                    if (grandTotalInput) grandTotalInput.value = totalNet.toFixed(2);

                    // Update Sidebar
                    if (txtTotalQty) txtTotalQty.value = totalQty.toFixed(2);
                    if (txtTotalTax) txtTotalTax.value = totalTax.toFixed(2);
                    if (netTotalInput) netTotalInput.value = totalNet.toFixed(2);

                    // Commission Calc
                    const commPerField = document.getElementById('txtCommPer');
                    if (commPerField) {
                        const commPer = parseFloat(commPerField.value) || 0;
                        const commAmt = (totalBase * commPer) / 100;
                        const commAmtField = document.getElementById('txtCommAmt');
                        if (commAmtField) commAmtField.value = commAmt.toFixed(2);
                    }
                }

                // --- Row Management ---
                function reindex() {
                    Array.from(body.children).forEach((row, idx) => {
                        row.querySelectorAll('input, select').forEach(i => {
                            const name = i.getAttribute('name');
                            if (name) i.setAttribute('name', name.replace(/LineItems\[\d+\]/, `LineItems[${idx}]`));
                        });
                    });
                }

                if (addRowBtn) {
                    addRowBtn.addEventListener('click', function () {
                        const idx = body.children.length;
                        const clone = template.content.cloneNode(true);
                        clone.querySelectorAll('input, select').forEach(i => {
                            const name = i.getAttribute('name');
                            if (name) i.setAttribute('name', name.replace('__INDEX__', idx));
                        });

                        body.appendChild(clone);
                        filterItemDropdowns(); // Filter the new row immediately
                        updateItemSelection();
                    });
                }

                // Event Delegation
                body.addEventListener('input', function (e) {
                    if (e.target.matches('.qty-input, .rate-input, .lbs-input, .gstper-input')) {
                        const row = e.target.closest('tr');

                        // Auto-calculate Lbs = Qty * 100
                        if (e.target.matches('.qty-input')) {
                            const qty = parseFloat(e.target.value) || 0;
                            const lbsInput = row.querySelector('.lbs-input');
                            if (lbsInput) {
                                lbsInput.value = (qty * 100).toFixed(2);
                            }
                        }

                        calcRow(row);
                        calcTotals();

                        if (e.target.matches('.qty-input')) validateRowQty(row);
                    }
                });

                const commPerInput = document.getElementById('txtCommPer');
                if (commPerInput) commPerInput.addEventListener('input', calcTotals);

                body.addEventListener('change', function (e) {
                    if (e.target.matches('.item-select')) {
                        updateItemSelection();

                        const row = e.target.closest('tr');
                        const itemId = e.target.value;
                        const infoSpan = row.querySelector('.item-balance-info');
                        const qtyInput = row.querySelector('.qty-input');

                        const ssdId = ddlRef.value;
                        const purNo = ddlPur.value;

                        let minBalance = Infinity;
                        let hasReference = false;

                        // Check PUR Balance
                        if (purNo && purData[purNo] && itemId) {
                            const itemData = purData[purNo].items.find(i => i.itemId == itemId);
                            if (itemData) {
                                minBalance = Math.min(minBalance, itemData.remainingQty);
                                hasReference = true;
                            }
                        }

                        // Check SSD Balance
                        if (ssdId && ssdData[ssdId] && itemId) {
                            const itemData = ssdData[ssdId].items.find(i => i.itemId == itemId);
                            if (itemData) {
                                minBalance = Math.min(minBalance, itemData.remainingQty);
                                hasReference = true;
                                // Auto-fill Rate if needed (from SSD as per old logic)
                                if (itemData.rate && !qtyInput.value) row.querySelector('.rate-input').value = parseFloat(itemData.rate).toFixed(4);
                            }
                        }

                        if (hasReference && minBalance !== Infinity) {
                            infoSpan.textContent = `Available Balance: ${minBalance}`;
                            infoSpan.style.display = 'block';
                            qtyInput.max = minBalance;
                            validateRowQty(row);

                            // Auto-fill GST
                            const gstInput = row.querySelector('.gstper-input');
                            if (gstInput && (gstInput.value === '' || gstInput.value === null)) gstInput.value = '0.00';

                            calcRow(row);
                            calcTotals();
                        } else {
                            infoSpan.style.display = 'none';
                            qtyInput.removeAttribute('max');
                        }
                    }
                });

                body.addEventListener('click', function (e) {
                    if (e.target.closest('.remove-row-btn')) {
                        if (body.children.length > 1) {
                            e.target.closest('tr').remove();
                            reindex();
                            calcTotals();
                            updateItemSelection();
                        } else {
                            alert("At least one item is required.");
                        }
                    }
                });


                // --- Filtering Logic ---

                function filterItemDropdowns() {
                    const purNo = ddlPur ? ddlPur.value : "";
                    const selects = document.querySelectorAll('.item-select');
                    const templateSelect = template.content.querySelector('.item-select');

                    const allSelects = [...selects];
                    if (templateSelect) allSelects.push(templateSelect);

                    allSelects.forEach(select => {
                        const currentValue = select.value;

                        Array.from(select.options).forEach(option => {
                            if (option.value === "") return;

                            let isAvailable = true;
                            if (purNo && purData[purNo] && purData[purNo].items && purData[purNo].items.length > 0) {
                                // Filter: Exists in PUR items?
                                isAvailable = purData[purNo].items.some(i => i.itemId == option.value);
                            } else if (purNo) {
                                // PUR selected but has no items or invalid data? Hide
                                isAvailable = false;
                            }
                            // If no purNo, isAvailable defaults to true (show all) to allow SSD selection flow

                            if (isAvailable) {
                                option.style.display = '';
                                option.disabled = false;
                            } else {
                                option.style.display = 'none';
                                option.disabled = true;
                            }
                        });

                        // Clear if invalid
                        if (currentValue && select.options[select.selectedIndex]?.style.display === 'none') {
                            select.value = "";
                            // Clear info text
                            const row = select.closest('tr');
                            if (row) {
                                const info = row.querySelector('.item-balance-info');
                                if (info) info.style.display = 'none';
                            }
                        }
                    });
                }

                function updateItemSelection() {
                    const selects = document.querySelectorAll('.item-select');
                    const selectedItems = Array.from(selects)
                        .map(select => select.value)
                        .filter(val => val !== "");

                    selects.forEach(select => {
                        const currentValue = select.value;
                        Array.from(select.options).forEach(option => {
                            if (option.value === "") return;
                            if (option.style.display === 'none') return;

                            if (selectedItems.includes(option.value) && option.value !== currentValue) {
                                option.disabled = true;
                                option.style.backgroundColor = '#f8f9fa';
                                option.style.color = '#adb5bd';
                            } else {
                                option.disabled = false;
                                option.style.backgroundColor = '';
                                option.style.color = '';
                            }
                        });
                    });
                }

                function validateRowQty(row) {
                    const qtyInput = row.querySelector('.qty-input');
                    const itemSelect = row.querySelector('.item-select');
                    const ssdId = ddlRef.value;

                    if (ssdId && ssdData[ssdId] && itemSelect.value) {
                        const itemData = ssdData[ssdId].items.find(i => i.itemId == itemSelect.value);
                        if (itemData) {
                            const max = itemData.remainingQty;
                            const qty = parseFloat(qtyInput.value) || 0;
                            if (qty > max) {
                                qtyInput.classList.add('is-invalid');
                            } else {
                                qtyInput.classList.remove('is-invalid');
                            }
                        }
                    }
                }

                function updateRowBalance(row) {
                    const itemId = row.querySelector('.item-select').value;
                    const infoSpan = row.querySelector('.item-balance-info');
                    const qtyInput = row.querySelector('.qty-input');

                    const ssdId = ddlRef.value;
                    const purNo = ddlPur.value;

                    let minBalance = Infinity;
                    let hasReference = false;

                    if (purNo && purData[purNo] && itemId) {
                        const itemData = purData[purNo].items.find(i => i.itemId == itemId);
                        if (itemData) {
                            minBalance = Math.min(minBalance, itemData.remainingQty);
                            hasReference = true;
                        }
                    }

                    if (ssdId && ssdData[ssdId] && itemId) {
                        const itemData = ssdData[ssdId].items.find(i => i.itemId == itemId);
                        if (itemData) {
                            minBalance = Math.min(minBalance, itemData.remainingQty);
                            hasReference = true;
                        }
                    }

                    if (hasReference && minBalance !== Infinity) {
                        infoSpan.textContent = `Available Balance: ${minBalance}`;
                        infoSpan.style.display = 'block';
                        qtyInput.max = minBalance;

                        // Auto-fill Qty if empty or 0 (and it's a genuine user interaction event)
                        if (!qtyInput.value || parseFloat(qtyInput.value) === 0) {
                            qtyInput.value = minBalance;
                            calcRow(row);
                            calcTotals();
                        }

                        validateRowQty(row);
                    } else {
                        infoSpan.style.display = 'none';
                        qtyInput.removeAttribute('max');
                    }
                }

                // Logic for Reference Change (SSD)
                if (ddlRef) {
                    ddlRef.addEventListener('change', function () {
                        const val = this.value;

                        // Auto-Select Customer
                        if (val && ssdData[val] && ssdData[val].customerId) {
                            ddlCust.value = ssdData[val].customerId;
                        }

                        // Auto-populate Terms Days & Payment Mode
                        if (val && ssdData[val]) {
                            const termsDaysInput = document.getElementById('Entry_EntryTermsDays');
                            if (termsDaysInput && ssdData[val].termsDays) termsDaysInput.value = ssdData[val].termsDays;
                            const txtPaymentMode = document.getElementById('txtPaymentMode');
                            if (txtPaymentMode) txtPaymentMode.value = ssdData[val].paymentMode || '';

                            // Auto-populate Commission
                            const isComm = (ssdData[val].applyCommission || '').toLowerCase() === 'yes';
                            const txtCommAgent = document.getElementById('txtCommAgent');
                            const txtCommPer = document.getElementById('txtCommPer');
                            const txtCommAmt = document.getElementById('txtCommAmt');
                            const sukriInput = document.getElementById('Entry_EntryCommSukri');

                            if (isComm) {
                                if (txtCommAgent) txtCommAgent.value = ssdData[val].commAgent || '';
                                if (txtCommPer) txtCommPer.value = (ssdData[val].commPer !== undefined && ssdData[val].commPer !== null && ssdData[val].commPer > 0) ? ssdData[val].commPer : 10;
                                if (sukriInput) sukriInput.value = (ssdData[val].sukri || 0).toFixed(2);
                            } else {
                                if (txtCommAgent) txtCommAgent.value = '';
                                if (txtCommPer) txtCommPer.value = '';
                                if (txtCommAmt) txtCommAmt.value = '';
                                if (sukriInput) sukriInput.value = '0.00';
                            }
                        } else {
                            const txtPaymentMode = document.getElementById('txtPaymentMode');
                            if (txtPaymentMode) txtPaymentMode.value = '';
                        }

                        // Link Details
                        if (val && ssdData[val]) {
                            refDetails.textContent = `Date: ${ssdData[val].date} | Total Remaining: ${ssdData[val].remainingQty}`;
                        } else {
                            refDetails.textContent = '';
                        }

                        // Cascade: Filter PUR based on SSD's linked PSD
                        filterPurFromSsd(val);

                        filterItemDropdowns();
                        updateItemSelection();

                        // Auto-fill Table from SSD Items
                        if (val && ssdData[val]) {
                            const items = ssdData[val].items;
                            if (items.length > 0) {
                                body.innerHTML = ''; // Clear table
                                items.forEach((item, idx) => {
                                    const clone = template.content.cloneNode(true);

                                    // Set Values
                                    clone.querySelector('.item-select').value = item.itemId;
                                    clone.querySelector('.qty-input').value = item.remainingQty;
                                    clone.querySelector('.rate-input').value = parseFloat(item.rate).toFixed(4);
                                    clone.querySelector('.lbs-input').value = item.lbs;

                                    // Auto-fill GST
                                    const gstInput = clone.querySelector('.gstper-input');
                                    if (gstInput) gstInput.value = parseFloat(item.gstPer !== undefined && item.gstPer !== null ? item.gstPer : 0).toFixed(2);

                                    // Set Names (indexing)
                                    clone.querySelectorAll('input, select').forEach(i => {
                                        const name = i.getAttribute('name');
                                        if (name) i.setAttribute('name', name.replace('__INDEX__', idx));
                                    });

                                    body.appendChild(clone);
                                });

                                // Recalculate everything
                                body.querySelectorAll('.line-item-row').forEach(row => {
                                    calcRow(row);
                                    updateRowBalance(row);
                                });
                                calcTotals();
                                filterItemDropdowns();
                                updateItemSelection();
                            }
                        } else {
                            body.querySelectorAll('.line-item-row').forEach(row => updateRowBalance(row));
                        }
                    });

                    // Initial Load
                    if (ddlRef.value) {
                        const val = ddlRef.value;
                        if (ssdData[val]) {
                            refDetails.textContent = `Date: ${ssdData[val].date} | Total Remaining: ${ssdData[val].remainingQty}`;
                            const txtPaymentMode = document.getElementById('txtPaymentMode');
                            if (txtPaymentMode && !txtPaymentMode.value) txtPaymentMode.value = ssdData[val].paymentMode || '';
                        }
                        filterItemDropdowns();
                    }
                }

                // =============================================
                // CASCADING FILTER LOGIC: Customer → SSD → PSD → PUR
                // =============================================

                // 1. Filter SSD options based on selected customer
                function filterSsdOptions(customerId) {
                    if (!ddlRef) return;
                    Array.from(ddlRef.options).forEach(opt => {
                        if (opt.value === "") return;
                        if (!customerId) {
                            opt.style.display = '';
                            opt.disabled = false;
                        } else if (ssdData[opt.value] && ssdData[opt.value].customerId == customerId) {
                            opt.style.display = '';
                            opt.disabled = false;
                        } else {
                            opt.style.display = 'none';
                            opt.disabled = true;
                        }
                    });
                    // Clear if current selection is now hidden
                    if (ddlRef.value && ddlRef.selectedOptions[0]?.disabled) {
                        ddlRef.value = "";
                        if (refDetails) refDetails.textContent = '';
                        // Cascade clear PUR
                        filterPurFromSsd("");
                    }
                }

                // 2. Filter PUR options based on selected SSD's PSD link
                function filterPurFromSsd(ssdId) {
                    if (!ddlPur) return;

                    if (!ssdId || !ssdData[ssdId]) {
                        // No SSD selected - show all PURs
                        Array.from(ddlPur.options).forEach(opt => {
                            if (opt.value === "") return;
                            opt.style.display = '';
                            opt.disabled = false;
                        });
                    } else {
                        const targetPsdId = ssdData[ssdId].psdId;
                        const ssdItemIds = ssdData[ssdId].items.map(i => i.itemId);

                        Array.from(ddlPur.options).forEach(opt => {
                            if (opt.value === "") return;
                            const purNo = opt.value;
                            const pData = purData[purNo];

                            let isMatch = false;
                            if (pData) {
                                // Preferred Match: Link via PSD ID
                                if (targetPsdId && pData.psdId == targetPsdId) {
                                    isMatch = true;
                                } else {
                                    // Fallback: Link via shared items
                                    isMatch = pData.items.some(i => ssdItemIds.includes(i.itemId));
                                }
                            }

                            if (isMatch) {
                                opt.style.display = '';
                                opt.disabled = false;
                            } else {
                                opt.style.display = 'none';
                                opt.disabled = true;
                            }
                        });
                    }

                    // Clear PUR if current selection is now hidden
                    if (ddlPur.value && ddlPur.selectedOptions[0]?.disabled) {
                        ddlPur.value = "";
                        if (purDetails) purDetails.textContent = '';
                    }
                }

                // Customer Change Handler
                if (ddlCust) {
                    ddlCust.addEventListener('change', function () {
                        const customerId = this.value;
                        filterSsdOptions(customerId);
                        // Cascade: also filter PUR (will be empty if SSD cleared)
                        filterPurFromSsd(ddlRef ? ddlRef.value : "");
                    });
                }

                // Logic for Purchase Reference Change (PUR) - AUTO-FILL TABLE
                if (ddlPur) {
                    ddlPur.addEventListener('change', function (e) {
                        const val = this.value;

                        // Show Details
                        if (val && purData[val]) {
                            purDetails.textContent = `Date: ${purData[val].date} | Total Remaining: ${purData[val].totalRemainingQty}`;
                        } else {
                            purDetails.textContent = '';
                        }

                        if (!e.isTrusted) return; // Don't auto-fill on load

                        // If SSD is selected, do NOT auto-fill from PUR (SSD takes precedence)
                        if (ddlRef && ddlRef.value) {
                            // Allow balance updates but don't clear/refill table
                            body.querySelectorAll('.line-item-row').forEach(row => updateRowBalance(row));
                            return;
                        }

                        if (val && purData[val]) {
                            const items = purData[val].items;
                            if (items.length > 0) {
                                body.innerHTML = ''; // Clear table
                                items.forEach((item, idx) => {
                                    const clone = template.content.cloneNode(true);

                                    // Set Values
                                    clone.querySelector('.item-select').value = item.itemId;
                                    clone.querySelector('.qty-input').value = item.remainingQty;
                                    clone.querySelector('.rate-input').value = parseFloat(item.rate).toFixed(4);
                                    clone.querySelector('.lbs-input').value = item.lbs;

                                    // Auto-fill GST
                                    const gstInput = clone.querySelector('.gstper-input');
                                    if (gstInput) gstInput.value = '0.00';

                                    // Set Names (indexing)
                                    clone.querySelectorAll('input, select').forEach(i => {
                                        const name = i.getAttribute('name');
                                        if (name) i.setAttribute('name', name.replace('__INDEX__', idx));
                                    });

                                    body.appendChild(clone);
                                });

                                // Recalculate everything
                                body.querySelectorAll('.line-item-row').forEach(row => {
                                    calcRow(row);
                                    updateRowBalance(row);
                                });
                                calcTotals();
                                filterItemDropdowns();
                                updateItemSelection();
                            }
                        } else {
                            // If PUR cleared/changed, update balances for existing rows
                            body.querySelectorAll('.line-item-row').forEach(row => updateRowBalance(row));
                        }
                    });

                    // Initial Load for PUR Details
                    if (ddlPur.value) {
                        const val = ddlPur.value;
                        if (purData[val]) {
                            purDetails.textContent = `Date: ${purData[val].date} | Total Remaining: ${purData[val].totalRemainingQty}`;
                        }
                    }
                }

                // =============================================
                // INITIAL LOAD: Apply cascading filters for edit mode
                // =============================================
                (function initCascadingFilters() {
                    // 1. Filter SSD by Customer
                    if (ddlCust && ddlCust.value) {
                        filterSsdOptions(ddlCust.value);
                    }
                    // 2. Filter PUR by SSD
                    if (ddlRef && ddlRef.value) {
                        filterPurFromSsd(ddlRef.value);
                    }
                })();

                // Validation before submit
                const mainForm = document.getElementById('salesForm');
                if (mainForm) {
                    mainForm.addEventListener('submit', function (e) {
                        // Check invalid classes
                        if (document.querySelectorAll('.is-invalid').length > 0) {
                            e.preventDefault();
                            alert("Please fix validation errors (Quantity exceeds available balance).");
                        }

                        // Also helpful: check total qty
                        // Check if at least one item?
                        if (body.querySelectorAll('.line-item-row').length === 0) {
                            e.preventDefault();
                            alert("Please add at least one item.");
                        }

                        // Add loading state
                        if (!e.defaultPrevented) {
                            const btnSave = document.getElementById('btnSave');
                            if (btnSave) {
                                btnSave.disabled = true;
                                btnSave.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
                            }
                        }
                    });
                }

                // Initial calcs
                body.querySelectorAll('.line-item-row').forEach(row => {
                    calcRow(row);
                    updateRowBalance(row);
                });
                calcTotals();
                updateItemSelection();
            });
    </script>
}