@* @page
@model YIS.Pages.Sales.EntryModel
@{
    ViewData["Title"] = "Sales Invoice";
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end">
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" id="salesForm">
            <h5 class="card-title mb-4">
                Sales 
                <span class="text-dark fs-6 float-end">@Model.DisplayEntryNumber</span>
                @if (Model.IsLedgerPosted)
                {
                    <span class="text-dark me-2 float-end fs-6">
                        <i class="bi bi-bank me-1"></i> Ledger Posted
                    </span>
                }
                @if (Model.Entry.EntryPostedToFbr == true)
                {
                    <span class="text-dark me-2 float-end fs-6">
                        <i class="bi bi-cloud-check-fill me-1"></i> FBR Posted
                    </span>
                }
            </h5>

            @if (Model.IsLedgerPosted)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-lock-fill flex-shrink-0 me-2 fs-4"></i>
                    <div>
                        <strong>Locked:</strong> This sales invoice has been posted to the ledger and cannot be edited.
                    </div>
                </div>
            }
            
            <input type="hidden" asp-for="Entry.EntryId" />

            <!-- Row 1: Basic Info -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryDate" class="form-label">Date <span class="text-danger">*</span></label>
                    <input asp-for="Entry.EntryDate" type="date" class="form-control" required disabled="@Model.IsLedgerPosted" />
                    <span asp-validation-for="Entry.EntryDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryAttribute1" class="form-label">Customer <span class="text-danger">*</span></label>
                    <select asp-for="Entry.EntryAttribute1" class="form-select" asp-items="Model.CustomerList" id="ddlCustomer" required disabled="@Model.IsLedgerPosted">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="Entry.EntryAttribute1" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2: References -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryRefId" class="form-label">Against Sale Soda (SSD) <span class="text-danger">*</span></label>
                    <select asp-for="Entry.EntryRefId" class="form-select" asp-items="Model.SalesSodaList" id="ddlRef" required disabled="@Model.IsLedgerPosted">
                        <option value="">-- Select --</option>
                    </select>
                    <small class="text-muted d-block mt-1" id="refDetails"></small>
                    <span asp-validation-for="Entry.EntryRefId" class="text-danger"></span>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Entry.EntryRefNo" class="form-label">Against PUR <span class="text-danger">*</span></label>
                    <select asp-for="Entry.EntryRefNo" class="form-select" asp-items="Model.PurchaseEntryList" required disabled="@Model.IsLedgerPosted">
                        <option value="">-- Select --</option>
                    </select>
                    <small class="text-muted d-block mt-1" id="purDetails"></small>
                    <span asp-validation-for="Entry.EntryRefNo" class="text-danger"></span>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Entry.EntryRefCode" class="form-label">Customer Pur No</label>
                    <input asp-for="Entry.EntryRefCode" class="form-control" placeholder="Customer Pur No" disabled="@Model.IsLedgerPosted" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Entry.EntryTermsDays" class="form-label">Terms (Days)</label>
                    <input asp-for="Entry.EntryTermsDays" type="number" class="form-control" min="0" disabled="@Model.IsLedgerPosted" />
                </div>
                <div class="col-md-3 mb-3">
                    <!-- FBR Status (Read-only as per recent user change) -->
                    <label class="form-label">FBR Status</label>
                    <div class="form-control bg-light d-flex align-items-center justify-content-between">
                        <span class="small text-muted">Posted:</span>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkPosted" @(Model.Entry.EntryPostedToFbr.GetValueOrDefault() ? "checked" : "") disabled>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="mb-4">
                <h6 class="mt-3 mb-3 text-muted border-bottom pb-2">Invoice Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm" id="lineItemsTable">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 25%;">Item <span class="text-danger">*</span></th>
                                <th style="width: 10%;">Qty <span class="text-danger">*</span></th>
                                <th style="width: 10%;">LBS</th>
                                <th style="width: 10%;">Rate <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Amount</th>
                                <th style="width: 8%;">GST %</th>
                                <th style="width: 10%;">GST Amt</th>
                                <th style="width: 12%;">Net Amt</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineItemsBody">
                            @for (int i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr class="line-item-row">
                                    <input type="hidden" name="LineItems[@i].EntryId" value="@Model.LineItems[i].EntryId" />
                                    <td>
                                        <select name="LineItems[@i].ItemId" class="form-select form-select-sm item-select" required disabled="@Model.IsLedgerPosted">
                                            <option value="">-- Select Item --</option>
                                            @if (Model.ItemList != null)
                                            {
                                                foreach (var item in Model.ItemList)
                                                {
                                                    if (Model.LineItems[i].ItemId?.ToString() == item.Value)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                         <small class="text-danger fw-bold item-balance-info" style="display:none;"></small>
                                    </td>
                                    <td><input type="number" step="0.01" min="0" name="LineItems[@i].Qty" value="@Model.LineItems[i].Qty" class="form-control form-control-sm qty-input text-end" required disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.01" min="0" name="LineItems[@i].Lbs" value="@Model.LineItems[i].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.0001" min="0" name="LineItems[@i].Rate" value="@(Model.LineItems[i].Rate?.ToString("F4"))" class="form-control form-control-sm rate-input text-end" required disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Amount" value="@Model.LineItems[i].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstPer" value="@Model.LineItems[i].GstPer" class="form-control form-control-sm gstper-input text-end" disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstAmt" value="@Model.LineItems[i].GstAmt" class="form-control form-control-sm gstamt-input text-end bg-light" readonly disabled="@Model.IsLedgerPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].TotalAmount" value="@Model.LineItems[i].TotalAmount" class="form-control form-control-sm total-input text-end fw-bold bg-light" readonly disabled="@Model.IsLedgerPosted" /></td>
                                    <td class="text-center">
                                        @if (!Model.IsLedgerPosted)
                                        {
                                            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-muted small text-uppercase">
                                    <div class="d-flex justify-content-between align-items-center">
                                        @if (!Model.IsLedgerPosted)
                                        {
                                            <button type="button" class="btn btn-primary px-3 shadow-sm border-0" id="addRowBtn" title="Add Item">
                                                + Add 
                                            </button>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span>Grand Totals:</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" id="footerTotalAmount" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly value="0.00" />
                                </td>
                                <td></td>
                                <td>
                                    <input type="text" id="footerTotalGst" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly value="0.00" />
                                </td>
                                <td>
                                    <input type="text" id="grandTotal" class="form-control form-control-sm fw-bold text-end text-success bg-white border-0" readonly value="0.00" />
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Remarks & Commission -->
            <div class="row">
                <div class="col-md-7 mb-3">
                    <label asp-for="Entry.EntryRemarks" class="form-label">Remarks</label>
                    <textarea asp-for="Entry.EntryRemarks" class="form-control" rows="8" placeholder="Enter remarks" disabled="@Model.IsLedgerPosted"></textarea>
                    
                    <div class="mt-3 p-3 bg-light rounded border">
                        <h6 class="text-muted mb-3 small fw-bold">FBR Reference</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label asp-for="Entry.EntryFbrDiNo" class="form-label small mb-1">FBR DI No</label>
                                <input asp-for="Entry.EntryFbrDiNo" class="form-control form-control-sm" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">FBR Error (if any)</label>
                                <input value="@Model.Entry.EntryFbrError" class="form-control form-control-sm" disabled />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-5 mb-3">
                    <div class="card bg-light border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-muted mb-3">Commission & Totals</h6>
                            
                            <!-- Commission Details -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-5"><label class="small text-muted mb-0">Comm Agent</label></div>
                                <div class="col-7">
                                    <input asp-for="Entry.EntryAttribute4" class="form-control form-control-sm" id="txtCommAgent" placeholder="Agent Name" disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-5"><label class="small text-muted mb-0">Comm (%) / Amt</label></div>
                                <div class="col-3">
                                    <input asp-for="Entry.EntryCommPer" class="form-control form-control-sm text-end" id="txtCommPer" placeholder="%" disabled="@Model.IsLedgerPosted" />
                                </div>
                                <div class="col-4">
                                    <input asp-for="Entry.EntryCommAmt" class="form-control form-control-sm text-end bg-white" id="txtCommAmt" readonly disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <div class="col-5"><label class="small text-muted mb-0">Sukri</label></div>
                                <div class="col-7">
                                    <input asp-for="Entry.EntryCommSukri" class="form-control form-control-sm text-end" placeholder="0.00" disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>

                            <hr class="my-3" />

                            <!-- Final Totals -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-5 text-muted small">Total Quantity</div>
                                <div class="col-7">
                                    <input asp-for="Entry.Qty" class="form-control form-control-sm text-end border-0 bg-transparent fw-bold" id="txtTotalQty" readonly disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>
                            <div class="row mb-2 align-items-center">
                                <div class="col-5 text-muted small">Total GST</div>
                                <div class="col-7">
                                    <input asp-for="Entry.TaxAmount" class="form-control form-control-sm text-end border-0 bg-transparent fw-bold" id="txtTotalTax" readonly disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>
                            <div class="row align-items-center mt-3">
                                <div class="col-5"><h5 class="mb-0 fw-bold">Net Amount</h5></div>
                                <div class="col-7">
                                    <input asp-for="Entry.Amount" class="form-control form-control-lg text-end fw-bold text-success border-0 bg-white" id="txtNetTotal" readonly disabled="@Model.IsLedgerPosted" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Sales/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    @if (Model.Entry.EntryId > 0)
                    {
                        <a href="/Sales/InvoiceView/@Model.Entry.EntryId" target="_blank" class="btn btn-outline-info px-4">
                            <i class="bi bi-printer me-1"></i> Print / View
                        </a>
                    }
                    @if (!Model.IsLedgerPosted)
                    {
                        <button type="submit" class="btn btn-outline-success px-5" id="btnSave">Save Invoice</button>
                    }
                </div>
            </div>

        </form>
    </div>
</div>

<!-- Template for new row -->
<template id="lineItemRowTemplate">
    <tr class="line-item-row">
        <input type="hidden" name="LineItems[__INDEX__].EntryId" value="0" />
        <td>
            <select name="LineItems[__INDEX__].ItemId" class="form-select form-select-sm item-select" required>
                <option value="">-- Select Item --</option>
                @if (Model.ItemList != null)
                {
                    foreach (var item in Model.ItemList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
             <small class="text-danger fw-bold item-balance-info" style="display:none;"></small>
        </td>
        <td><input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Qty" class="form-control form-control-sm qty-input text-end" required /></td>
        <td><input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.0001" min="0" name="LineItems[__INDEX__].Rate" class="form-control form-control-sm rate-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstPer" class="form-control form-control-sm gstper-input text-end" value="0"/></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstAmt" class="form-control form-control-sm gstamt-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].TotalAmount" class="form-control form-control-sm total-input text-end fw-bold bg-light" readonly /></td>
        <td class="text-center">
            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn" title="Delete">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Data will be fetched via AJAX as needed.
        // In-memory caches for balance checks and item filtering
        var ssdData = {};
        var purData = {};

        document.addEventListener('DOMContentLoaded', function () {
            const body = document.getElementById('lineItemsBody');
            const addRowBtn = document.getElementById('addRowBtn');
            const template = document.getElementById('lineItemRowTemplate');
            const ddlRef = document.getElementById('ddlRef');
            const ddlPur = document.getElementById('Entry_EntryRefNo');
            const ddlCust = document.getElementById('ddlCustomer');
            const refDetails = document.getElementById('refDetails');
            const purDetails = document.getElementById('purDetails');

            // Footer Total Elements
            const footerTotalAmount = document.getElementById('footerTotalAmount');
            const footerTotalGst = document.getElementById('footerTotalGst');
            const grandTotalInput = document.getElementById('grandTotal');
            
            // Sidebar Total Elements
            const txtTotalQty = document.getElementById('txtTotalQty');
            const txtTotalTax = document.getElementById('txtTotalTax');
            const netTotalInput = document.getElementById('txtNetTotal');

            // --- Calculation Logic ---

            function calcRow(row) {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;

                // Auto-calculate LBs = Qty * 100
                const lbsInput = row.querySelector('.lbs-input');
                lbsInput.value = (qty * 100).toFixed(2);

                const lbs = parseFloat(lbsInput.value) || 0;
                const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
                
                // Using Lbs * Rate per request
                const amount = lbs * rate;
                row.querySelector('.amount-input').value = amount.toFixed(2);
                
                // GST
                const gstPer = parseFloat(row.querySelector('.gstper-input').value) || 0;
                const gstAmt = (amount * gstPer) / 100;
                row.querySelector('.gstamt-input').value = gstAmt.toFixed(2);
                
                const total = amount + gstAmt;
                row.querySelector('.total-input').value = total.toFixed(2);
            }

            function calcTotals() {
                let totalNet = 0; // Total Amount inc Tax of all Lines
                let totalQty = 0;
                let totalTax = 0;
                let totalBase = 0; // Sum of Amounts (pre-tax)

                body.querySelectorAll('.line-item-row').forEach(row => {
                     totalNet += parseFloat(row.querySelector('.total-input').value) || 0;
                     totalQty += parseFloat(row.querySelector('.qty-input').value) || 0;
                     totalTax += parseFloat(row.querySelector('.gstamt-input').value) || 0;
                     totalBase += parseFloat(row.querySelector('.amount-input').value) || 0;
                });
                
                // Update Footer
                if(footerTotalAmount) footerTotalAmount.value = totalBase.toFixed(2);
                if(footerTotalGst) footerTotalGst.value = totalTax.toFixed(2);
                if(grandTotalInput) grandTotalInput.value = totalNet.toFixed(2);
                
                // Update Sidebar
                if(txtTotalQty) txtTotalQty.value = totalQty.toFixed(2);
                if(txtTotalTax) txtTotalTax.value = totalTax.toFixed(2);
                if(netTotalInput) netTotalInput.value = totalNet.toFixed(2);
                
                // Commission Calc
                const commPerField = document.getElementById('txtCommPer');
                if(commPerField) {
                    const commPer = parseFloat(commPerField.value) || 0;
                    const commAmt = (totalBase * commPer) / 100;
                    const commAmtField = document.getElementById('txtCommAmt');
                    if(commAmtField) commAmtField.value = commAmt.toFixed(2);
                }
            }

            // --- Row Management ---
             function reindex() {
                 Array.from(body.children).forEach((row, idx) => {
                    row.querySelectorAll('input, select').forEach(i => {
                        const name = i.getAttribute('name');
                        if(name) i.setAttribute('name', name.replace(/LineItems\[\d+\]/, `LineItems[${idx}]`));
                    });
                });
            }

            if(addRowBtn) {
                addRowBtn.addEventListener('click', function() {
                    const idx = body.children.length;
                    const clone = template.content.cloneNode(true);
                    clone.querySelectorAll('input, select').forEach(i => {
                         const name = i.getAttribute('name');
                         if(name) i.setAttribute('name', name.replace('__INDEX__', idx));
                    });
                    
                    body.appendChild(clone);
                    filterItemDropdowns(); // Filter the new row immediately
                    updateItemSelection();
                });
            }

            // Event Delegation
            body.addEventListener('input', function(e) {
                if(e.target.matches('.qty-input, .rate-input, .lbs-input, .gstper-input')) {
                     calcRow(e.target.closest('tr'));
                     calcTotals();
                     
                     if (e.target.matches('.qty-input')) validateRowQty(e.target.closest('tr'));
                }
            });

            const commPerInput = document.getElementById('txtCommPer');
            if(commPerInput) commPerInput.addEventListener('input', calcTotals);

            body.addEventListener('change', function(e) {
                if(e.target.matches('.item-select')) {
                    updateItemSelection();
                    
                    const row = e.target.closest('tr');
                    const itemId = e.target.value;
                    const infoSpan = row.querySelector('.item-balance-info');
                    const qtyInput = row.querySelector('.qty-input');
                    
                    // Auto-fill GST if empty
                    const gstInput = row.querySelector('.gstper-input');
                    if (gstInput && (gstInput.value === '' || gstInput.value === null)) {
                        gstInput.value = '0.00';
                    }

                    const ssdId = ddlRef.value;
                    const purNo = ddlPur.value;
                    
                    let minBalance = Infinity;
                    let hasReference = false;

                    // Check PUR Balance
                    if (purNo && purData[purNo] && itemId) {
                        const itemData = purData[purNo].items.find(i => i.itemId == itemId);
                        if (itemData) {
                            minBalance = Math.min(minBalance, itemData.remainingQty);
                            hasReference = true;
                        }
                    }

                    // Check SSD Balance
                    if (ssdId && ssdData[ssdId] && itemId) {
                        const itemData = ssdData[ssdId].items.find(i => i.itemId == itemId);
                        if (itemData) {
                            minBalance = Math.min(minBalance, itemData.remainingQty);
                            hasReference = true;
                            // Auto-fill Rate if needed (from SSD as per old logic)
                            if(itemData.rate && !qtyInput.value) row.querySelector('.rate-input').value = parseFloat(itemData.rate).toFixed(4);
                        }
                    }

                    if (hasReference && minBalance !== Infinity) {
                        infoSpan.textContent = `Available Balance: ${minBalance}`;
                        infoSpan.style.display = 'block';
                        qtyInput.max = minBalance;
                        validateRowQty(row);
                        calcRow(row);
                        calcTotals();
                    } else {
                        infoSpan.style.display = 'none';
                        qtyInput.removeAttribute('max');
                    }
                }
            });
            
            body.addEventListener('click', function(e) {
                if(e.target.closest('.remove-row-btn')) {
                     if(body.children.length > 1) {
                         e.target.closest('tr').remove();
                         reindex();
                         calcTotals();
              filterRefDropdown();
              filterPurDropdown();
              updateItemSelection();
                     } else {
                         alert("At least one item is required.");
                     }
                }
            });


            // --- Filtering Logic ---

            function filterItemDropdowns() {
                const purNo = ddlPur ? ddlPur.value : "";
                const selects = document.querySelectorAll('.item-select');
                const templateSelect = template.content.querySelector('.item-select');
                
                const allSelects = [...selects];
                if(templateSelect) allSelects.push(templateSelect);

                allSelects.forEach(select => {
                    const currentValue = select.value;
                    
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;
                        
                        let isAvailable = true;
                        if (purNo && purData[purNo] && purData[purNo].items && purData[purNo].items.length > 0) {
                            // Filter: Exists in PUR items?
                            isAvailable = purData[purNo].items.some(i => i.itemId == option.value);
                        } else {
                            // If no PUR selected, show all items (or filter by SSD if present)
                            const ssdId = ddlRef.value;
                            if (ssdId && ssdData[ssdId] && ssdData[ssdId].items) {
                                isAvailable = ssdData[ssdId].items.some(i => i.itemId == option.value);
                            }
                        }

                        if (isAvailable) {
                            option.style.display = '';
                            option.disabled = false;
                        } else {
                            option.style.display = 'none';
                            option.disabled = true;
                        }
                    });

                    // Clear if invalid
                    if (currentValue && select.options[select.selectedIndex]?.style.display === 'none') {
                        select.value = "";
                         // Clear info text
                        const row = select.closest('tr');
                        if(row) {
                            const info = row.querySelector('.item-balance-info');
                            if(info) info.style.display = 'none';
                        }
                    }
                });
            }

             // State to hold fetched SSD details
             let currentSsdDetails = null;

             async function fetchSsdList(customerId) {
                 const url = `?handler=FilteredSsd&customerId=${customerId}`;
                 try {
                     const response = await fetch(url);
                     const data = await response.json();
                     
                     // Keep current value if possible
                     const currentVal = ddlRef.value;
                     
                     // Clear SSD dropdown (except first option)
                     while (ddlRef.options.length > 1) ddlRef.remove(1);
                     
                     data.forEach(item => {
                         const opt = document.createElement('option');
                         opt.value = item.entryId;
                         opt.textContent = item.displayText;
                         ddlRef.appendChild(opt);
                     });
                     
                     if (currentVal && Array.from(ddlRef.options).some(o => o.value == currentVal)) {
                         ddlRef.value = currentVal;
                     } else {
                         ddlRef.value = "";
                     }
                 } catch (err) { console.error("Error fetching SSD list:", err); }
             }

             async function fetchSsdDetails(ssdId) {
                 if (!ssdId) {
                     currentSsdDetails = null;
                     return;
                 }
                 const url = `?handler=SsdDetails&ssdId=${ssdId}`;
                 try {
                     const response = await fetch(url);
                     const data = await response.json();
                     currentSsdDetails = data;
                     
                     if (data) {
                         // Store in ssdData cache for balance checks
                         if (data.items) {
                             ssdData[ssdId] = { items: data.items };
                         }

                         // Update details text
                         refDetails.textContent = `Date: ${data.date} | Total Remaining: ${data.qty}`;
                         
                         // Filter and select PUR
                         if (data.validPurs) {
                             // Keep current value if possible
                             const currentPur = ddlPur.value;
                             
                             // Clear current PUR options except empty
                             while (ddlPur.options.length > 1) ddlPur.remove(1);
                             
                             data.validPurs.forEach(p => {
                                 const opt = document.createElement('option');
                                 opt.value = p.value;
                                 opt.textContent = p.text;
                                 ddlPur.appendChild(opt);
                             });
                             
                             if (currentPur && Array.from(ddlPur.options).some(o => o.value == currentPur)) {
                                 ddlPur.value = currentPur;
                             } else if (data.validPurs.length === 1) {
                                 // Auto-select if only one available
                                 ddlPur.value = data.validPurs[0].value;
                                 ddlPur.dispatchEvent(new Event('change', { bubbles: true }));
                             } else {
                                 ddlPur.value = "";
                             }
                         }
                         
                         // Auto-fill table
                         if (data.items && data.items.length > 0) {
                             body.innerHTML = '';
                             data.items.forEach((item, idx) => {
                                 const clone = template.content.cloneNode(true);
                                 clone.querySelector('.item-select').value = item.itemId;
                                 clone.querySelector('.qty-input').value = item.remainingQty;
                                 clone.querySelector('.rate-input').value = item.rate;
                                 clone.querySelector('.lbs-input').value = item.lbs;
                                 
                                 clone.querySelectorAll('input, select').forEach(i => {
                                     const name = i.getAttribute('name');
                                     if(name) i.setAttribute('name', name.replace('__INDEX__', idx));
                                 });
                                 body.appendChild(clone);
                             });
                             
                             body.querySelectorAll('.line-item-row').forEach(row => {
                                 calcRow(row);
                             });
                             calcTotals();
                             updateItemSelection();
                         }
                     }
                 } catch (err) { console.error("Error fetching SSD details:", err); }
             }

             function updateItemSelection() {
                 const selects = document.querySelectorAll('.item-select');
                 const selectedItems = Array.from(selects)
                     .map(select => select.value)
                     .filter(val => val !== "");

                 selects.forEach(select => {
                     const currentValue = select.value;
                     Array.from(select.options).forEach(option => {
                         if (option.value === "") return;
                         if (selectedItems.includes(option.value) && option.value !== currentValue) {
                             option.disabled = true;
                         } else {
                             option.disabled = false;
                         }
                     });
                 });
             }

             function validateRowQty(row) {
                 const qtyInput = row.querySelector('.qty-input');
                 const itemSelect = row.querySelector('.item-select');
                 
                 if(currentSsdDetails && itemSelect.value) {
                     const itemData = currentSsdDetails.items.find(i => i.itemId == itemSelect.value);
                     if(itemData) {
                         const max = itemData.remainingQty;
                         const qty = parseFloat(qtyInput.value) || 0;
                         if(qty > max) {
                             qtyInput.classList.add('is-invalid');
                         } else {
                             qtyInput.classList.remove('is-invalid');
                         }
                     }
                 }
             }

             function updateRowBalance(row) {
                const itemId = row.querySelector('.item-select').value;
                const infoSpan = row.querySelector('.item-balance-info');
                const qtyInput = row.querySelector('.qty-input');
                
                if (currentSsdDetails && itemId) {
                    const itemData = currentSsdDetails.items.find(i => i.itemId == itemId);
                    if (itemData) {
                        const bal = itemData.remainingQty;
                        infoSpan.textContent = `Available Balance: ${bal}`;
                        infoSpan.style.display = 'block';
                        qtyInput.max = bal;
                    }
                } else {
                    infoSpan.style.display = 'none';
                }
             }

             // --- Event Listeners ---

             if (ddlCust) {
                 ddlCust.addEventListener('change', function() {
                     fetchSsdList(this.value);
                     // Selecting a customer should reset others
                     ddlRef.value = "";
                     refDetails.textContent = "";
                     // Optionally let PUR be filtered by customer too
                 });
             }

             if (ddlRef) {
                 ddlRef.addEventListener('change', function() {
                     fetchSsdDetails(this.value);
                 });
             }

             if (ddlPur) {
                 ddlPur.addEventListener('change', function(e) {
                     const val = this.value;
                     if (!e.isTrusted) return; 
                     
                     // Update row balances when PUR changes
                     body.querySelectorAll('.line-item-row').forEach(row => updateRowBalance(row));
                 });
             }

             // Validation before submit
             const mainForm = document.getElementById('salesForm');
             if(mainForm) {
                 mainForm.addEventListener('submit', function(e) {
                     // Check invalid classes
                     if(document.querySelectorAll('.is-invalid').length > 0) {
                         e.preventDefault();
                         alert("Please fix validation errors (Quantity exceeds available balance).");
                     }
                     
                     // Also helpful: check total qty
                     // Check if at least one item?
                     if(body.querySelectorAll('.line-item-row').length === 0) {
                          e.preventDefault();
                          alert("Please add at least one item.");
                     }
                 });
             }

            // Initial calcs
             body.querySelectorAll('.line-item-row').forEach(row => {
                 calcRow(row);
                 updateRowBalance(row);
             });
             calcTotals();
              updateItemSelection();
        });
    </script>
}
