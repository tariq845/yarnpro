@page
@model YIS.Pages.Sales.SalesModel
@{
    ViewData["Title"] = "Sales Invoices";
}

<link rel="stylesheet" href="~/css/categories.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" id="salesSearchForm" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SortDir" id="sortDirInput" value="@Model.SortDir" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                        @if (Model.SsdId.HasValue)
                        {
                            <input type="hidden" name="SsdId" value="@Model.SsdId" />
                        }

                        <div class="position-relative flex-grow-1">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input pe-4" 
                                   id="salesSearch" 
                                   list="salesSearchDatalist"
                                   placeholder="Search (e.g. sal-1, 1, party)..."
                                   value="@Model.SearchTerm"
                                   autocomplete="off"
                                   hx-get="/Sales"
                                   hx-include="#salesSearchForm"
                                   hx-trigger="input changed delay:400ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="javascript:void(0)" 
                                   onclick="clearSearchInput('salesSearch', 'salesSearchForm')"
                                   class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none"
                                   title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </a>
                            }
                            <datalist id="salesSearchDatalist">
                                @foreach (var item in Model.SearchSuggestions)
                                {
                                    <option value="@item">@item</option>
                                }
                            </datalist>
                        </div>

                        <!-- Up to Down / Down to Up Sort Direction Button -->
                        <button type="button" 
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                id="btnToggleSort"
                                onclick="toggleSortDirection('sortDirInput', 'salesSearchForm')"
                                title="@(Model.SortDir == "asc" ? "Sort: Oldest first (Up to Down). Click for Newest first." : "Sort: Newest first (Down to Up). Click for Oldest first.")">
                            <i class="bi @(Model.SortDir == "asc" ? "bi-sort-up text-primary fw-bold" : "bi-sort-down text-dark fw-bold") fs-6"></i>
                            <span class="small d-none d-lg-inline">@(Model.SortDir == "asc" ? "Oldest First" : "Newest First")</span>
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    @if (Model.Invoices != null && Model.Invoices.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Invoices :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Invoices.Count()
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end">
                    <a href="/Sales/Entry" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        New Sale
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3" style="width: 12%;">Invoice #</th>
                            <th class="border-0 px-4 py-3" style="width: 12%;">Date</th>
                            <th class="border-0 px-4 py-3" style="width: 15%;">Customer</th>
                            <th class="border-0 px-4 py-3" style="width: 12%;">Status</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 10%;">Tax</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 12%;">Net Amount</th>
                            <th class="border-0 px-4 py-3" style="width: 12%;">Ref SSD</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Invoices != null && Model.Invoices.Any())
                        {
                            foreach (var item in Model.Invoices)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Sales/Entry?id=@item.EntryId"
                                           class="text-decoration-none fw-semibold text-danger">
                                            SAL-@item.EntryNumber
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@(item.EntryDate?.ToString("dd-MM-yyyy"))</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.CustomerName</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="d-flex flex-column gap-1">
                                            <!-- Ledger Status -->
                                            @if (item.IsLedgerPosted)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success fw-semibold" style="font-size: 10px; padding: 4px 8px;">
                                                    <i class="bi bi-bank me-1"></i> Ledger Posted
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning fw-semibold" style="font-size: 10px; padding: 4px 8px;">
                                                    <i class="bi bi-bank me-1"></i> Ledger Draft
                                                </span>
                                            }

                                            <!-- FBR Status -->
                                            @if (item.IsFbrPosted)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info fw-semibold" style="font-size: 10px; padding: 4px 8px;">
                                                    <i class="bi bi-cloud-check-fill me-1"></i> FBR Posted
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary fw-semibold" style="font-size: 10px; padding: 4px 8px;">
                                                    <i class="bi bi-cloud-slash-fill me-1"></i> FBR Draft
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <span class="text-muted">@item.TaxAmount?.ToString("N2")</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <span class="fw-bold text-success">@item.Amount.ToString("N2")</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-muted">@item.RefSsdNo</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            <a href="/Sales/InvoiceView/@item.EntryId" class="btn btn-sm btn-outline-info" title="View Invoice" target="_blank">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>

                                            @if (item.IsLedgerPosted && !item.IsFbrPosted)
                                            {
                                                <form method="post" asp-page-handler="PostToFbr" asp-route-id="@item.EntryId" 
                                                      onsubmit="return confirm('Report SAL-@item.EntryNumber to FBR?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-info" title="Post to FBR">
                                                        <i class="bi bi-cloud-arrow-up-fill"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (!item.IsLedgerPosted)
                                            {
                                                <form method="post" asp-page-handler="PostToLedger" asp-route-id="@item.EntryId" 
                                                      onsubmit="return confirm('Post SAL-@item.EntryNumber to ledger? This action cannot be undone and will lock the record.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Post to Ledger">
                                                        <i class="bi bi-send-fill"></i>
                                                    </button>
                                                </form>

                                                <form method="post" 
                                                      asp-page-handler="Delete" 
                                                      asp-route-id="@item.EntryId" 
                                                      onsubmit="return confirm('Are you sure you want to delete this invoice?');">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                @if (item.IsFbrPosted)
                                                {
                                                    <button class="btn btn-sm btn-outline-success" disabled title="FBR Posted">
                                                        <i class="bi bi-cloud-check-fill"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Locked (FBR Posted)">
                                                        <i class="bi bi-lock-fill"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <form method="post" asp-page-handler="UnpostFromLedger" asp-route-id="@item.EntryId"
                                                          onsubmit="return confirm('Unpost SAL-@item.EntryNumber from ledger?\n\nThis will delete the GL entries (Debit + Credit) from the TRANS table.\n\nThe invoice will remain but become editable again.')">
                                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Unpost from Ledger">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Sales Invoices Found</h5>
                                        <p class="text-muted">Create your first sales invoice to get started</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('submit', function (e) {
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');

            if (btn && (btn.title === 'Post to Ledger' || 
                        btn.title === 'Unpost from Ledger' ||
                        btn.title === 'Post to FBR' || 
                form.getAttribute('asp-page-handler') === 'PostToLedger' || 
                form.getAttribute('asp-page-handler') === 'UnpostFromLedger' || 
                form.getAttribute('asp-page-handler') === 'PostToFbr')) {
                
                // Wait for the confirm dialog (if any) to finish
                setTimeout(() => {
                    if (!e.defaultPrevented) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    }
                }, 10);
            }
        });
    </script>
}
