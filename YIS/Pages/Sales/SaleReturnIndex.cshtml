@page

@model YIS.Pages.Sales.SaleReturnIndexModel

@{

    ViewData["Title"] = "Sales Returns (Credit Notes)";

}



<link rel="stylesheet" href="~/css/categories.css" />



<div>

    <!-- Search and Filter Bar -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-5">

                    <form method="get" id="cnSearchForm" class="d-flex align-items-center gap-2">

                        <input type="hidden" name="SortDir" id="sortDirInput" value="@Model.SortDir" />

                        <input type="hidden" name="PageSize" value="@Model.PageSize" />



                        <div class="position-relative flex-grow-1">

                            <i class="bi bi-search yis-cat-search-icon"></i>

                            <input type="text" 

                                   name="SearchTerm"

                                   class="form-control yis-cat-search-input pe-4" 

                                   id="cnSearch" 

                                   list="cnSearchDatalist"

                                   placeholder="Search (e.g. cn-1, 1, customer)..."

                                   value="@Model.SearchTerm"

                                   autocomplete="off"

                                   hx-get="/Sales/SaleReturnIndex"

                                   hx-include="#cnSearchForm"

                                   hx-trigger="input changed delay:400ms, search"

                                   hx-target="#table-container"

                                   hx-select="#table-container"

                                   hx-push-url="true">

                            @if (!string.IsNullOrEmpty(Model.SearchTerm))

                            {

                                <a href="javascript:void(0)" 

                                   onclick="clearSearchInput('cnSearch', 'cnSearchForm')"

                                   class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none"

                                   title="Clear search">

                                    <i class="bi bi-x-circle-fill"></i>

                                </a>

                            }

                            <datalist id="cnSearchDatalist">

                                @foreach (var item in Model.SearchSuggestions)

                                {

                                    <option value="@item">@item</option>

                                }

                            </datalist>

                        </div>



                        <!-- Up to Down / Down to Up Sort Direction Button -->

                        <button type="button" 

                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"

                                id="btnToggleSort"

                                onclick="toggleSortDirection('sortDirInput', 'cnSearchForm')"

                                title="@(Model.SortDir == "asc" ? "Sort: Oldest first (Up to Down). Click for Newest first." : "Sort: Newest first (Down to Up). Click for Oldest first.")">

                            <i class="bi @(Model.SortDir == "asc" ? "bi-sort-up text-primary fw-bold" : "bi-sort-down text-dark fw-bold") fs-6"></i>

                            <span class="small d-none d-lg-inline">@(Model.SortDir == "asc" ? "Oldest First" : "Newest First")</span>

                        </button>

                    </form>

                </div>

                <div class="col-md-4">

                     @if (Model.CNList != null && Model.CNList.Any())

                    {

                        <div class="row justify-content-center">

                            <div class="col-auto">

                                <h6 class="text-muted text-uppercase mb-0 text-center"

                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">

                                    Total CNs :

                                    <span class="fw-bold fs-6 text-dark">

                                        @Model.Pagination.TotalItems

                                    </span>

                                </h6>

                            </div>

                        </div>

                    }

                </div>

                <div class="col-md-3 text-end d-flex justify-content-end align-items-center gap-2">

                    <a asp-page-handler="DownloadExcel" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success text-nowrap" title="Export to Excel">

                        <i class="bi bi-file-earmark-excel me-1"></i>Excel

                    </a>

                    <a href="/Sales/SaleReturn" class="btn btn-primary text-white text-nowrap">

                        <i class="bi bi-plus-lg me-1"></i>

                        New Credit Note

                    </a>

                </div>

            </div>

        </div>

    </div>



    <!-- Table Card -->

    <div class="card shadow-sm border-0" id="table-container">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="border-0 px-4 py-3">CN #</th>

                            <th class="border-0 px-4 py-3">Date</th>

                            <th class="border-0 px-4 py-3">Customer</th>

                            <th class="border-0 px-4 py-3 text-center">Status</th>

                            <th class="border-0 px-4 py-3 text-center">Items</th>

                            <th class="border-0 px-4 py-3 text-end">Net Amount</th>

                            <th class="border-0 px-4 py-3 text-end">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.CNList != null && Model.CNList.Any())

                        {

                            foreach (var item in Model.CNList)

                            {

                                <tr>

                                    <td class="px-4 py-3">

                                        <a asp-page="./SaleReturn" asp-route-id="@item.EntryId" class="text-decoration-none fw-semibold text-success">

                                            CN-@item.EntryNumber

                                        </a>

                                    </td>

                                    <td class="px-4 py-3">

                                        <span class="fw-medium text-dark">@(item.EntryDate?.ToString("dd-MM-yyyy"))</span>

                                    </td>

                                     <td class="px-4 py-3">

                                        <span class="text-dark">@item.AttributeName</span>

                                    </td>

                                    <td class="px-4 py-3 text-center">

                                        @if (item.IsPosted)

                                        {

                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-semibold" style="font-size: 11px; padding: 5px 10px;">

                                                <i class="bi bi-check-circle-fill me-1"></i> Posted

                                            </span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning fw-semibold" style="font-size: 11px; padding: 5px 10px;">

                                                <i class="bi bi-pencil-fill me-1"></i> Draft

                                            </span>

                                        }

                                    </td>

                                    <td class="px-4 py-3 text-center">

                                        <span class="badge bg-secondary rounded-pill">@item.ItemCount</span>

                                    </td>

                                    <td class="px-4 py-3 text-end">

                                        <span class="fw-bold text-dark">@item.Amount?.ToString("N2")</span>

                                    </td>

                                    <td class="px-4 py-3 text-end">

                                        <div class="d-flex justify-content-end gap-2 align-items-center">

                                             @if (!item.IsPosted)

                                             {

                                                <form method="post" asp-page-handler="PostToLedger" asp-route-id="@item.EntryId" 

                                                      onsubmit="return confirm('Post CN-@item.EntryNumber to ledger? This will lock the record.');">

                                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Post to Ledger">

                                                        <i class="bi bi-send-fill"></i>

                                                    </button>

                                                </form>



                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.EntryId" onsubmit="return confirm('Are you sure you want to delete this CN?');">

                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>

                                             }

                                             else

                                             {

                                                 <form method="post" asp-page-handler="UnpostFromLedger" asp-route-id="@item.EntryId"
                                                      onsubmit="return confirm('Unpost CN-@item.EntryNumber from ledger?\n\nThis will delete the GL entries (Debit + Credit) from the TRANS table.\n\nThe credit note will remain but become editable again.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Unpost from Ledger">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>

                                             }

                                        </div>

                                    </td>

                                </tr>

                            }

                        }

                        else

                        {

                             <tr>

                                <td colspan="7" class="text-center py-5">

                                    <div class="py-4">

                                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>

                                        <h5 class="mt-3 text-muted">No Credit Notes Found</h5>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

            @await Html.PartialAsync("_Pagination", Model.Pagination)

        </div>

    </div>

</div>



@* Server-side search implemented *@

