@page
@model YIS.Pages.Sales.IndexSodaModel
@{
    ViewData["Title"] = "Sale SODA";
}
<link rel="stylesheet" href="~/css/categories.css" />
<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" id="saleSodaSearchForm" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SortDir" id="sortDirInput" value="@Model.SortDir" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                        <div class="position-relative flex-grow-1">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input pe-4" 
                                   id="saleSodaSearch" 
                                   list="saleSodaSearchDatalist"
                                   placeholder="Search (e.g. ssd-1, 1, customer)..."
                                   value="@Model.SearchTerm"
                                   autocomplete="off">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="javascript:void(0)" 
                                   onclick="clearSearchInput('saleSodaSearch', 'saleSodaSearchForm')"
                                   class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none"
                                   title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </a>
                            }
                            <datalist id="saleSodaSearchDatalist">
                                @foreach (var item in Model.SearchSuggestions)
                                {
                                    <option value="@item">@item</option>
                                }
                            </datalist>
                        </div>
                        <!-- Up to Down / Down to Up Sort Direction Button -->
                        <button type="button" 
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                id="btnToggleSort"
                                onclick="toggleSortDirection('sortDirInput', 'saleSodaSearchForm')"
                                title="@(Model.SortDir == "asc" ? "Sort: Oldest first (Up to Down). Click for Newest first." : "Sort: Newest first (Down to Up). Click for Oldest first.")">
                            <i class="bi @(Model.SortDir == "asc" ? "bi-sort-up text-primary fw-bold" : "bi-sort-down text-dark fw-bold") fs-6"></i>
                            <span class="small d-none d-lg-inline">@(Model.SortDir == "asc" ? "Oldest First" : "Newest First")</span>
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    @if (Model.Entries != null && Model.Entries.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Sales :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end d-flex justify-content-end align-items-center gap-2">
                    <a asp-page-handler="DownloadExcel" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success text-nowrap" title="Export to Excel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                    <a href="/Sales/Soda" class="btn btn-primary text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>
                        New Sale
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3" style="width: 10%;">SSD #</th>
                            <th class="border-0 px-4 py-3" style="width: 10%;">Date</th>
                            <th class="border-0 px-4 py-3" style="width: 14%;">Customer</th>
                            <th class="border-0 px-4 py-3">Narration / Details</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 12%;">Grand Total</th>
                            <th class="border-0 px-4 py-3 text-center" style="width: 8%;">Invoices</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 12%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entries != null && Model.Entries.Any())
                        {
                            foreach (var item in Model.Entries)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Sales/Soda?id=@item.EntryId"
                                           class="text-decoration-none fw-semibold text-danger">
                                            SSD-@item.EntryNumber
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@(item.EntryDate?.ToString("dd-MM-yyyy"))</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.CustomerName</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.LineDetails != null && item.LineDetails.Any())
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var line in item.LineDetails)
                                                {
                                                    <div class="small">
                                                        <span class="fw-semibold text-dark">@line.ItemName</span>
                                                        @if (line.Qty.HasValue && line.Qty > 0)
                                                        {
                                                            <span class="badge bg-light text-secondary border ms-1">@line.Qty.Value.ToString("N0") Bags</span>
                                                        }
                                                        @if (line.Lbs.HasValue && line.Lbs > 0)
                                                        {
                                                            <span class="badge bg-light text-secondary border ms-1">@line.Lbs.Value.ToString("N2") Lbs</span>
                                                        }
                                                        @if (line.Rate.HasValue && line.Rate > 0)
                                                        {
                                                            <span class="badge bg-light text-secondary border ms-1">Rate: @line.Rate.Value.ToString("N2")</span>
                                                        }
                                                    </div>
                                                }
                                                @if (item.PsdNumber.HasValue && item.PsdNumber > 0)
                                                {
                                                    <div class="mt-1">
                                                        <a href="/Purchase/SodaView/@(item.RefPsdId ?? item.PsdNumber)" target="_blank"
                                                           class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none"
                                                           title="Open Referenced Purchase Soda Contract">
                                                            <i class="bi bi-file-earmark-text me-1"></i>Soda: PSD-@item.PsdNumber <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 9px;"></i>
                                                        </a>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Remarks) && item.Remarks != "Sales Soda")
                                                {
                                                    <div class="text-muted small fst-italic">@item.Remarks</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                @if (item.PsdNumber.HasValue && item.PsdNumber > 0)
                                                {
                                                    <a href="/Purchase/SodaView/@(item.RefPsdId ?? item.PsdNumber)" target="_blank"
                                                       class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none"
                                                       title="Open Referenced Purchase Soda Contract">
                                                        <i class="bi bi-file-earmark-text me-1"></i>Soda: PSD-@item.PsdNumber <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 9px;"></i>
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                                {
                                                    <div class="text-muted small fst-italic">@item.Remarks</div>
                                                }
                                                else if (!item.PsdNumber.HasValue)
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <span class="fw-bold text-success">@item.GrandTotal?.ToString("N2")</span>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        @if (item.InvoiceCount > 0)
                                        {
                                            <a href="/Sales/Index?SsdId=@item.EntryId" 
                                               class="text-decoration-none fw-semibold text-danger" 
                                               title="View @item.InvoiceCount Invoices">
                                                @item.InvoiceCount
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            <a href="/Sales/SodaView/@item.EntryId" 
                                               class="btn btn-sm btn-outline-info" 
                                               title="View / Print SSD Contract PDF" target="_blank">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>
                                            <a href="/Sales/Entry?ssdId=@item.EntryId" 
                                               class="btn btn-link p-0 border-0 bg-transparent" 
                                               title="Create Invoice">
                                                <i class="bi bi-plus-circle-fill text-success"></i>
                                            </a>
                                            <a href="/Reports/SsdTrackRecord/@item.EntryId" 
                                               class="btn btn-link p-0 border-0 bg-transparent" 
                                               title="View Track Record">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                            <form method="post" 
                                                  asp-page-handler="Delete" 
                                                  asp-route-id="@item.EntryId" 
                                                  style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to delete this sale?');">
                                                <button type="submit"
                                                        class="btn btn-link p-0 border-0 bg-transparent"
                                                        title="Delete">
                                                    <i class="bi bi-trash text-danger"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-receipt-cutoff text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Sale Soda Entries Found</h5>
                                        <p class="text-muted">Create your first sale soda entry to get started</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>
@* Server-side search implemented *@
