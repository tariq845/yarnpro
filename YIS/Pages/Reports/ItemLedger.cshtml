@page
@model YIS.Pages.Reports.ItemLedgerModel
@{
    ViewData["Title"] = "Item Ledger Report";
    ViewData["BreadcrumbParent"] = "Reports";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row align-items-end g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted small text-uppercase fw-bold">Select Item</label>
                        <select asp-for="SelectedItemId" asp-items="Model.ItemList" class="form-select" data-control="select2" data-placeholder="Choose an item...">
                            <option value="">-- Select Product --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small text-uppercase fw-bold">From Date</label>
                        <input asp-for="FromDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small text-uppercase fw-bold">To Date</label>
                        <input asp-for="ToDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                         <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i> Show
                         </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SelectedItemId.HasValue || Model.LedgerList.Any())
    {
        <!-- Table Card -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 border-0">
                 <div class="row justify-content-between align-items-center">
                    <div class="col-auto">
                        <h5 class="mb-0 text-primary fw-bold">
                            @(Model.ItemList.FirstOrDefault(x => x.Value == Model.SelectedItemId?.ToString())?.Text ?? "Ledger")
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-3">
                            <h6 class="text-uppercase text-muted mb-0" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                Opening Stock :
                                <span class="fs-5 fw-bold ms-1 text-dark">
                                    @Model.OpeningBalance.ToString("N0")
                                </span>
                            </h6>
                            <span class="text-muted">|</span>
                            <h6 class="text-uppercase text-muted mb-0" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                Opening Value :
                                <span class="fs-6 fw-bold ms-1 text-primary">
                                    Rs. @Model.OpeningValue.ToString("N2")
                                </span>
                                @if (Model.LastPurchaseRate > 0)
                                {
                                    <span class="text-muted fw-normal small"> (@@ @Model.LastPurchaseRate.ToString("N2"))</span>
                                }
                            </h6>
                        </div>
                    </div>
                 </div>
            </div>
            
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 px-4 py-3">Date</th>
                                <th class="border-0 px-4 py-3">Ref No</th>
                                <th class="border-0 px-4 py-3">Type</th>
                                <th class="border-0 px-4 py-3">Party</th>
                                <th class="border-0 px-4 py-3 text-end text-success">Purchase</th>
                                <th class="border-0 px-4 py-3 text-end text-warning">Debit Note</th>
                                <th class="border-0 px-4 py-3 text-end text-danger">Sale</th>
                                <th class="border-0 px-4 py-3 text-end text-info">Credit Note</th>
                                <th class="border-0 px-4 py-3 text-end">Rate</th>
                                <th class="border-0 px-4 py-3 text-end">Amount</th>
                                <th class="border-0 px-4 py-3 text-end fw-bold">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Opening Stock Row if filtered by date or opening balance exists *@
                            @if (Model.FromDate.HasValue || Model.OpeningBalance != 0)
                            {
                                <tr class="table-light fw-medium">
                                    <td class="px-4 py-3 text-nowrap text-muted">
                                        @(Model.FromDate?.ToString("dd-MM-yyyy") ?? "-")
                                    </td>
                                    <td class="px-4 py-3 text-muted">-</td>
                                    <td class="px-4 py-3">
                                        <span class="fw-bold text-secondary">Opening Stock</span>
                                    </td>
                                    <td class="px-4 py-3 text-muted">-</td>
                                    <td class="px-4 py-3 text-end text-muted">-</td>
                                    <td class="px-4 py-3 text-end text-muted">-</td>
                                    <td class="px-4 py-3 text-end text-muted">-</td>
                                    <td class="px-4 py-3 text-end text-muted">-</td>
                                    <td class="px-4 py-3 text-end text-muted">
                                        @(Model.LastPurchaseRate > 0 ? Model.LastPurchaseRate.ToString("N2") : "-")
                                    </td>
                                    <td class="px-4 py-3 text-end fw-bold text-primary">
                                        @(Model.OpeningValue != 0 ? Model.OpeningValue.ToString("N2") : "-")
                                    </td>
                                    <td class="px-4 py-3 text-end fw-bold">
                                        @Model.OpeningBalance.ToString("N0")
                                    </td>
                                </tr>
                            }

                            @if (Model.LedgerList.Any())
                            {
                                foreach (var item in Model.LedgerList)
                                {
                                    <tr>
                                        <td class="px-4 py-3 text-nowrap">
                                            @item.Date.ToString("dd-MM-yyyy")
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="fw-medium">@item.RefNo</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="fw-medium">@item.RefType</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            @item.PartyName
                                        </td>
                                        
                                        <!-- Purchase -->
                                        <td class="px-4 py-3 text-end text-success bg-opacity-10">
                                            @if(item.PurchaseQty != 0)
                                            {
                                                <span>@item.PurchaseQty.ToString("N0")</span>
                                            }
                                        </td>

                                        <!-- Debit Note (Purchase Return - OUT) -->
                                        <td class="px-4 py-3 text-end text-warning bg-opacity-10">
                                            @if(item.DebitNoteQty != 0)
                                            {
                                                <span>@item.DebitNoteQty.ToString("N0")</span>
                                            }
                                        </td>

                                        <!-- Sale (OUT) -->
                                        <td class="px-4 py-3 text-end text-danger bg-opacity-10">
                                            @if(item.SaleQty != 0)
                                            {
                                                <span>@item.SaleQty.ToString("N0")</span>
                                            }
                                        </td>

                                        <!-- Credit Note (Sale Return - IN) -->
                                        <td class="px-4 py-3 text-end text-info bg-opacity-10">
                                            @if(item.CreditNoteQty != 0)
                                            {
                                                <span>@item.CreditNoteQty.ToString("N0")</span>
                                            }
                                        </td>

                                        <!-- Rate -->
                                        <td class="px-4 py-3 text-end">
                                            @(item.Rate.HasValue && item.Rate.Value > 0 ? item.Rate.Value.ToString("N2") : "-")
                                        </td>

                                        <!-- Amount -->
                                        <td class="px-4 py-3 text-end fw-medium text-dark">
                                            @(item.Amount.HasValue && item.Amount.Value > 0 ? item.Amount.Value.ToString("N2") : "-")
                                        </td>

                                        <!-- Balance -->
                                        <td class="px-4 py-3 text-end fw-bold">
                                            @item.Balance.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            }
                            else if (!Model.FromDate.HasValue && Model.OpeningBalance == 0)
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-5">
                                        <div class="py-4">
                                            <i class="bi bi-journal-text text-muted" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3 text-muted">No transactions found</h5>
                                            <p class="text-muted">No records match the selected item and date range.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
         <div class="text-center py-5">
            <div class="py-5">
                <i class="bi bi-hand-index-thumb text-muted" style="font-size: 4rem; opacity: 0.5;"></i>
                <h4 class="mt-4 text-muted fw-light">Select an Item to View Ledger</h4>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Initialize Select2 implies standard behavior if included in layout.
    </script>
}
