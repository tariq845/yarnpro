@page
@model YIS.Pages.Reports.CustomerAgingModel
@{
    ViewData["Title"] = Model.CustomerId.HasValue ? $"Aging Detail - {Model.SelectedCustomer?.CustomerName ?? "Customer"}" : "Customer Aging (Receivables)";
    ViewData["BreadcrumbParent"] = "Reports";
    bool isDetailView = Model.CustomerId.HasValue || !string.IsNullOrEmpty(Model.SodaNo);
}

<link rel="stylesheet" href="~/css/categories.css" />

<style>
    /* Styling inspired by Stock and Categories */
    .aging-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.78rem;
    }
    .aging-table thead th {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        vertical-align: middle;
        white-space: nowrap;
        background-color: #f8f9fc;
        border-bottom: 2px solid #e3e6f0;
        padding: 8px 6px;
    }
    .aging-table tbody td {
        font-size: 0.78rem;
        vertical-align: middle;
        padding: 6px 6px;
        border-bottom: 1px solid #edf2f9;
    }
    
    .broker-header-row {
        background-color: #eef2f7 !important;
        font-weight: 700;
        color: #2c3e50;
        font-size: 0.82rem;
    }
    .buyer-header-row {
        background-color: #fff9f9 !important;
        font-weight: 700;
        color: #d63031;
        font-size: 0.8rem;
        border-left: 3px solid #d63031;
    }
    .buyer-subtotal-row {
        background-color: #fbfbfb;
        font-weight: 700;
        border-top: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
    }
    .broker-subtotal-row {
        background-color: #eef1f5;
        font-weight: 700;
        border-top: 1px solid #aaa;
        border-bottom: 2px solid #333;
    }
    .grand-total-box {
        font-weight: 800;
        font-size: 1rem;
        border-top: 1px solid #000;
        border-bottom: 3px double #000;
        padding: 4px 14px;
        display: inline-block;
    }

    /* Print Specific Styling matching the uploaded PDF exactly */
    @@media print {
        body {
            background-color: #fff !important;
            font-size: 8pt !important;
            color: #000 !important;
        }
        .no-print, nav, .navbar, .sidebar, .yis-sidebar, footer, .btn, .breadcrumb, #toast-data {
            display: none !important;
        }
        .container-fluid, .content, main {
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        .aging-table {
            font-size: 8pt !important;
        }
        .aging-table th, .aging-table td {
            border: 1px solid #000 !important;
            padding: 2px 4px !important;
        }
        .buyer-header-row {
            color: #b30000 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        @@page {
            size: A4 landscape;
            margin: 8mm 6mm;
        }
    }
</style>

<div>
    <!-- Top Filter Bar matching Stock -->
    <div class="card shadow-sm mb-4 no-print">
        <div class="card-body">
            <!-- Search & Actions Bar -->
            <div class="row align-items-center mb-3">
                <div class="col-md-5">
                    <div class="position-relative">
                        <i class="bi bi-search yis-cat-search-icon"></i>
                        <input type="text" 
                               class="form-control yis-cat-search-input" 
                               id="agingSearch" 
                               placeholder="Search customer, broker, invoice..."
                               value="@Model.SearchTerm"
                               onkeyup="filterTable()">
                    </div>
                </div>
                <div class="col-md-7 text-end d-flex justify-content-end gap-2 align-items-center">
                    @if (isDetailView)
                    {
                        <a href="/Reports/CustomerAging?AsOfDate=@Model.AsOfDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary shadow-sm px-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to Summary List
                        </a>
                    }
                    <button type="button" class="btn btn-outline-dark shadow-sm px-3" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Print PDF
                    </button>
                    <a asp-page-handler="ExportExcel" 
                       asp-route-AsOfDate="@Model.AsOfDate?.ToString("yyyy-MM-dd")"
                       asp-route-CustomerId="@Model.CustomerId"
                       asp-route-BrokerFilter="@Model.BrokerFilter"
                       asp-route-SodaNo="@Model.SodaNo"
                       asp-route-UnClearedOnly="@Model.UnClearedOnly"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       class="btn btn-success shadow-sm px-3">
                        <i class="bi bi-file-earmark-excel me-1"></i> Excel (XLSX)
                    </a>
                </div>
            </div>

            <!-- Filter Controls -->
            <div class="pt-3 border-top">
                <form method="get" id="filterForm">
                    <div class="row align-items-end g-2">
                        <div class="col-md-2">
                            <label class="form-label text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">As Of Date</label>
                            <input type="date" name="AsOfDate" class="form-control form-control-sm"
                                   value="@Model.AsOfDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">Select Customer</label>
                            <select name="CustomerId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All Customers (Summary List) --</option>
                                @foreach (var c in Model.CustomerDropdown)
                                {
                                    <option value="@c.Value" selected="@(Model.CustomerId?.ToString() == c.Value)">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">Sale Group / Broker</label>
                            <select name="BrokerFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- All Brokers / Groups --</option>
                                @foreach (var b in Model.BrokerDropdown)
                                {
                                    <option value="@b.Value" selected="@(Model.BrokerFilter == b.Value)">@b.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">SODA / Contract #</label>
                            <input type="text" name="SodaNo" class="form-control form-control-sm" placeholder="e.g. 7651" value="@Model.SodaNo" />
                        </div>
                        <div class="col-md-2 d-flex align-items-center gap-2">
                            <div class="form-check form-switch pt-2 mb-0">
                                <input class="form-check-input" type="checkbox" name="UnClearedOnly" value="true" id="chkUnCleared" 
                                       checked="@Model.UnClearedOnly" onchange="this.form.submit()" />
                                <label class="form-check-label small fw-bold text-danger" for="chkUnCleared">UnCleared</label>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary px-3">
                                <i class="bi bi-funnel-fill"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4 no-print">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">Total Receivables</div>
                        <div class="fs-5 fw-bold text-primary">₨ @Model.GrandTotalBalance.ToString("N0")</div>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary p-2 fs-6">
                        <i class="bi bi-wallet2"></i>
                    </span>
                </div>
                <div class="small text-muted mt-1">@Model.TotalInvoicesCount Invoices Pending</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 border-start border-success border-4 p-3 bg-white">
                <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">0 - 30 Days</div>
                <div class="fs-6 fw-bold text-success">₨ @Model.Slab_0_30.ToString("N0")</div>
                <div class="small text-muted">Current Bills</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 border-start border-info border-4 p-3 bg-white">
                <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">31 - 60 Days</div>
                <div class="fs-6 fw-bold text-info">₨ @Model.Slab_31_60.ToString("N0")</div>
                <div class="small text-muted">Mild Overdue</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 bg-white">
                <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">61 - 90 Days</div>
                <div class="fs-6 fw-bold text-warning">₨ @Model.Slab_61_90.ToString("N0")</div>
                <div class="small text-muted">Moderate Risk</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 p-3 bg-white">
                <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem;">90+ Days (High Risk)</div>
                <div class="fs-6 fw-bold text-danger">₨ @((Model.Slab_91_120 + Model.Slab_120_Plus).ToString("N0"))</div>
                <div class="small text-danger fw-semibold">Action Required</div>
            </div>
        </div>
    </div>

    @if (!isDetailView)
    {
        <!-- ======================================================= -->
        <!-- VIEW 1: INDEX / STOCK-STYLE SUMMARY TABLE               -->
        <!-- ======================================================= -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="summaryTable">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 px-4 py-3">Customer / Buyer Name</th>
                                <th class="border-0 px-3 py-3">Broker / Group</th>
                                <th class="border-0 px-3 py-3 text-center">Invoices</th>
                                <th class="border-0 px-3 py-3 text-end">0 - 30 Days</th>
                                <th class="border-0 px-3 py-3 text-end">31 - 60 Days</th>
                                <th class="border-0 px-3 py-3 text-end">61 - 90 Days</th>
                                <th class="border-0 px-3 py-3 text-end">90+ Days</th>
                                <th class="border-0 px-4 py-3 text-end">Total Balance</th>
                                <th class="border-0 px-4 py-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CustomerSummaries.Any())
                            {
                                @foreach (var item in Model.CustomerSummaries)
                                {
                                    <tr class="searchable-row">
                                        <td class="px-4 py-3">
                                            <a href="/Reports/CustomerAging?CustomerId=@item.CustomerId&AsOfDate=@Model.AsOfDate?.ToString("yyyy-MM-dd")&UnClearedOnly=@Model.UnClearedOnly" 
                                               class="fw-bold text-primary text-decoration-none">
                                                @item.CustomerName
                                            </a>
                                            @if (!string.IsNullOrEmpty(item.City))
                                            {
                                                <div class="small text-muted" style="font-size: 11px;">@item.City</div>
                                            }
                                        </td>
                                        <td class="px-3 py-3">
                                            <span class="badge bg-light text-dark border">@item.BrokerName</span>
                                        </td>
                                        <td class="px-3 py-3 text-center">
                                            <span class="badge bg-secondary rounded-pill">@item.InvoicesCount</span>
                                        </td>
                                        <td class="px-3 py-3 text-end text-success fw-medium">
                                            @(item.Slab0_30 > 0 ? item.Slab0_30.ToString("N0") : "-")
                                        </td>
                                        <td class="px-3 py-3 text-end text-info fw-medium">
                                            @(item.Slab31_60 > 0 ? item.Slab31_60.ToString("N0") : "-")
                                        </td>
                                        <td class="px-3 py-3 text-end text-warning fw-medium">
                                            @(item.Slab61_90 > 0 ? item.Slab61_90.ToString("N0") : "-")
                                        </td>
                                        <td class="px-3 py-3 text-end text-danger fw-bold">
                                            @(item.Slab90Plus > 0 ? item.Slab90Plus.ToString("N0") : "-")
                                        </td>
                                        <td class="px-4 py-3 text-end">
                                            <span class="fw-bold text-dark fs-6">₨ @item.TotalBalance.ToString("N2")</span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <a href="/Reports/CustomerAging?CustomerId=@item.CustomerId&AsOfDate=@Model.AsOfDate?.ToString("yyyy-MM-dd")&UnClearedOnly=@Model.UnClearedOnly" 
                                               class="btn btn-sm text-primary border-0 p-1" style="border: none !important; background: transparent;" title="View Detailed Statement">
                                                <i class="bi bi-eye fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5">
                                        <div class="py-4">
                                            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3 text-muted">No Customer Receivables Found</h5>
                                            <p class="text-muted">All customer invoices are cleared or no records match your filter.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ======================================================= -->
        <!-- VIEW 2: DETAILED SODA / INVOICE STATEMENT (EXACT PDF)   -->
        <!-- ======================================================= -->
        <div class="card shadow-sm">
            <div class="card-body p-3">
                
                <!-- Standard Header matching PDF -->
                <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-3">
                    <div style="font-size: 11px; font-weight: 600;">
                        @(Model.UnClearedOnly ? "UnCleared Bills Only" : "All Bills")
                    </div>
                    <div class="text-center flex-grow-1">
                        <h5 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 1px;">@Model.CompanyName</h5>
                        <div class="fw-bold text-uppercase" style="font-size: 13px;">
                            AGING REPORT {(RECEIVABLES ONLY) UPTO @Model.AsOfDate?.ToString("dd/MM/yyyy")}
                        </div>
                    </div>
                    <div class="text-end" style="font-size: 10px; line-height: 1.3;">
                        <div><strong>Date & Time :</strong> @Model.GeneratedOn.ToString("dd/MM/yy hh:mm tt")</div>
                        <div><strong>User :</strong> @Model.UserName</div>
                        <div><strong>Page :</strong> 1 of 1</div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="aging-table table-hover mb-0" id="detailTable">
                        <thead>
                            <tr>
                                <th style="width: 7%;">TRANSACTION NUMBER</th>
                                <th style="width: 6%;">DATE</th>
                                <th style="width: 7%;">CONTRACT NUMBER</th>
                                <th style="width: 6%;">INVOICE NUMBER</th>
                                <th style="width: 5%;" class="text-end">QTY</th>
                                <th style="width: 21%;" class="text-start">DESCRIPTION</th>
                                <th style="width: 6%;" class="text-end">RATE</th>
                                <th style="width: 8%;" class="text-end">AMOUNT</th>
                                <th style="width: 8%;" class="text-end">RECEIVED / PAID</th>
                                <th style="width: 8%;" class="text-end">BALANCE</th>
                                <th style="width: 4%;">CONT. DAYS</th>
                                <th style="width: 4%;">TOTAL DAYS</th>
                                <th style="width: 6%;" class="text-end">PDC AMOUNT</th>
                                <th style="width: 5%;">PDC DT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.GroupedReport.Any())
                            {
                                @foreach (var broker in Model.GroupedReport)
                                {
                                    <tr class="broker-header-row">
                                        <td colspan="14" class="px-3 py-2">
                                            <i class="bi bi-person-badge me-1 no-print"></i> @broker.BrokerName
                                        </td>
                                    </tr>

                                    @foreach (var buyer in broker.Buyers)
                                    {
                                        <tr class="buyer-header-row">
                                            <td colspan="14" class="px-3 py-1">
                                                @buyer.BuyerName
                                            </td>
                                        </tr>

                                        @foreach (var item in buyer.Items)
                                        {
                                            <tr class="searchable-row">
                                                <td class="text-center font-monospace">@item.TransactionNumber</td>
                                                <td class="text-center">@item.Date?.ToString("dd/MM/yy")</td>
                                                <td class="text-center font-monospace">
                                                    <span class="badge bg-light text-dark border">@item.ContractNumber</span>
                                                </td>
                                                <td class="text-center fw-semibold">
                                                    <a href="/Sales/Entry?id=@item.EntryId" class="text-decoration-none text-dark">
                                                        @item.InvoiceNumber
                                                    </a>
                                                </td>
                                                <td class="text-end">@item.Qty.ToString("N2")</td>
                                                <td class="text-start" style="font-size: 10px;">@item.Description</td>
                                                <td class="text-end">@item.Rate.ToString("N2")</td>
                                                <td class="text-end fw-semibold">@item.Amount.ToString("N2")</td>
                                                <td class="text-end text-muted">
                                                    @(item.ReceivedPaid > 0 ? $"({item.ReceivedPaid:N2})" : "")
                                                </td>
                                                <td class="text-end fw-bold text-dark">@item.Balance.ToString("N2")</td>
                                                <td class="text-center">@item.ContDays</td>
                                                <td class="text-center @(item.TotalDays > 60 ? "text-danger fw-bold" : "")">@item.TotalDays</td>
                                                <td class="text-end">@(item.PdcAmount > 0 ? item.PdcAmount.ToString("N2") : "")</td>
                                                <td class="text-center">@item.PdcDate?.ToString("dd/MM/yy")</td>
                                            </tr>
                                        }

                                        <!-- Buyer Subtotal -->
                                        <tr class="buyer-subtotal-row">
                                            <td colspan="7" class="text-end pe-3">
                                                <strong>BUYER WISE SUB - TOTAL :</strong>
                                            </td>
                                            <td class="text-end fw-bold">@buyer.SubTotalAmount.ToString("N2")</td>
                                            <td class="text-end fw-bold">
                                                @(buyer.SubTotalReceived > 0 ? $"({buyer.SubTotalReceived:N2})" : "0.00")
                                            </td>
                                            <td class="text-end fw-bold text-dark">@buyer.SubTotalBalance.ToString("N2")</td>
                                            <td colspan="2"></td>
                                            <td class="text-end fw-bold">@buyer.SubTotalPdc.ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    }

                                    <!-- Broker Subtotal -->
                                    <tr class="broker-subtotal-row">
                                        <td colspan="7" class="text-end pe-3">
                                            <strong>SUB - TOTAL OF SELLER / BROKER :</strong>
                                        </td>
                                        <td class="text-end fw-bold">@broker.SubTotalAmount.ToString("N2")</td>
                                        <td class="text-end fw-bold">
                                            @(broker.SubTotalReceived > 0 ? $"({broker.SubTotalReceived:N2})" : "0.00")
                                        </td>
                                        <td class="text-end fw-bold text-dark">@broker.SubTotalBalance.ToString("N2")</td>
                                        <td colspan="4"></td>
                                    </tr>
                                }

                                <!-- Final Grand Total -->
                                <tr>
                                    <td colspan="9" class="text-end pe-3 py-3 border-0">
                                        <strong style="font-size: 14px;">GRAND - TOTAL :</strong>
                                    </td>
                                    <td class="text-end py-3 border-0">
                                        <div class="grand-total-box">
                                            @Model.GrandTotalBalance.ToString("N2")
                                        </div>
                                    </td>
                                    <td colspan="4" class="border-0"></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="14" class="text-center py-5">
                                        <div class="py-4">
                                            <i class="bi bi-file-earmark-check text-muted" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3 text-muted">No Invoices Found</h5>
                                            <p class="text-muted">No records match the selected customer / SODA filter.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input = document.getElementById("agingSearch");
            var filter = input.value.toUpperCase();
            var rows = document.getElementsByClassName("searchable-row");

            for (var i = 0; i < rows.length; i++) {
                var rowText = rows[i].textContent || rows[i].innerText;
                if (rowText.toUpperCase().indexOf(filter) > -1) {
                    rows[i].style.display = "";
                } else {
                    rows[i].style.display = "none";
                }
            }
        }
    </script>
}
