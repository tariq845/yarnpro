@page "{id:long}"
@model YIS.Pages.Reports.PsdRecordTrackModel
@{
    ViewData["Title"] = "Contract Purchase Movement - PSD-" + Model.PsdHeader?.EntryNumber;
}

<style>
    /* Clean, Professional Report Styling */
    .movement-report {
        background-color: #ffffff;
        color: #212529;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .report-sheet {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 24px;
        margin-bottom: 25px;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.86rem;
    }

    .report-table th {
        background-color: #f1f3f5;
        color: #343a40;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.76rem;
        letter-spacing: 0.5px;
        padding: 8px 10px;
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }

    .report-table td {
        padding: 7px 10px;
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }

    .report-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .section-heading {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0d6efd;
        border-bottom: 2px solid #0d6efd;
        padding-bottom: 4px;
        margin-top: 20px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info-table {
        width: 100%;
        margin-bottom: 15px;
        font-size: 0.88rem;
        border-collapse: collapse;
    }

    .info-table td {
        padding: 6px 12px;
        border: 1px solid #e9ecef;
    }

    .info-table .label {
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
        width: 18%;
    }

    .info-table .value {
        width: 32%;
        color: #111827;
    }

    .summary-matrix th {
        background-color: #e9ecef;
        font-size: 0.8rem;
    }

    .summary-matrix td {
        font-size: 0.88rem;
    }

    .text-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    @@page {
        size: A4 portrait;
        margin: 0;
    }

    @@media print {
        /* 1. Complete suppression of application layout & non-print chrome */
        .sidebar, .sidebar-overlay, .navbar, nav, header, footer,
        .breadcrumb-container, .page-title-main, .impersonation-bar,
        #toast-container, .no-print, .action-bar,
        .dashboard-wrapper > .sidebar,
        .main-content > .navbar,
        .main-content > .content-wrapper > .page-title-main,
        .main-content > .content-wrapper > .breadcrumb-container {
            display: none !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* 2. Reset containers to full page without padding/margins */
        body, html {
            background-color: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .dashboard-wrapper, .main-content, .content-wrapper, .container-fluid, .movement-report {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            background: transparent !important;
            box-shadow: none !important;
            border: none !important;
        }

        .report-sheet {
            border: none !important;
            padding: 10mm 8mm !important;
            margin: 0 !important;
            box-shadow: none !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        /* 3. Fix tables splitting over multiple pages */
        .table-responsive {
            overflow: visible !important;
            display: block !important;
        }

        table.report-table {
            page-break-inside: auto !important;
            break-inside: auto !important;
            width: 100% !important;
        }

        table.report-table thead {
            display: table-header-group !important; /* Repeats table header on next page */
        }

        table.report-table tfoot {
            display: table-footer-group !important;
        }

        table.report-table tr {
            page-break-inside: avoid !important; /* Prevents splitting a single row across pages */
            break-inside: avoid !important;
        }

        .section-heading {
            page-break-after: avoid !important; /* Keeps heading together with its table */
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .report-table th {
            background-color: #f1f3f5 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .info-table .label {
            background-color: #f8f9fa !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .signature-section {
            page-break-inside: avoid !important;
        }

        a, a:link, a:visited, a:hover, a:active {
            text-decoration: none !important;
            color: inherit !important;
        }

        a[href]:after, a[href]::after {
            content: none !important;
            display: none !important;
        }
    }
</style>

<div class="container-fluid px-4 py-3 movement-report">
    <!-- Top Action Bar (No-Print) -->
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <div>
            <a href="/Reports/PsdTrackIndex" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Contract List
            </a>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print Movement Statement
            </button>
        </div>
    </div>

    <!-- Printable Statement Container -->
    <div class="report-sheet shadow-sm" id="printableReport">
        <!-- Header -->
        <div class="border-bottom pb-3 mb-3">
            <div class="row align-items-center">
                <div class="col-8">
                    <h3 class="fw-bold mb-0 text-dark">@Model.CompanyName</h3>
                    @if (!string.IsNullOrEmpty(Model.OwnerName))
                    {
                        <div class="text-muted small mt-1">Owner / Proprietor: <strong class="text-dark">@Model.OwnerName</strong></div>
                    }
                    <h5 class="text-primary fw-semibold mb-0 mt-1">CONTRACT PURCHASE MOVEMENT</h5>
                    <small class="text-muted">Lifecycle Tracking & Inventory Realization Statement</small>
                </div>
                <div class="col-4 text-end">
                    <div class="fs-5 fw-bold text-dark">PSD-@Model.PsdHeader?.EntryNumber</div>
                    <div class="my-1">
                        <span class="badge @(Model.IsCommissionBased ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") px-2 py-1">
                            @Model.ContractBasis
                        </span>
                    </div>
                    <div class="text-muted small">Date: @Model.PsdHeader?.EntryDate?.ToString("dd-MM-yyyy")</div>
                    <div class="text-muted small">Generated: @DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")</div>
                </div>
            </div>
        </div>

        <!-- 1. Contract Header Info -->
        <table class="info-table">
            <tr>
                <td class="label">Contract (PSD) #:</td>
                <td class="value fw-bold text-primary">PSD-@Model.PsdHeader?.EntryNumber</td>
                <td class="label">Contract Date:</td>
                <td class="value">@Model.PsdHeader?.EntryDate?.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td class="label">Supplier Name:</td>
                <td class="value fw-bold">@Model.SupplierName</td>
                <td class="label">System Ref ID:</td>
                <td class="value">#@Model.PsdHeader?.EntryId</td>
            </tr>
            <tr>
                <td class="label">Payment Terms:</td>
                <td class="value fw-semibold text-dark">
                    @(Model.TermsDays.HasValue && Model.TermsDays > 0 ? $"{Model.TermsDays} Days" : "Immediate / Cash")
                </td>
                <td class="label">Payment Mode:</td>
                <td class="value">@(string.IsNullOrEmpty(Model.PaymentMode) ? "Credit" : Model.PaymentMode)</td>
            </tr>
            <tr>
                <td class="label">Contract Basis:</td>
                <td class="value fw-bold @(Model.IsCommissionBased ? "text-primary" : "text-dark")">
                    @Model.ContractBasis
                </td>
                <td class="label">Commission Details:</td>
                <td class="value">
                    @if (Model.IsCommissionBased)
                    {
                        <span class="fw-semibold text-dark">
                            Commission Based
                            @if (Model.PsdHeader?.EntryCommPer.HasValue == true && Model.PsdHeader.EntryCommPer > 0)
                            {
                                <span>(@Model.PsdHeader.EntryCommPer.Value.ToString("0.##")%)</span>
                            }
                            @if (Model.PsdHeader?.EntryCommAmt.HasValue == true && Model.PsdHeader.EntryCommAmt > 0)
                            {
                                <span>- PKR @Model.PsdHeader.EntryCommAmt.Value.ToString("N2")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PsdHeader?.EntryAttribute4))
                            {
                                <span class="text-muted">| Agent: @Model.PsdHeader.EntryAttribute4</span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="fw-semibold text-secondary">Net Based</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="label">Owner / Signatory:</td>
                <td class="value fw-bold text-dark">@(string.IsNullOrEmpty(Model.OwnerName) ? "-" : Model.OwnerName)</td>
                <td class="label">Remarks / Notes:</td>
                <td class="value">@(string.IsNullOrEmpty(Model.PsdHeader?.EntryRemarks) ? "-" : Model.PsdHeader?.EntryRemarks)</td>
            </tr>
        </table>

        <!-- 2. PSD Contract Booked Items -->
        <div class="section-heading">
            <span>1. CONTRACT DETAILS (PSD BOOKING)</span>
            <span class="fs-6 text-muted">Total Items: @Model.ContractItems.Count</span>
        </div>
        <table class="report-table mb-3">
            <thead>
                <tr>
                    <th class="text-center" style="width: 40px;">#</th>
                    <th>Item Description</th>
                    <th class="text-num" style="width: 120px;">Contract Qty (Bags)</th>
                    <th class="text-num" style="width: 120px;">Total LBS</th>
                    <th class="text-num" style="width: 110px;">Rate</th>
                    <th class="text-num" style="width: 130px;">Amount</th>
                    <th class="text-num" style="width: 110px;">Sales Tax</th>
                    <th class="text-num" style="width: 140px;">Net Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int cIdx = 1;
                    double sumCQty = 0, sumCLbs = 0, sumCAmt = 0, sumCTax = 0, sumCNet = 0;
                }
                @foreach (var c in Model.ContractItems)
                {
                    sumCQty += c.Qty;
                    sumCLbs += c.Lbs;
                    sumCAmt += c.Amount;
                    sumCTax += c.TaxAmount;
                    sumCNet += c.NetAmount;

                    <tr>
                        <td class="text-center text-muted">@cIdx</td>
                        <td class="fw-semibold">@c.ItemName</td>
                        <td class="text-num fw-bold">@c.Qty.ToString("N2")</td>
                        <td class="text-num">@c.Lbs.ToString("N2")</td>
                        <td class="text-num">@c.Rate.ToString("F4")</td>
                        <td class="text-num">@c.Amount.ToString("N2")</td>
                        <td class="text-num text-muted">@c.TaxAmount.ToString("N2")</td>
                        <td class="text-num fw-bold text-dark">@c.NetAmount.ToString("N2")</td>
                    </tr>
                    cIdx++;
                }
                <tr class="table-light fw-bold border-top border-2">
                    <td colspan="2" class="text-uppercase text-center">Total Contract</td>
                    <td class="text-num">@sumCQty.ToString("N2")</td>
                    <td class="text-num">@sumCLbs.ToString("N2")</td>
                    <td class="text-num">@((sumCLbs > 0 ? (sumCAmt / (sumCLbs / 10.0)) : (sumCQty > 0 ? sumCAmt / sumCQty : 0)).ToString("F4"))</td>
                    <td class="text-num">@sumCAmt.ToString("N2")</td>
                    <td class="text-num">@sumCTax.ToString("N2")</td>
                    <td class="text-num text-primary">@sumCNet.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- 3. Purchases Realized against this PSD -->
        <div class="section-heading">
            <span>2. PURCHASES RECEIVED AGAINST CONTRACT (PUR RECEIPTS)</span>
            <span class="fs-6 text-muted">Receipts Count: @Model.PurchaseItems.Count</span>
        </div>
        @if (Model.PurchaseItems.Any())
        {
            <table class="report-table mb-3">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;">#</th>
                        <th style="width: 100px;">PUR #</th>
                        <th style="width: 100px;">Date</th>
                        <th>Item Description</th>
                        <th style="width: 125px;">Basis</th>
                        <th>Remarks / DC Ref</th>
                        <th class="text-num" style="width: 110px;">Received Qty</th>
                        <th class="text-num" style="width: 110px;">Received LBS</th>
                        <th class="text-num" style="width: 100px;">Rate</th>
                        <th class="text-num" style="width: 120px;">Amount</th>
                        <th class="text-num" style="width: 100px;">Sales Tax</th>
                        <th class="text-num" style="width: 130px;">Net Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int pIdx = 1;
                        double sumPQty = 0, sumPLbs = 0, sumPAmt = 0, sumPTax = 0, sumPNet = 0;
                    }
                    @foreach (var p in Model.PurchaseItems)
                    {
                        sumPQty += p.Qty;
                        sumPLbs += p.Lbs;
                        sumPAmt += p.Amount;
                        sumPTax += p.TaxAmount;
                        sumPNet += p.NetAmount;

                        <tr>
                            <td class="text-center text-muted">@pIdx</td>
                            <td class="fw-bold">
                                <a href="/Purchase/Entry?id=@p.PurId" class="text-decoration-none text-primary d-print-none" target="_blank">
                                    PUR-@p.PurNumber
                                </a>
                                <span class="d-none d-print-inline text-dark">PUR-@p.PurNumber</span>
                            </td>
                            <td>@p.PurDate?.ToString("dd-MM-yyyy")</td>
                            <td class="fw-semibold">@p.ItemName</td>
                            <td class="small fw-semibold @(p.IsCommissionBased ? "text-primary" : "text-secondary")">@p.BasisText</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(p.Remarks) ? "-" : p.Remarks)</td>
                            <td class="text-num fw-bold text-primary">@p.Qty.ToString("N2")</td>
                            <td class="text-num">@p.Lbs.ToString("N2")</td>
                            <td class="text-num">@p.Rate.ToString("F4")</td>
                            <td class="text-num">@p.Amount.ToString("N2")</td>
                            <td class="text-num text-muted">@p.TaxAmount.ToString("N2")</td>
                            <td class="text-num fw-bold">@p.NetAmount.ToString("N2")</td>
                        </tr>
                        pIdx++;
                    }
                    <tr class="table-light fw-bold border-top border-2">
                        <td colspan="6" class="text-uppercase text-center">Total Received</td>
                        <td class="text-num text-primary">@sumPQty.ToString("N2")</td>
                        <td class="text-num">@sumPLbs.ToString("N2")</td>
                        <td class="text-num">@((sumPLbs > 0 ? (sumPAmt / (sumPLbs / 10.0)) : (sumPQty > 0 ? sumPAmt / sumPQty : 0)).ToString("F4"))</td>
                        <td class="text-num">@sumPAmt.ToString("N2")</td>
                        <td class="text-num">@sumPTax.ToString("N2")</td>
                        <td class="text-num text-primary">@sumPNet.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-light border text-muted py-2 px-3 small mb-3">
                <i class="bi bi-info-circle me-1"></i>No purchases received yet against this contract.
            </div>
        }

        <!-- 4. Sales Soda (SSD) Booked against this PSD -->
        <div class="section-heading">
            <span>3. SALES SODA (SSD) BOOKED AGAINST CONTRACT</span>
            <span class="fs-6 text-muted">Soda Count: @Model.SalesSodaItems.Count</span>
        </div>
        @if (Model.SalesSodaItems.Any())
        {
            <table class="report-table mb-3">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;">#</th>
                        <th style="width: 100px;">SSD #</th>
                        <th style="width: 100px;">Date</th>
                        <th>Customer Name</th>
                        <th>Item Description</th>
                        <th style="width: 125px;">Basis</th>
                        <th class="text-num" style="width: 110px;">Soda Qty</th>
                        <th class="text-num" style="width: 110px;">Soda LBS</th>
                        <th class="text-num" style="width: 100px;">Sale Rate</th>
                        <th class="text-num" style="width: 120px;">Amount</th>
                        <th class="text-num" style="width: 100px;">Sales Tax</th>
                        <th class="text-num" style="width: 130px;">Net Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sIdx = 1;
                        double sumSQty = 0, sumSLbs = 0, sumSAmt = 0, sumSTax = 0, sumSNet = 0;
                    }
                    @foreach (var s in Model.SalesSodaItems)
                    {
                        sumSQty += s.Qty;
                        sumSLbs += s.Lbs;
                        sumSAmt += s.Amount;
                        sumSTax += s.TaxAmount;
                        sumSNet += s.NetAmount;

                        <tr>
                            <td class="text-center text-muted">@sIdx</td>
                            <td class="fw-bold">
                                <a href="/Sales/Soda?id=@s.SsdId" class="text-decoration-none text-success d-print-none" target="_blank">
                                    SSD-@s.SsdNumber
                                </a>
                                <span class="d-none d-print-inline text-dark">SSD-@s.SsdNumber</span>
                            </td>
                            <td>@s.SsdDate?.ToString("dd-MM-yyyy")</td>
                            <td class="fw-semibold">@s.CustomerName</td>
                            <td>@s.ItemName</td>
                            <td class="small fw-semibold @(s.IsCommissionBased ? "text-success" : "text-secondary")">@s.BasisText</td>
                            <td class="text-num fw-bold text-success">@s.Qty.ToString("N2")</td>
                            <td class="text-num">@s.Lbs.ToString("N2")</td>
                            <td class="text-num">@s.Rate.ToString("F4")</td>
                            <td class="text-num">@s.Amount.ToString("N2")</td>
                            <td class="text-num text-muted">@s.TaxAmount.ToString("N2")</td>
                            <td class="text-num fw-bold">@s.NetAmount.ToString("N2")</td>
                        </tr>
                        sIdx++;
                    }
                    <tr class="table-light fw-bold border-top border-2">
                        <td colspan="6" class="text-uppercase text-center">Total Sales Soda</td>
                        <td class="text-num text-success">@sumSQty.ToString("N2")</td>
                        <td class="text-num">@sumSLbs.ToString("N2")</td>
                        <td class="text-num">@((sumSLbs > 0 ? (sumSAmt / (sumSLbs / 10.0)) : (sumSQty > 0 ? sumSAmt / sumSQty : 0)).ToString("F4"))</td>
                        <td class="text-num">@sumSAmt.ToString("N2")</td>
                        <td class="text-num">@sumSTax.ToString("N2")</td>
                        <td class="text-num text-success">@sumSNet.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-light border text-muted py-2 px-3 small mb-3">
                <i class="bi bi-info-circle me-1"></i>No sales sodas booked against this contract yet.
            </div>
        }

        <!-- 5. Sales Invoices Delivered (SAL) -->
        <div class="section-heading">
            <span>4. SALES INVOICES DELIVERED (SAL)</span>
            <span class="fs-6 text-muted">Invoices Count: @Model.SalesInvoiceItems.Count</span>
        </div>
        @if (Model.SalesInvoiceItems.Any())
        {
            <table class="report-table mb-3">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;">#</th>
                        <th style="width: 100px;">SAL #</th>
                        <th style="width: 100px;">Date</th>
                        <th style="width: 90px;">SSD Ref</th>
                        <th>Customer Name</th>
                        <th>Item Description</th>
                        <th style="width: 125px;">Basis</th>
                        <th class="text-num" style="width: 110px;">Delivered Qty</th>
                        <th class="text-num" style="width: 110px;">Delivered LBS</th>
                        <th class="text-num" style="width: 100px;">Rate</th>
                        <th class="text-num" style="width: 120px;">Amount</th>
                        <th class="text-num" style="width: 100px;">Sales Tax</th>
                        <th class="text-num" style="width: 130px;">Net Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int salIdx = 1;
                        double sumSalQty = 0, sumSalLbs = 0, sumSalAmt = 0, sumSalTax = 0, sumSalNet = 0;
                    }
                    @foreach (var sal in Model.SalesInvoiceItems)
                    {
                        sumSalQty += sal.Qty;
                        sumSalLbs += sal.Lbs;
                        sumSalAmt += sal.Amount;
                        sumSalTax += sal.TaxAmount;
                        sumSalNet += sal.NetAmount;

                        <tr>
                            <td class="text-center text-muted">@salIdx</td>
                            <td class="fw-bold">
                                <a href="/Sales/Entry?id=@sal.SalId" class="text-decoration-none text-dark d-print-none" target="_blank">
                                    SAL-@sal.SalNumber
                                </a>
                                <span class="d-none d-print-inline text-dark">SAL-@sal.SalNumber</span>
                            </td>
                            <td>@sal.SalDate?.ToString("dd-MM-yyyy")</td>
                            <td class="text-muted">@(sal.RefSsdNumber.HasValue ? $"SSD-{sal.RefSsdNumber}" : "-")</td>
                            <td class="fw-semibold">@sal.CustomerName</td>
                            <td>@sal.ItemName</td>
                            <td class="small fw-semibold @(sal.IsCommissionBased ? "text-primary" : "text-secondary")">@sal.BasisText</td>
                            <td class="text-num fw-bold">@sal.Qty.ToString("N2")</td>
                            <td class="text-num">@sal.Lbs.ToString("N2")</td>
                            <td class="text-num">@sal.Rate.ToString("F4")</td>
                            <td class="text-num">@sal.Amount.ToString("N2")</td>
                            <td class="text-num text-muted">@sal.TaxAmount.ToString("N2")</td>
                            <td class="text-num fw-bold">@sal.NetAmount.ToString("N2")</td>
                        </tr>
                        salIdx++;
                    }
                    <tr class="table-light fw-bold border-top border-2">
                        <td colspan="7" class="text-uppercase text-center">Total Delivered</td>
                        <td class="text-num">@sumSalQty.ToString("N2")</td>
                        <td class="text-num">@sumSalLbs.ToString("N2")</td>
                        <td class="text-num">@((sumSalLbs > 0 ? (sumSalAmt / (sumSalLbs / 10.0)) : (sumSalQty > 0 ? sumSalAmt / sumSalQty : 0)).ToString("F4"))</td>
                        <td class="text-num">@sumSalAmt.ToString("N2")</td>
                        <td class="text-num">@sumSalTax.ToString("N2")</td>
                        <td class="text-num">@sumSalNet.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-light border text-muted py-2 px-3 small mb-3">
                <i class="bi bi-info-circle me-1"></i>No sales invoices delivered against this contract yet.
            </div>
        }

        <!-- 6. Movement & Balance Summary Ledger (Clean Tabular Matrix, No Cards) -->
        <div class="section-heading">
            <span>5. MOVEMENT & BALANCE SUMMARY LEDGER</span>
            <span class="fs-6 text-muted">Realization & Stock Position</span>
        </div>
        <table class="report-table summary-matrix mb-4">
            <thead>
                <tr>
                    <th style="width: 35%;">Movement Stage / Description</th>
                    <th class="text-num" style="width: 15%;">Quantity (Bags)</th>
                    <th class="text-num" style="width: 15%;">Weight (LBS)</th>
                    <th class="text-num" style="width: 15%;">Avg Rate / Unit</th>
                    <th class="text-num" style="width: 20%;">Total Amount (PKR)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold text-dark">A. Contract Booked (PSD)</td>
                    <td class="text-num fw-bold">@Model.Summary.ContractQty.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.ContractLbs.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.ContractAvgRate.ToString("F4")</td>
                    <td class="text-num fw-bold">@Model.Summary.ContractAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="fw-bold text-primary">B. Purchases Received (PUR)</td>
                    <td class="text-num fw-bold text-primary">@Model.Summary.PurchasedQty.ToString("N2")</td>
                    <td class="text-num text-primary">@Model.Summary.PurchasedLbs.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.PurchasedAvgRate.ToString("F4")</td>
                    <td class="text-num fw-bold text-primary">@Model.Summary.PurchasedAmount.ToString("N2")</td>
                </tr>
                <tr class="table-warning">
                    <td class="fw-bold text-danger">C. Contract Pending Balance (A - B)</td>
                    <td class="text-num fw-bold text-danger">@Model.Summary.PendingContractQty.ToString("N2")</td>
                    <td class="text-num text-danger">@Model.Summary.PendingContractLbs.ToString("N2")</td>
                    <td class="text-num">-</td>
                    <td class="text-num fw-bold text-danger">@Model.Summary.PendingContractAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="fw-bold text-success">D. Sales Soda Booked (SSD)</td>
                    <td class="text-num fw-bold text-success">@Model.Summary.SsdQty.ToString("N2")</td>
                    <td class="text-num text-success">@Model.Summary.SsdLbs.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.SsdAvgRate.ToString("F4")</td>
                    <td class="text-num fw-bold text-success">@Model.Summary.SsdAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="fw-bold text-dark">E. Sales Invoices Delivered (SAL)</td>
                    <td class="text-num fw-bold">@Model.Summary.SalQty.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.SalLbs.ToString("N2")</td>
                    <td class="text-num">@Model.Summary.SalAvgRate.ToString("F4")</td>
                    <td class="text-num fw-bold">@Model.Summary.SalAmount.ToString("N2")</td>
                </tr>
                <tr class="table-light border-top border-2">
                    <td class="fw-bold text-dark">F. Physical Stock in Hand (B - E)</td>
                    <td class="text-num fw-bold text-dark">@Model.Summary.StockQty.ToString("N2")</td>
                    <td class="text-num text-dark">@Model.Summary.StockLbs.ToString("N2")</td>
                    <td class="text-num">-</td>
                    <td class="text-num text-muted">-</td>
                </tr>
                <tr class="table-light">
                    <td class="fw-bold text-dark">G. Uncommitted Contract Balance (A - D)</td>
                    <td class="text-num fw-bold text-dark">@Model.Summary.UnsoldContractQty.ToString("N2")</td>
                    <td class="text-num text-dark">@Model.Summary.UnsoldContractLbs.ToString("N2")</td>
                    <td class="text-num">-</td>
                    <td class="text-num text-muted">-</td>
                </tr>
            </tbody>
        </table>

        <!-- Signatures for Official Movement Statement -->
        <div class="signature-section row pt-5 mt-4 text-center">
            <div class="col-4">
                <div class="border-top border-dark pt-1 small fw-semibold">Prepared By</div>
            </div>
            <div class="col-4">
                <div class="border-top border-dark pt-1 small fw-semibold">Checked By</div>
            </div>
            <div class="col-4">
                <div class="border-top border-dark pt-1 small fw-semibold">Authorized Signature</div>
                @if (!string.IsNullOrEmpty(Model.OwnerName))
                {
                    <div class="small fw-bold text-dark mt-1">@Model.OwnerName</div>
                }
            </div>
        </div>
    </div>
</div>
