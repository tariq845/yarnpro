@page
@model YIS.Pages.Ledger.SupplierLedgerModel
@{
    ViewData["Title"] = "Supplier Ledger";
}

@section Styles {
        <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
        <style>
            .ts-control {
                border-radius: 0.375rem !important;
            }
        </style>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Supplier</label>
                    <select asp-for="SupplierId" class="form-select" id="supplier-select"
                        asp-items="@(new SelectList(Model.Suppliers, "SupplierId", "SupplierName"))">
                        <option value="">-- Select Supplier --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="StartDate" class="form-control"
                        value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <input type="date" name="EndDate" class="form-control"
                        value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                    @if (Model.SupplierId.HasValue)
                    {
                            <a asp-page-handler="DownloadExcel" asp-route-SupplierId="@Model.SupplierId"
                                asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-success border-0"
                                title="Export to Excel">
                                <i class="bi bi-file-earmark-excel"></i>
                            </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Transc #</th>
                        <th>Type</th>
                        <th>Supplier</th>
                        <th>Remarks</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody id="ledger-body">
                    <partial name="_SupplierLedgerTableRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                new TomSelect("#supplier-select", {
                    create: false,
                    sortField: {
                        field: "text",
                        direction: "asc"
                    },
                    placeholder: "-- Select Supplier --",
                    allowEmptyOption: true
                });
            });
        </script>
}


