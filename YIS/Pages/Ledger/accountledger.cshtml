@page
@model YIS.Pages.Ledger.AccountLedgerModel
@{
    ViewData["Title"] = "Account Ledger";
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Account (Optional)</label>
                    <select asp-for="AccountId" id="account-select" class="form-select"
                        asp-items="@(new SelectList(Model.Accounts, "AccountId", "AccountName"))">
                        <option value="">-- All Accounts --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="StartDate" class="form-control"
                        value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <input type="date" name="EndDate" class="form-control"
                        value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary px-3 text-nowrap" data-loading-text="Filter" style="min-width: 95px;">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-page-handler="DownloadExcel" asp-route-AccountId="@Model.AccountId"
                        asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                        asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-success border-0 px-3 text-nowrap"
                        title="Export to Excel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Date</th>
                        <th style="width: 110px;">Transc #</th>
                        <th style="width: 70px;">Type</th>
                        <th style="width: 150px;">Account</th>
                        <th>Narration / Details</th>
                        <th class="text-end" style="width: 120px;">Debit</th>
                        <th class="text-end" style="width: 120px;">Credit</th>
                        <th class="text-end" style="width: 130px;">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LedgerRows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                @if (!Model.AccountId.HasValue)
                                {
                                    <span>Please select an account and click <strong>Filter</strong> to view ledger entries.</span>
                                }
                                else
                                {
                                    <span>No transactions found for the selected criteria.</span>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in Model.LedgerRows)
                        {
                            <tr class="@(row.TransNo == "" ? "table-secondary fw-bold" : "")">
                                <td class="text-nowrap">@(row.Date.HasValue ? row.Date.Value.ToString("dd-MM-yyyy") : "")</td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrEmpty(row.TransactionUrl))
                                    {
                                        <a href="@row.TransactionUrl" target="_blank" class="fw-semibold text-primary text-decoration-none" title="Open transaction in new tab">
                                            @row.TransNo <i class="bi bi-box-arrow-up-right small"></i>
                                        </a>
                                        @if (!string.IsNullOrEmpty(row.InvoiceViewUrl))
                                        {
                                            <a href="@row.InvoiceViewUrl" target="_blank" class="badge bg-info bg-opacity-10 text-info border border-info text-decoration-none ms-1" title="View / Print Invoice">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">@row.TransNo</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.Type))
                                    {
                                        <span class="badge bg-light text-dark border">@row.Type</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-medium text-dark">@row.AccountName</span>
                                    @if (!string.IsNullOrEmpty(row.PartyName))
                                    {
                                        <div class="text-muted small">@row.PartyName</div>
                                    }
                                </td>
                                <td>
                                    @if (row.Items != null && row.Items.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var item in row.Items)
                                            {
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <span class="fw-bold text-dark">@item.ItemName</span>
                                                    @if (item.Qty.HasValue && item.Qty > 0)
                                                    {
                                                        <span class="badge bg-light text-dark border"><i class="bi bi-box me-1"></i>@item.Qty?.ToString("N0") Bags</span>
                                                    }
                                                    @if (item.Lbs.HasValue && item.Lbs > 0)
                                                    {
                                                        <span class="badge bg-light text-secondary border">@item.Lbs?.ToString("N2") Lbs</span>
                                                    }
                                                    @if (item.Rate.HasValue && item.Rate > 0)
                                                    {
                                                        <span class="badge bg-light text-success border">Rate: @item.Rate?.ToString("N2")</span>
                                                    }
                                                    @if (item.Amount.HasValue && item.Amount > 0)
                                                    {
                                                        <span class="badge bg-light text-primary border">Amt: @item.Amount?.ToString("N2")</span>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(row.SodaNo))
                                            {
                                                <div class="mt-1">
                                                    <a href="@row.SodaUrl" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none" title="Open Soda Contract in new tab">
                                                        <i class="bi bi-file-earmark-text me-1"></i>Soda: @row.SodaNo <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                                    </a>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(row.OriginalRemarks) && row.OriginalRemarks != "Sales Invoice" && row.OriginalRemarks != "Purchase Invoice")
                                            {
                                                <div class="text-muted small mt-1 fst-italic">@row.OriginalRemarks</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span>@row.Remarks</span>
                                            @if (!string.IsNullOrEmpty(row.SodaNo))
                                            {
                                                <span class="ms-2">
                                                    <a href="@row.SodaUrl" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none" title="Open Soda Contract in new tab">
                                                        <i class="bi bi-file-earmark-text me-1"></i>Soda: @row.SodaNo <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                                    </a>
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-end text-nowrap">@(row.Debit > 0 ? row.Debit.ToString("N2") : "-")</td>
                                <td class="text-end text-nowrap">@(row.Credit > 0 ? row.Credit.ToString("N2") : "-")</td>
                                <td class="text-end text-nowrap fw-bold @(row.Balance >= 0 ? "text-dark" : "text-danger")">@row.Balance.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="5" class="text-end">Totals</td>
                        <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                        <td class="text-end @(Model.ClosingBalance >= 0 ? "text-dark" : "text-danger")">@Model.ClosingBalance.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
