@page
@model YIS.Pages.Dashboard.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .animate-up {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    .animate-scale {
        animation: scaleIn 0.5s ease-out forwards;
    }

    .delay-1 { animation-delay: 0.1s; opacity: 0; }
    .delay-2 { animation-delay: 0.2s; opacity: 0; }
    .delay-3 { animation-delay: 0.3s; opacity: 0; }
    .delay-4 { animation-delay: 0.4s; opacity: 0; }
    .delay-5 { animation-delay: 0.5s; opacity: 0; }

    /* Enhanced Dashboard Styles */
    .dashboard-welcome {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 16px;
        padding: 40px;
        margin-bottom: 32px;
        color: white;
        box-shadow: 0 10px 30px rgba(79, 70, 229, 0.2);
        position: relative;
        overflow: hidden;
    }
    
    .dashboard-welcome::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 350px;
        height: 350px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .dashboard-welcome::after {
        content: '';
        position: absolute;
        bottom: -20%;
        left: 10%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    
    .welcome-content {
        position: relative;
        z-index: 1;
    }
    
    .welcome-title {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }
    
    .welcome-subtitle {
        font-size: 18px;
        opacity: 0.9;
        margin-bottom: 24px;
    }
    
    .welcome-date {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    /* Enhanced Stat Cards */
    .enhanced-stat-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid #f0f2f5;
        position: relative;
        overflow: hidden;
    }

    .enhanced-stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 150px;
        height: 150px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        opacity: 0.05;
        border-radius: 0 20px 0 100%;
        transition: all 0.4s ease;
    }
    
    .enhanced-stat-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        border-color: var(--gradient-start);
    }

    .enhanced-stat-card:hover::before {
        opacity: 0.1;
        width: 200px;
        height: 200px;
    }

    .stat-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }
    
    .stat-icon-enhanced {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        color: white;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        flex-shrink: 0;
    }
    
    .stat-value-enhanced {
        font-size: 28px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
        line-height: 1.2;
    }
    
    .stat-label-enhanced {
        font-size: 13px;
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .stat-trend {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #f3f4f6;
    }
    
    .trend-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        border-radius: 100px;
        font-size: 13px;
        font-weight: 700;
    }
    
    .trend-badge.up {
        background: #ecfdf5;
        color: #059669;
    }
    
    .trend-badge.down {
        background: #fef2f2;
        color: #dc2626;
    }
    
    /* Quick Actions Enhanced */
    .enhanced-quick-action {
        background: white;
        border: 1px solid #f3f4f6;
        border-radius: 20px;
        padding: 24px 16px; /* Adjusted padding */
        transition: all 0.3s ease;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Center content vertically */
        gap: 16px;
        min-height: 140px; /* Uniform height */
    }
    
    .enhanced-quick-action:hover {
        background: #f9fafb;
        border-color: #6366f1;
        transform: scale(1.05);
    }

    .quick-action-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #f3f4f6;
        color: #6366f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px; /* Increased size slightly */
        transition: all 0.3s ease;
        line-height: 0; /* Ensures no extra vertical space */
    }

    .quick-action-icon i {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
    }

    .enhanced-quick-action:hover .quick-action-icon {
        background: #6366f1;
        color: white;
    }
    
    /* Table Enhancements */
    .recent-table th {
        background: #f9fafb;
        padding: 16px 24px;
        font-weight: 700;
        color: #4b5563;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .recent-table td {
        padding: 20px 24px;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
    }

    .recent-table tr:hover {
        background: #f9fafb;
    }

    .type-badge {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .type-sal { background: #eef2ff; color: #4f46e5; }
    .type-pur { background: #fff7ed; color: #c2410c; }
    .type-jv { background: #f5f3ff; color: #7c3aed; }
    .type-rv { background: #f0fdf4; color: #16a34a; }
    .type-pv { background: #fef2f2; color: #dc2626; }

</style>

<div id="main-content">
    <!-- Welcome Banner -->
    <div class="dashboard-welcome animate-up">
        <div class="welcome-content">
            <h1 class="welcome-title">Yarn Pro Control Center �</h1>
            <p class="welcome-subtitle">Here's what's happening with your business today</p>
            <div class="welcome-date">
                <i class="bi bi-calendar3"></i>
                <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>
    
    <!-- Enhanced Stats Grid (Operations & Sales) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <div class="enhanced-stat-card primary animate-up delay-1" style="--gradient-start: #4f46e5; --gradient-end: #7c3aed;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced">PKR @Model.TotalSalesCurrentMonth.ToString("N0")</div>
                    <div class="stat-label-enhanced">Monthly Sales</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge @(Model.SalesTrend >= 0 ? "up" : "down")">
                    <i class="bi bi-arrow-@(Model.SalesTrend >= 0 ? "up" : "down")"></i>
                    @Math.Abs(Model.SalesTrend)%
                </span>
                <span class="trend-text">from last month</span>
            </div>
        </div>

        <div class="enhanced-stat-card animate-up delay-2" style="--gradient-start: #ea580c; --gradient-end: #c2410c;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced">PKR @Model.TotalPurchasesCurrentMonth.ToString("N0")</div>
                    <div class="stat-label-enhanced">Monthly Purchases</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge @(Model.PurchaseTrend >= 0 ? "up" : "down")">
                    <i class="bi bi-arrow-@(Model.PurchaseTrend >= 0 ? "up" : "down")"></i>
                    @Math.Abs(Model.PurchaseTrend)%
                </span>
                <span class="trend-text">from last month</span>
            </div>
        </div>
        
        <div class="enhanced-stat-card success animate-up delay-3" style="--gradient-start: #10b981; --gradient-end: #059669;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced">@Model.TotalOrdersCurrentMonth</div>
                    <div class="stat-label-enhanced">Monthly Invoices</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge @(Model.OrdersTrend >= 0 ? "up" : "down")">
                    <i class="bi bi-arrow-@(Model.OrdersTrend >= 0 ? "up" : "down")"></i>
                    @Math.Abs(Model.OrdersTrend)%
                </span>
                <span class="trend-text">from last month</span>
            </div>
        </div>
        
        <div class="enhanced-stat-card warning animate-up delay-4" style="--gradient-start: #f59e0b; --gradient-end: #d97706;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced">@Model.TotalStockItems.ToString("N0")</div>
                    <div class="stat-label-enhanced">Stock In-Hand (Units)</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge up">
                    <i class="bi bi-check-circle-fill"></i>
                    Real-time
                </span>
                <span class="trend-text"><a href="/Reports/Stock" class="text-decoration-none text-muted">View Stock &rarr;</a></span>
            </div>
        </div>
    </div>

    <!-- Enhanced Stats Grid (Financials & Working Capital) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <a href="/Reports/CustomerAging" class="enhanced-stat-card animate-up delay-2 text-decoration-none" style="--gradient-start: #0284c7; --gradient-end: #0369a1; display: block; color: inherit;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced text-info" style="color: #0284c7 !important;">PKR @Model.TotalReceivables.ToString("N0")</div>
                    <div class="stat-label-enhanced">Customer Receivables (AR)</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge" style="background: #e0f2fe; color: #0369a1;">
                    <i class="bi bi-people-fill"></i> @Model.ActiveCustomersCount Customers
                </span>
                <span class="trend-text text-primary fw-semibold">View Aging &rarr;</span>
            </div>
        </a>

        <a href="/Reports/SupplierAging" class="enhanced-stat-card animate-up delay-3 text-decoration-none" style="--gradient-start: #e11d48; --gradient-end: #be123c; display: block; color: inherit;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced" style="color: #e11d48 !important;">PKR @Model.TotalPayables.ToString("N0")</div>
                    <div class="stat-label-enhanced">Supplier Payables (AP)</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge" style="background: #ffe4e6; color: #be123c;">
                    <i class="bi bi-truck"></i> @Model.ActiveSuppliersCount Suppliers
                </span>
                <span class="trend-text text-danger fw-semibold">View Aging &rarr;</span>
            </div>
        </a>

        <div class="enhanced-stat-card animate-up delay-4" style="--gradient-start: #059669; --gradient-end: #047857;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced text-success">PKR @Model.TotalReceiptsCurrentMonth.ToString("N0")</div>
                    <div class="stat-label-enhanced">Month Collections (RV)</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-arrow-down-left-circle"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge up">
                    <i class="bi bi-arrow-down-left"></i> Inflow
                </span>
                <span class="trend-text">Receipt Vouchers</span>
            </div>
        </div>

        <div class="enhanced-stat-card animate-up delay-5" style="--gradient-start: #6366f1; --gradient-end: #4338ca;">
            <div class="stat-header">
                <div>
                    <div class="stat-value-enhanced" style="color: #4338ca !important;">PKR @Model.TotalPaymentsCurrentMonth.ToString("N0")</div>
                    <div class="stat-label-enhanced">Month Payments (PV)</div>
                </div>
                <div class="stat-icon-enhanced">
                    <i class="bi bi-arrow-up-right-circle"></i>
                </div>
            </div>
            <div class="stat-trend">
                <span class="trend-badge" style="background: #eef2ff; color: #4338ca;">
                    <i class="bi bi-arrow-up-right"></i> Outflow
                </span>
                <span class="trend-text">Payment Vouchers</span>
            </div>
        </div>
    </div>
    
    <!-- Quick Actions Card -->
    <div class="animate-up delay-5" style="background: white; border-radius: 24px; border: 1px solid #f0f2f5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); padding: 28px; margin-bottom: 32px;">
        <h3 style="font-size: 20px; font-weight: 800; color: #111827; margin-bottom: 24px; letter-spacing: -0.5px;">Quick Actions</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 20px;">
            <a href="/Sales/Entry" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">New Sale</span>
            </a>
            <a href="/Purchase/Entry" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-cart-plus"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">New Purchase</span>
            </a>
            <a href="/Vouchers/JournalVoucher" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-journal-plus"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">New JV</span>
            </a>
            <a href="/Customers/Index" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-person-plus"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">Add Customer</span>
            </a>
            <a href="/Suppliers/Index" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-person-fill-add"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">Add Supplier</span>
            </a>
            <a href="/Items/Index" class="enhanced-quick-action">
                <div class="quick-action-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <span class="quick-action-text" style="font-weight: 700; color: #374151;">Manage Items</span>
            </a>
        </div>
    </div>
    
    <!-- Charts and Activity -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">
        <!-- Business Performance Card -->
        <div class="animate-scale" style="background: white; border-radius: 24px; border: 1px solid #f0f2f5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 28px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <div>
                        <h3 style="font-size: 22px; font-weight: 800; color: #111827; letter-spacing: -0.5px; margin-bottom: 4px;">Business Performance</h3>
                        <p style="font-size: 14px; color: #6b7280; font-weight: 500;">Revenue vs Operating Costs Analytics</p>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">Goal: PKR @Model.MonthlyGoal.ToString("N0")</div>
                        <div style="font-size: 18px; font-weight: 800; color: #4f46e5;">@Model.GoalAchievementPercentage% Achieved</div>
                    </div>
                </div>

                <!-- Monthly Goal Tracker -->
                <div style="height: 10px; background: #f3f4f6; border-radius: 5px; margin-bottom: 32px; overflow: hidden; box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);">
                    <div style="width: @Model.GoalAchievementPercentage%; height: 100%; background: linear-gradient(90deg, #4f46e5, #7c3aed); border-radius: 5px; position: relative; transition: width 1.5s cubic-bezier(0.34, 1.56, 0.64, 1);">
                        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent); animation: shimmer 2s infinite;"></div>
                    </div>
                </div>

                <!-- Performance Highlights -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px;">
                    <div style="background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #f1f5f9;">
                        <div style="font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Avg. Order</div>
                        <div style="font-size: 18px; font-weight: 800; color: #1e293b;">PKR @Model.AverageOrderValue.ToString("N0")</div>
                        <div style="font-size: 12px; color: #10b981; font-weight: 600; margin-top: 4px;"><i class="bi bi-graph-up"></i> +2.4%</div>
                    </div>
                    <div style="background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #f1f5f9;">
                        <div style="font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Best Month</div>
                        <div style="font-size: 18px; font-weight: 800; color: #1e293b;">@Model.BestPerformingMonth</div>
                        <div style="font-size: 12px; color: #6366f1; font-weight: 600; margin-top: 4px;">Peak Revenue</div>
                    </div>
                    <div style="background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #f1f5f9;">
                        <div style="font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">Efficiency</div>
                        <div style="font-size: 18px; font-weight: 800; color: #1e293b;">94.2%</div>
                        <div style="font-size: 12px; color: #f59e0b; font-weight: 600; margin-top: 4px;">High Performance</div>
                    </div>
                </div>

                <div class="chart-container" style="height: 350px;">
                    <canvas id="performanceChart"></canvas>
                </div>
            </div>
            
            <!-- Comparison Legend -->
            <div style="background: #f9fafb; padding: 16px 24px; display: flex; gap: 24px; border-top: 1px solid #f3f4f6;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 12px; height: 12px; border-radius: 3px; background: #6366f1;"></div>
                    <span style="font-size: 13px; font-weight: 700; color: #4b5563;">Sales (Revenue)</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 12px; height: 12px; border-radius: 3px; background: #fb923c;"></div>
                    <span style="font-size: 13px; font-weight: 700; color: #4b5563;">Purchases (Expense)</span>
                </div>
            </div>
        </div>

        <style>
            @@keyframes shimmer {
                0% { transform: translateX(-100%); }
                100% { transform: translateX(100%); }
            }
        </style>
        
        <!-- Low Stock Alert Card -->
        <div class="animate-scale" style="background: white; border-radius: 24px; border: 1px solid #f0f2f5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); overflow: hidden;">
            <div class="table-header" style="background: #fff; padding: 24px;">
                <h3 class="table-title" style="font-size: 18px; font-weight: 800; letter-spacing: -0.5px;">Reorder Alerts</h3>
                <span class="status-badge warning" style="background: #fef3c7; color: #92400e; border-radius: 100px; padding: 4px 12px; font-weight: 700;">@Model.LowStockItems.Count Items</span>
            </div>
            <div style="max-height: 310px; overflow-y: auto;">
                @await Html.PartialAsync("_LowStock", Model.LowStockItems)
            </div>
        </div>
    </div>
    
    <!-- Recent Activity Card -->
    <div class="animate-up" style="background: white; border-radius: 24px; border: 1px solid #f0f2f5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); overflow: hidden; margin-bottom: 40px;">
        <div class="table-header" style="padding: 24px; border-bottom: 1px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center;">
            <h3 class="table-title" style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px;">Recent Transactions</h3>
            <a href="/Sales/Index" class="btn btn-secondary" style="border-radius: 100px; padding: 8px 20px; font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table recent-table mb-0">
                <thead>
                    <tr>
                        <th style="border-top: none;">Ref Number</th>
                        <th style="border-top: none;">Date</th>
                        <th style="border-top: none;">Amount</th>
                        <th style="border-top: none;">Category</th>
                        <th style="border-top: none;">Security</th>
                        <th style="border-top: none;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @await Html.PartialAsync("_RecentOrders", Model.RecentOrders)
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const labels = @Html.Raw(Model.ChartLabelsJson);
            const salesData = @Html.Raw(Model.SalesChartDataJson);
            const purchaseData = @Html.Raw(Model.PurchaseChartDataJson);

            const ctx = document.getElementById('performanceChart').getContext('2d');
            
            // Create gradients
            const salesGradient = ctx.createLinearGradient(0, 0, 0, 350);
            salesGradient.addColorStop(0, 'rgba(99, 102, 241, 0.25)');
            salesGradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

            const purchaseGradient = ctx.createLinearGradient(0, 0, 0, 350);
            purchaseGradient.addColorStop(0, 'rgba(251, 146, 60, 0.15)');
            purchaseGradient.addColorStop(1, 'rgba(251, 146, 60, 0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Sales Revenue',
                            data: salesData,
                            borderColor: '#6366f1',
                            backgroundColor: salesGradient,
                            borderWidth: 4,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#6366f1',
                            pointBorderWidth: 3,
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            z: 2
                        },
                        {
                            label: 'Purchase Expenses',
                            data: purchaseData,
                            borderColor: '#fb923c',
                            backgroundColor: purchaseGradient,
                            borderWidth: 3,
                            borderDash: [5, 5],
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#fb923c',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            z: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index',
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: { size: 14, weight: 'bold', family: "'Inter', sans-serif" },
                            bodyFont: { size: 13, family: "'Inter', sans-serif" },
                            padding: 16,
                            cornerRadius: 12,
                            displayColors: true,
                            boxPadding: 6,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#f1f5f9',
                                drawBorder: false
                            },
                            ticks: {
                                font: { size: 12, weight: '500' },
                                color: '#64748b',
                                padding: 10,
                                callback: function(value) {
                                    if (value >= 1000000) return 'PKR ' + (value / 1000000).toFixed(1) + 'M';
                                    if (value >= 1000) return 'PKR ' + (value / 1000) + 'k';
                                    return 'PKR ' + value;
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: { size: 12, weight: '500' },
                                color: '#64748b',
                                padding: 10
                            }
                        }
                    }
                }
            });
        });
    </script>
}
