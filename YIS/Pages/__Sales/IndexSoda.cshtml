@page
@model YIS.Pages.Sales.IndexSodaModel
@{
    ViewData["Title"] = "Sale Soda List";
}

<div class="container-fluid">
    <div class="row align-items-center mb-3">
        <div class="col-6">
            <h2 class="page-title">Sale Soda List</h2>
        </div>
        <div class="col-6 text-end">
                <a href="/Sales/Soda" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> New Sale
                </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-container">
                <table class="data-table table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Sale #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Item</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                            <th>Ref Purchase #</th>
                            <th>Remarks</th>
                            <th class="text-center" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entries != null && Model.Entries.Count > 0)
                        {
                            foreach (var item in Model.Entries)
                            {
                                /// Helper to get Customer name
                                string customerName = "Unknown";
                                if (!string.IsNullOrEmpty(item.EntryAttribute1) && long.TryParse(item.EntryAttribute1, out long custId))
                                {
                                     if(Model.CustomerNames.ContainsKey(custId))
                                     {
                                         customerName = Model.CustomerNames[custId];
                                     }
                                }

                                /// Helper to get item name
                                string itemName = "Unknown";
                                if (item.ItemId.HasValue && Model.ItemNames.ContainsKey(item.ItemId.Value))
                                {
                                    itemName = Model.ItemNames[item.ItemId.Value];
                                }
                                
                                /// Ref No Logic
                                string refNo = !string.IsNullOrEmpty(item.EntryRefNo?.ToString()) ? "PUR-SODA-" + item.EntryRefNo : "-";

                                <tr>
                                    <td>
                                        <a href="/Sales/Soda?id=@item.EntryId" class="text-decoration-none fw-bold">
                                            SSD-@item.EntryNumber
                                        </a>
                                    </td>
                                    <td>@(item.EntryDate?.ToString("dd-MM-yyyy"))</td>
                                    <td>@customerName</td>
                                    <td>@itemName</td>
                                    <td class="text-end">@item.Qty</td>
                                    <td class="text-end">@item.Rate</td>
                                    <td class="text-end fw-bold">@item.Amount?.ToString("N2")</td>
                                    <td>@refNo</td>
                                    <td>@item.EntryRemarks</td>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.EntryId" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this sale?');">
                                            <button type="submit" class="btn btn-link p-0 border-0 bg-transparent" title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">No sale soda entries found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
