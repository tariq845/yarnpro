@page
@model YIS.Pages.Configuration.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get">
                        <div class="position-relative">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input" 
                                   id="userSearch" 
                                   placeholder="Search users..."
                                   value="@Model.SearchTerm"
                                   hx-get="/Configuration/Users"
                                   hx-trigger="input changed delay:500ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Users :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end">
                    <a href="/Configuration/Users/CreateUser" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add User
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Name</th>
                            <th class="border-0 px-4 py-3">Username</th>
                            <th class="border-0 px-4 py-3">Contact</th>
                             <th class="border-0 px-4 py-3">Status</th>
                             <th class="border-0 px-4 py-3 text-end">Actions</th>
                         </tr>
                     </thead>
                     <tbody>
                         @if (Model.Users != null && Model.Users.Any())
                         {
                             foreach (var user in Model.Users)
                             {
                                 <tr>
                                     <td class="px-4 py-3">
                                         <a href="/Configuration/Users/CreateUser?id=@user.UmId"
                                            class="text-decoration-none fw-semibold text-danger">
                                             @user.UmName
                                         </a>
                                     </td>
                                     <td class="px-4 py-3">
                                         <span class="fw-medium text-dark">@user.UmUsername</span>
                                     </td>
                                     <td class="px-4 py-3">
                                         <span class="fw-medium text-dark">@user.UmContact</span>
                                     </td>
                                     
                                     <td class="px-4 py-3">
                                         @if (user.UmDeactiveOn.HasValue && user.UmDeactiveOn <= DateTime.Today)
                                         {
                                             <span class="badge bg-danger">Inactive</span>
                                         }
                                         else
                                         {
                                             <span class="badge bg-success">Active</span>
                                         }
                                     </td>
                                     <td class="px-4 py-3 text-end">
                                         <a href="/Configuration/UserRoleAssignments/CreateUserRoleAssignment?userId=@user.UmId"
                                           class="text-decoration-none  p-0 border-0 bg-transparent me-2 "
                                           title="Assign Roles">
                                             <i class="bi bi-shield-lock text-info fs-5"></i>
                                         </a>
                                         <form method="post" 
                                               asp-page-handler="Delete" 
                                               asp-route-id="@user.UmId" 
                                               style="display:inline;" 
                                               onsubmit="return confirm('Are you sure you want to delete this user?');">
                                             <button type="submit"
                                                    class="text-decoration-none  p-0 border-0 bg-transparent"
                                                     title="Delete">
                                                 <i class="bi bi-trash text-danger fs-5"></i>
                                             </button>
                                         </form>
                                     </td>
                                 </tr>
                             }
                         }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-person text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Users Found</h5>
                                        <p class="text-muted">Create your first user to begin</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@* Server-side search implemented *@
