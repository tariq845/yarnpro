@page
@model YIS.Pages.Configuration.UserRoles.CreateUserRoleModel
@{
    ViewData["Title"] = (Model.UserRole?.UrId > 0 ? "Edit Role" : "Create Role");
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end">
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <h5 class="card-title mb-4">@(Model.UserRole?.UrId > 0 ? "Edit Role" : "Create Role")</h5>

            <!-- Hidden ID for edit mode -->
            @if(Model.UserRole?.UrId > 0)
            {
                <input type="hidden" asp-for="UserRole.UrId" />
            }

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="UserRole.UrName" class="form-label">Role Name <span class="text-danger">*</span></label>
                    <input asp-for="UserRole.UrName" class="form-control" placeholder="Enter role name (e.g., Admin, Manager)" required data-val="true" data-val-required="Role Name is required" />
                    <span asp-validation-for="UserRole.UrName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Configuration/UserRoles/Index" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-outline-success px-4">
                        Save
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
