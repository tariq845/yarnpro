@page
@model YIS.Pages.Configuration.Menus.IndexModel
@{
    ViewData["Title"] = "Menus";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get">
                        <div class="position-relative">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input" 
                                   id="menuSearch" 
                                   placeholder="Search menus..."
                                   value="@Model.SearchTerm"
                                   hx-get="/Configuration/Menus"
                                   hx-trigger="input changed delay:500ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    @if (Model.Menus != null && Model.Menus.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Menus :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end">
                    <a href="/Configuration/Menus/CreateMenu" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Menu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Menu Name</th>
                            <th class="border-0 px-4 py-3">Type</th>
                            <th class="border-0 px-4 py-3">Status</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Menus != null && Model.Menus.Any())
                        {
                            foreach (var item in Model.Menus)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Configuration/Menus/CreateMenu?id=@item.MoId"
                                           class="text-decoration-none fw-semibold text-danger">
                                            @item.MoName
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.MoType</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.MoDeactiveOn.HasValue && item.MoDeactiveOn <= DateTime.Today)
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a href="/Configuration/Menus/CreateMenu?id=@item.MoId" 
                                           class="btn btn-link p-0 border-0 bg-transparent"
                                           title="Edit">
                                            <i class="bi bi-pencil text-primary"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-list text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Menus Found</h5>
                                        <p class="text-muted">Create your first menu to begin</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@* Server-side search implemented *@
