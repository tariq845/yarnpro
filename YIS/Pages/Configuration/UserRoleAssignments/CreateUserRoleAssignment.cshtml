@page
@model YIS.Pages.Configuration.UserRoleAssignments.CreateUserRoleAssignmentModel
@{
    ViewData["Title"] = $"Manage Roles for {Model.UserName}";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="position-relative">
                    <i class="bi bi-search yis-cat-search-icon"></i>
                    <input type="text" 
                           class="form-control yis-cat-search-input" 
                           id="permissionSearch" 
                           placeholder="Search permissions...">
                </div>
            </div>
            <div class="col-md-6 text-end">
                <h6 class="text-muted text-uppercase mb-0" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    Total Permissions: <span class="fw-bold fs-6 text-dark">@Model.MenuAssignments.Count</span>
                </h6>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <h5 class="card-title mb-4">Manage Roles for <span class="text-danger">@Model.UserName</span></h5>

            <input type="hidden" asp-for="UserId" />

            

            <div class="row mt-3">
                <div class="col-12">
                    <label class="form-label fw-bold">Menu Access Permissions</label>
                    <div class="table-responsive border rounded">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="checkbox" id="selectAll">
                                        </div>
                                    </th>
                                    <th>Menu Option</th>
                                    <th class="text-center" style="width: 80px;">Read</th>
                                    <th class="text-center" style="width: 80px;">Create</th>
                                    <th class="text-center" style="width: 80px;">Update</th>
                                    <th class="text-center" style="width: 80px;">Delete</th>
                                    <th style="width: 180px;">Disable On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MenuAssignments != null && Model.MenuAssignments.Any())
                                {
                                    for (int i = 0; i < Model.MenuAssignments.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="MenuAssignments[i].MoId" />
                                                <input type="hidden" asp-for="MenuAssignments[i].MoName" />
                                                <div class="form-check m-0">
                                                    <input class="form-check-input menu-checkbox" 
                                                           type="checkbox" 
                                                           asp-for="MenuAssignments[i].IsSelected" 
                                                           id="menu_@i">
                                                </div>
                                            </td>
                                            <td>
                                                <label class="form-check-label d-block py-1" for="menu_@i" style="cursor: pointer;">
                                                    @Model.MenuAssignments[i].MoName
                                                </label>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check d-inline-block m-0">
                                                    <input class="form-check-input" type="checkbox" asp-for="MenuAssignments[i].CanRead" />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check d-inline-block m-0">
                                                    <input class="form-check-input" type="checkbox" asp-for="MenuAssignments[i].CanCreate" />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check d-inline-block m-0">
                                                    <input class="form-check-input" type="checkbox" asp-for="MenuAssignments[i].CanUpdate" />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check d-inline-block m-0">
                                                    <input class="form-check-input" type="checkbox" asp-for="MenuAssignments[i].CanDelete" />
                                                </div>
                                            </td>
                                            <td>
                                                <input asp-for="MenuAssignments[i].DisableOn" class="form-control form-control-sm" type="date" />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            No menu options available.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 text-end">
                    <a href="/Configuration/Users/Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-outline-success">
                        Save Roles
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const selectAll = document.getElementById('selectAll');
            const menuCheckboxes = document.querySelectorAll('.menu-checkbox');
            const searchInput = document.getElementById('permissionSearch');
            const tableRows = document.querySelectorAll('tbody tr');

            if (selectAll && menuCheckboxes.length > 0) {
                // Select All functionality
                selectAll.addEventListener('change', function() {
                    const visibleCheckboxes = document.querySelectorAll('tbody tr:not([style*="display: none"]) .menu-checkbox');
                    visibleCheckboxes.forEach(cb => {
                        cb.checked = this.checked;
                    });
                });

                // Update Select All checkbox state based on individual checkboxes
                menuCheckboxes.forEach(cb => {
                    cb.addEventListener('change', function() {
                        const visibleCheckboxes = Array.from(document.querySelectorAll('tbody tr:not([style*="display: none"]) .menu-checkbox'));
                        const allChecked = visibleCheckboxes.length > 0 && visibleCheckboxes.every(c => c.checked);
                        selectAll.checked = allChecked;
                        
                        const someChecked = visibleCheckboxes.some(c => c.checked);
                        selectAll.indeterminate = someChecked && !allChecked;
                    });
                });

                // Initial state for Select All
                const allChecked = Array.from(menuCheckboxes).every(c => c.checked);
                selectAll.checked = allChecked;

                const someChecked = Array.from(menuCheckboxes).some(c => c.checked);
                selectAll.indeterminate = someChecked && !allChecked;
            }

            // Search functionality
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    
                    tableRows.forEach(row => {
                        const menuName = row.querySelector('label')?.textContent.toLowerCase() || "";
                        if (menuName.includes(searchTerm)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Update Select All state for the new filtered view
                    if (selectAll) {
                        const visibleCheckboxes = Array.from(document.querySelectorAll('tbody tr:not([style*="display: none"]) .menu-checkbox'));
                        if (visibleCheckboxes.length > 0) {
                            const allChecked = visibleCheckboxes.every(c => c.checked);
                            selectAll.checked = allChecked;
                            const someChecked = visibleCheckboxes.some(c => c.checked);
                            selectAll.indeterminate = someChecked && !allChecked;
                        } else {
                            selectAll.checked = false;
                            selectAll.indeterminate = false;
                        }
                    }
                });
            }
        });
    </script>
}
