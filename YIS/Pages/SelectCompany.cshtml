@page
@model YIS.Pages.SelectCompanyModel
@{
    ViewData["Title"] = "Select Company";
    Layout = "_LoginLayout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Select Company</title>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background-color: #ffffff;
            color: #333;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        .selection-page {
            min-height: 100vh;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .selection-container-basic {
            width: 100%;
            max-width: 800px;
            padding: 40px;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .company-list-basic {
            display: flex;
            flex-direction: column;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            overflow: hidden;
        }

        .company-row {
            position: relative;
            border-bottom: 1px solid #dee2e6;
        }

        .company-row:last-child {
            border-bottom: none;
        }

        .company-row input[type="radio"] {
            position: absolute;
            opacity: 0;
        }

        .row-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 25px 30px;
            cursor: pointer;
            background: #fff;
        }

        .company-row:hover .row-content {
            background-color: #f8f9fa;
        }

        .company-row input:checked + .row-content {
            background-color: #f1f3f5;
        }

        .company-heading {
            font-weight: 800;
            font-size: 1.6rem;
            color: #000;
            margin-bottom: 5px;
        }

        .company-details {
            font-size: 1rem;
            color: #666;
        }

        .row-check {
            color: #0d6efd;
            font-size: 2rem;
            display: none;
        }

        .company-row input:checked + .row-content .row-check {
            display: block;
        }

        .btn-dark {
            border-radius: 4px;
            letter-spacing: 1px;
        }

        .header-section h1 {
            letter-spacing: -0.5px;
        }
    </style>
</head>
<body>

<div class="selection-page">
    <div class="selection-container-basic">

        <div class="header-section mb-5">
            <h1 class="display-6 fw-bold text-dark">Select Company</h1>
            <p class="text-muted border-bottom pb-3">
                Please choose a workspace to continue your session
            </p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="company-list-basic">
                @foreach (var profile in Model.CompanyProfiles)
                {
                    <div class="company-row">
                        <input type="radio"
                               name="SelectedUcpId"
                               value="@profile.UcpId"
                               id="profile_@profile.UcpId"
                               @(Model.SelectedUcpId == profile.UcpId ? "checked" : "")
                               required />

                        <label for="profile_@profile.UcpId" class="row-content">
                            <div class="row-main">
                                <div class="company-heading">
                                    @profile.UcpCompanyName
                                </div>
                                <div class="company-details">
                                    <span>NTN: @profile.UcpCompanyNtn</span>
                                    <span class="ms-3">
                                        Province: @profile.UcpCompanyProvince
                                    </span>
                                </div>
                            </div>

                            <div class="row-check">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </label>
                    </div>
                }
            </div>

            <div class="footer-section mt-5 text-center">
                <button type="submit"
                        class="btn btn-dark btn-lg px-5 py-3 fw-bold">
                    CONTINUE <i class="bi bi-arrow-right ms-2"></i>
                </button>

                <div class="mt-4">
                    <a asp-page="/Login"
                       class="text-secondary text-decoration-none small">
                        <i class="bi bi-box-arrow-left me-1"></i> LOGOUT
                    </a>
                </div>
            </div>
        </form>

    </div>
</div>

</body>
</html>
