<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end ">
        <a href="/Categories/CreateSubCategory" class="btn btn-outline-info ml-2">Sub-Category</a>
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
        <a href="/Categories/CreateCategoryType" class="btn btn-outline-info">Category Type</a>
    </div>
</div>


<div class="card">
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="CategoryMaster.CategoryId" />
            
            <h5 class="card-title mb-4">@(Model.Id.HasValue ? "Edit Category" : "Create Category")</h5>

            <div class="row">
                <div class="col-md-4 col-sm-6">
                    <label asp-for="CategoryMaster.CategoryName" class="form-label">Category Name <span class="text-danger">*</span></label>
                    <input asp-for="CategoryMaster.CategoryName" class="form-control" placeholder="Enter category name" required data-val="true" data-val-required="Category Name is required" />
                    <span asp-validation-for="CategoryMaster.CategoryName" class="text-danger"></span>
                </div>


                <div class="col-md-4 col-sm-6">
                    <label asp-for="CategoryMaster.SCategoryId" class="form-label">Sub Category <span class="text-danger">*</span></label>
                    <select asp-for="CategoryMaster.SCategoryId" class="form-select" asp-items="Model.SubCategories" required data-val="true" data-val-required="Sub Category is required">
                        <option value="">-- Select Sub Category --</option>
                    </select>
                    <span asp-validation-for="CategoryMaster.SCategoryId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoryMaster.CategoryTypeId" class="form-label">Category Type <span class="text-danger">*</span></label>
                    <select asp-for="CategoryMaster.CategoryTypeId" class="form-select" asp-items="Model.CategoryTypes" required data-val="true" data-val-required="Category Type is required">
                        <option value="">-- Select Category Type --</option>
                    </select>
                    <span asp-validation-for="CategoryMaster.CategoryTypeId" class="text-danger"></span>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Categories/CategoriesMaster" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-outline-success px-4">
                        Save
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
