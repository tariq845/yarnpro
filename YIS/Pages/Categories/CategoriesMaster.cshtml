@page
@model YIS.Pages.Categories.CategoriesMasterModel
@{
    ViewData["Title"] = "Categories Master";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div >
    <!-- Page Header -->
    

    <!-- Stats Card Row -->
    

    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get">
                        <div class="position-relative">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input" 
                                   id="categorySearch" 
                                   placeholder="Search categories..."
                                   value="@Model.SearchTerm"
                                   hx-get="/Categories/CategoriesMaster"
                                   hx-trigger="input changed delay:500ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    @if (Model.CategoryMasters != null && Model.CategoryMasters.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Categories :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }


                </div>
                <div class="col-md-3 text-end d-flex justify-content-end align-items-center gap-2">
                    <a asp-page-handler="DownloadExcel" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success text-nowrap" title="Export to Excel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                    <a href="/Categories/CreateCategoryMaster" class="btn btn-primary text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Category
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Category Name</th>
                            <th class="border-0 px-4 py-3">Sub Category</th>
                            <th class="border-0 px-4 py-3">Category Type</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CategoryMasters != null && Model.CategoryMasters.Any())
                        {
                            foreach (var item in Model.CategoryMasters)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Categories/CreateCategoryMaster?id=@item.CategoryId" 
                                           class="text-decoration-none fw-semibold text-danger">
                                            @item.CategoryName
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.SubCategory != null)
                                        {
                                            <span class="fw-medium text-dark">
                                                @item.SubCategory.SCategoryName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not Set</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.CategoryType != null)
                                        {
                                            <span class="fw-medium text-dark">
                                                @item.CategoryType.CategoryTypeName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not Set</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <form method="post" 
                                              asp-page-handler="Delete" 
                                              asp-route-id="@item.CategoryId" 
                                              style="display:inline;" 
                                              onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            <button type="submit"
                                                    class="btn btn-link p-0 border-0 bg-transparent"
                                                    title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Categories Found</h5>
                                        <p class="text-muted">Get started by creating your first category</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@* Server-side search implemented *@
