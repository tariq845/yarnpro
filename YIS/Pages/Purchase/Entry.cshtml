@page
@model YIS.Pages.Purchase.EntryModel
@{
    ViewData["Title"] = "Purchase Entry";
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end">
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" id="purchaseForm">
            <h5 class="card-title mb-4">
                Purchase Entry
                <span class="badge bg-light text-dark fs-6 float-end">@Model.DisplayEntryNumber</span>
                @if (Model.IsPosted)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success me-2 float-end fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i> Posted
                    </span>
                }
            </h5>

            @if (Model.IsPosted)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-lock-fill flex-shrink-0 me-2 fs-4"></i>
                    <div>
                        <strong>Locked:</strong> This purchase has been posted to the ledger and cannot be edited.
                    </div>
                </div>
            }

            <input type="hidden" asp-for="Entry.EntryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Row 1: Basic Info -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryDate" class="form-label">Date <span class="text-danger">*</span></label>
                    <input asp-for="Entry.EntryDate" type="date" class="form-control" required
                        disabled="@Model.IsPosted" />
                    <span asp-validation-for="Entry.EntryDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryAttribute1" class="form-label">Supplier <span
                            class="text-danger">*</span></label>
                    <select asp-for="Entry.EntryAttribute1" class="form-select" asp-items="Model.SupplierList" required
                        disabled="@Model.IsPosted">
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span asp-validation-for="Entry.EntryAttribute1" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2: References -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryRefNo" class="form-label">Against Pur Soda No</label>
                    <select asp-for="Entry.EntryRefNo" class="form-select" asp-items="Model.PurchaseSodaList"
                        disabled="@Model.IsPosted">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryRefCode" class="form-label">Supplier Pur No</label>
                    <input asp-for="Entry.EntryRefCode" class="form-control" placeholder="Optional"
                        disabled="@Model.IsPosted" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryTermsDays" class="form-label">Payment Terms (Days)</label>
                    <input asp-for="Entry.EntryTermsDays" type="number" class="form-control" min="0"
                        disabled="@Model.IsPosted" />
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="mb-4">
                <h6 class="mt-3 mb-3 text-muted border-bottom pb-2">Purchase Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm" id="lineItemsTable">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 20%;">Item <span class="text-danger">*</span></th>
                                <th style="width: 10%;">Qty <span class="text-danger">*</span></th>
                                <th style="width: 10%;">LBS</th>
                                <th style="width: 10%;">Rate <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Amount</th>
                                <th style="width: 8%;">GST %</th>
                                <th style="width: 10%;">GST Amt</th>
                                <th style="width: 12%;">Net Amt</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineItemsBody">
                            @for (int i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr class="line-item-row">
                                    <td>
                                        <input type="hidden" name="LineItems[@i].EntryId"
                                            value="@Model.LineItems[i].EntryId" />
                                        <select name="LineItems[@i].ItemId" class="form-select form-select-sm item-select"
                                            required disabled="@Model.IsPosted">
                                            <option value="">-- Select --</option>
                                            @foreach (var item in Model.ItemList)
                                            {
                                                if (Model.LineItems[i].ItemId?.ToString() == item.Value)
                                                {
                                                    <option
                                                        value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Qty"
                                            value="@Model.LineItems[i].Qty"
                                            class="form-control form-control-sm qty-input text-end" required
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="text" name="LineItems[@i].Lbs"
                                            value="@Model.LineItems[i].Lbs?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                            class="form-control form-control-sm lbs-input text-end bg-light" readonly
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.0001" name="LineItems[@i].Rate"
                                            value="@(Model.LineItems[i].Rate?.ToString("F4"))"
                                            class="form-control form-control-sm rate-input text-end" required
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="text" name="LineItems[@i].Amount"
                                               value="@Model.LineItems[i].Amount?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                               class="form-control form-control-sm amount-input text-end bg-light" readonly
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstPercent"
                                            value="@Model.LineItems[i].GstPercent"
                                            class="form-control form-control-sm gst-percent-input text-end"
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="text" name="LineItems[@i].TaxAmount"
                                            value="@Model.LineItems[i].TaxAmount?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                            class="form-control form-control-sm gst-amount-input text-end bg-light" readonly
                                            disabled="@Model.IsPosted" /></td>
                                    <td><input type="text" name="LineItems[@i].NetAmount"
                                            value="@Model.LineItems[i].NetAmount?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                            class="form-control form-control-sm net-amount-input text-end fw-bold bg-light"
                                            readonly disabled="@Model.IsPosted" /></td>
                                    <td class="text-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn"><i
                                                    class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-muted small text-uppercase">
                                    <div class="d-flex justify-content-between align-items-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-primary px-3 shadow-sm border-0"
                                                id="btnAddRow" title="Add Item">
                                                Add +
                                            </button>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span>Grand Totals:</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" id="grandTotalAmount"
                                        class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly
                                        value="0.00" />
                                </td>
                                <td></td>
                                <td>
                                    <input type="text" id="grandTotalGst"
                                        class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly
                                        value="0.00" />
                                </td>
                                <td>
                                    <input type="text" id="grandTotalNet"
                                        class="form-control form-control-sm fw-bold text-end text-success bg-white border-0"
                                        readonly value="0.00" />
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Remarks & Commission -->
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Entry.EntryRemarks" class="form-label">Remarks</label>
                    <textarea asp-for="Entry.EntryRemarks" class="form-control" rows="4" placeholder="Enter remarks"
                        disabled="@Model.IsPosted"></textarea>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-muted mb-3">Commission Details</h6>

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Apply Commission?</label></div>
                                <div class="col-6">
                                    <select asp-for="Entry.EntryAttribute5" class="form-select form-select-sm"
                                        id="ddlCommission" disabled="@Model.IsPosted">
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Agent</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryAttribute4" class="form-control form-control-sm"
                                        id="txtCommAgent" placeholder="Agent Name" disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Percentage (%)</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommPer"
                                        class="form-control form-control-sm text-end bg-light" id="txtCommPer"
                                        type="number" step="0.01" min="0" readonly value="10"
                                        disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0 fw-bold">Comm. Amount</label>
                                </div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommAmt" value="@Model.Entry.EntryCommAmt?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                        class="form-control form-control-sm text-end fw-bold bg-white" id="txtCommAmt"
                                        readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">SUKRI</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommSukri" value="@Model.Entry.EntryCommSukri?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)"
                                        class="form-control form-control-sm text-end bg-white" id="txtSukri" readonly
                                        disabled="@Model.IsPosted" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Purchase/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    @if (!Model.IsPosted)
                    {
                        <button type="submit" class="btn btn-outline-success px-5">Save</button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<template id="rowTemplate">
    <tr class="line-item-row">
        <td>
            <input type="hidden" name="LineItems[__INDEX__].EntryId" value="0" />
            <select name="LineItems[__INDEX__].ItemId" class="form-select form-select-sm item-select" required>
                <option value="">-- Select --</option>
                @if (Model.ItemList != null)
                {
                    foreach (var item in Model.ItemList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
        </td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Qty"
                class="form-control form-control-sm qty-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Lbs"
                class="form-control form-control-sm lbs-input text-end" /></td>
        <td><input type="number" step="0.0001" name="LineItems[__INDEX__].Rate"
                class="form-control form-control-sm rate-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Amount"
                class="form-control form-control-sm amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstPercent"
                class="form-control form-control-sm gst-percent-input text-end" /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].TaxAmount"
                class="form-control form-control-sm gst-amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].NetAmount"
                class="form-control form-control-sm net-amount-input text-end fw-bold bg-light" readonly /></td>
        <td class="text-center"><button type="button" class="btn btn-link p-0 text-danger remove-row-btn"><i
                    class="bi bi-trash"></i></button></td>
    </tr>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const psdData = {};
        @if (Model.PsdEntriesForJs != null)
        {
            foreach (var p in Model.PsdEntriesForJs)
            {
                @:psdData['@p.EntryId'] = {
                @:supplierId: '@p.SupplierId',
                @:text: '@p.DisplayText',
                @:items: [
                if (p.Items != null)
                {
                    var i = 0;
                    foreach (var item in p.Items)
                    {
                        @:{ itemId: @item.ItemId, itemName: '@item.ItemName.Replace("'", "\\'")', qty: @item.Qty, lbs: @item.Lbs, rate: @item.Rate, consumed: @item.ConsumedQty, remaining: @item.RemainingQty }@(i < p.Items.Count - 1 ? "," : "")
                        i++;
                    }
                }
                @:    ]
                @:};
            }
        }

                const body = document.getElementById('lineItemsBody');
            const btn = document.getElementById('btnAddRow');
            const template = document.getElementById('rowTemplate');

            // Filter elements
            const ddlSupp = document.getElementById('Entry_EntryAttribute1'); // Supplier
            const ddlPsd = document.getElementById('Entry_EntryRefNo'); // Purchase Soda Ref

            // Grand Total Elements
            const grandTotalAmountInput = document.getElementById('grandTotalAmount');
            const grandTotalGstInput = document.getElementById('grandTotalGst');
            const grandTotalNetInput = document.getElementById('grandTotalNet');

            // Commission Elements
            const commissionSelect = document.getElementById('ddlCommission');
            const commAgentInput = document.getElementById('txtCommAgent');
            const commPerInput = document.getElementById('txtCommPer');
            const commAmtInput = document.getElementById('txtCommAmt');
            const sukriInput = document.getElementById('txtSukri');

            function formatNumber(num) {
                return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
            }

            function calcRow(row) {
                const qtyInput = row.querySelector('.qty-input');
                let qty = parseFloat(qtyInput.value) || 0;

                // Auto-calculate LBS = Qty * 100
                const lbsInput = row.querySelector('.lbs-input');
                lbsInput.value = (qty * 100).toFixed(2);

                // --- Validation Logic Start ---
                const psdId = ddlPsd ? ddlPsd.value : "";
                const itemId = row.querySelector('.item-select').value;
                const initialQty = parseFloat(qtyInput.dataset.initialQty) || 0; // For edit mode

                if (psdId && psdData[psdId] && itemId) {
                    const psdItem = psdData[psdId].items.find(i => i.itemId == itemId);

                    if (psdItem) {
                        const maxAllowed = psdItem.remaining + initialQty;

                        if (qty > maxAllowed) {
                            // Show Toast
                            if (typeof showToast === 'function') {
                                showToast("Quantity is not more than psd qty (" + maxAllowed.toFixed(2) + ")", "error");
                            } else {
                                alert("Quantity is not more than psd qty (" + maxAllowed.toFixed(2) + ")");
                            }

                            // Visual Feedback
                            qtyInput.classList.add('is-invalid');
                            qtyInput.classList.add('border-danger');
                        } else {
                            qtyInput.classList.remove('is-invalid');
                            qtyInput.classList.remove('border-danger');
                        }
                    }
                }
                // --- Validation Logic End ---

                const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
                const lbs = parseFloat(qtyInput.value) * 100 || 0;
                const amt = lbs * rate;

                lbsInput.value = formatNumber(lbs);
                row.querySelector('.amount-input').value = formatNumber(amt);

                const gstPer = parseFloat(row.querySelector('.gst-percent-input').value) || 0;
                const gstAmt = amt * (gstPer / 100);
                row.querySelector('.gst-amount-input').value = formatNumber(gstAmt);

                const net = amt + gstAmt;
                row.querySelector('.net-amount-input').value = formatNumber(net);
            }

            function calcTotals() {
                let tAmount = 0;
                let tGst = 0;
                let tNet = 0;

                body.querySelectorAll('.line-item-row').forEach(row => {
                    tAmount += parseFloat(row.querySelector('.amount-input').value) || 0;
                    tGst += parseFloat(row.querySelector('.gst-amount-input').value) || 0;
                    tNet += parseFloat(row.querySelector('.net-amount-input').value) || 0;
                });

                grandTotalAmountInput.value = formatNumber(tAmount);
                grandTotalGstInput.value = formatNumber(tGst);
                grandTotalNetInput.value = formatNumber(tNet);

                calculateCommission(tNet);
            }

            // Capture initial values for Edit Mode
            body.querySelectorAll('.line-item-row').forEach(row => {
                const q = row.querySelector('.qty-input');
                if (q) q.dataset.initialQty = q.value;
            });

            function calculateCommission(totalNet) {
                if (commissionSelect && commissionSelect.value === 'Yes') {
                    const commPer = parseFloat(commPerInput.value) || 0;
                    const commAmt = totalNet * (commPer / 100);
                    commAmtInput.value = commAmt.toFixed(2);

                    const sukriAmt = commAmt * 0.10;
                    sukriInput.value = sukriAmt.toFixed(2);
                } else {
                    if (commAmtInput) commAmtInput.value = '0.00';
                    if (sukriInput) sukriInput.value = '0.00';
                }
            }

            function toggleCommissionFields() {
                if (!commissionSelect) return;

                const isCommission = commissionSelect.value === 'Yes';
                if (commAgentInput) commAgentInput.disabled = !isCommission;
                if (commPerInput) commPerInput.disabled = !isCommission;

                if (!isCommission) {
                    if (commAgentInput) { commAgentInput.value = ''; commAgentInput.style.backgroundColor = '#e9ecef'; }
                    if (commPerInput) { commPerInput.value = '10'; commPerInput.style.backgroundColor = '#e9ecef'; }
                    if (sukriInput) { sukriInput.value = '0.00'; sukriInput.style.backgroundColor = '#e9ecef'; }
                    if (commAmtInput) commAmtInput.value = '0.00';
                } else {
                    if (commAgentInput) { commAgentInput.style.backgroundColor = ''; }
                    if (commPerInput) { commPerInput.value = '10'; commPerInput.readOnly = true; commPerInput.style.backgroundColor = '#e9ecef'; }
                    if (sukriInput) { sukriInput.style.backgroundColor = ''; }
                    calcTotals();
                }
            }

            // Bind Events via Delegation for Robustness
            body.addEventListener('input', function (e) {
                if (e.target.matches('.qty-input, .lbs-input, .rate-input, .gst-percent-input')) {
                    const row = e.target.closest('tr');
                    calcRow(row);
                    calcTotals();
                }
            });

            body.addEventListener('click', function (e) {
                if (e.target.closest('.remove-row-btn')) {
                    if (body.querySelectorAll('.line-item-row').length > 1) {
                        e.target.closest('tr').remove();
                        // Re-filter removed item back into pool
                        filterItemDropdowns();
                        reindex();
                        calcTotals();
                        updateItemSelection();
                    } else {
                        alert("At least one item required");
                    }
                }
            });

            // Commission Events
            if (commissionSelect) commissionSelect.addEventListener('change', toggleCommissionFields);
            toggleCommissionFields();

            // Initial Calc
            body.querySelectorAll('.line-item-row').forEach(row => calcRow(row));
            calcTotals();

            function reindex() {
                Array.from(body.children).forEach((row, idx) => {
                    row.querySelectorAll('input, select').forEach(i => {
                        const name = i.getAttribute('name');
                        if (name) i.setAttribute('name', name.replace(/LineItems\[\d+\]/, `LineItems[${idx}]`));
                    });
                });
            }

            if (btn) {
                btn.onclick = function () {
                    const idx = body.children.length;
                    const clone = template.content.cloneNode(true);
                    clone.querySelectorAll('input, select').forEach(i => {
                        const name = i.getAttribute('name');
                        if (name) i.setAttribute('name', name.replace('__INDEX__', idx));
                    });

                    body.appendChild(clone);
                    reindex(); // Ensure contiguous indices
                    filterItemDropdowns(); // Filter the new row immediately
                    updateItemSelection();
                };
            }

            // Listen for changes on item selects
            body.addEventListener('change', function (e) {
                if (e.target.matches('.item-select')) {
                    // Update uniqueness
                    updateItemSelection();

                    // Auto-fill details if PSD selected
                    const itemId = e.target.value;
                    const psdId = ddlPsd.value;
                    const row = e.target.closest('tr');

                    if (psdId && psdData[psdId] && itemId) {
                        const psdItem = psdData[psdId].items.find(i => i.itemId == itemId);
                        if (psdItem) {
                            const qtyInput = row.querySelector('.qty-input');
                            const lbsInput = row.querySelector('.lbs-input');
                            const rateInput = row.querySelector('.rate-input');
                            const gstInput = row.querySelector('.gst-percent-input');

                            // Auto-fill with remaining qty
                            if (qtyInput) {
                                qtyInput.value = psdItem.remaining;
                                qtyInput.dataset.initialQty = 0;
                            }
                            if (lbsInput) lbsInput.value = (psdItem.remaining * 100).toFixed(2);
                            if (rateInput) rateInput.value = parseFloat(psdItem.rate).toFixed(4);
                            // Auto-populate GST with default 18%
                            if (gstInput) gstInput.value = '18.00';

                            calcRow(row);
                            calcTotals();
                        }
                    } else {
                        // If no PSD selected, set default GST
                        const gstInput = row.querySelector('.gst-percent-input');
                        if (gstInput && !gstInput.value) gstInput.value = '18.00';
                    }
                }
            });

            // FILTERING LOGIC
            function filterPsdOptions(supplierId, selectedValue = "") {
                if (!ddlPsd) return;

                const firstOption = ddlPsd.options[0];
                ddlPsd.innerHTML = '';
                ddlPsd.appendChild(firstOption);

                const filtered = Object.keys(psdData).filter(key =>
                    !supplierId || psdData[key].supplierId == supplierId
                );

                filtered.forEach(key => {
                    const opt = document.createElement('option');
                    opt.value = key;
                    opt.text = psdData[key].text;
                    ddlPsd.appendChild(opt);
                });

                if (selectedValue && filtered.includes(selectedValue)) {
                    ddlPsd.value = selectedValue;
                } else if (!filtered.includes(ddlPsd.value)) {
                    ddlPsd.value = "";
                }
            }

            function filterItemDropdowns() {
                const psdId = ddlPsd.value;
                const selects = document.querySelectorAll('.item-select');
                const templateSelect = template.content.querySelector('.item-select');

                const allSelects = [...selects];
                if (templateSelect) allSelects.push(templateSelect);

                allSelects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;

                        let isAvailable = true;
                        if (psdId && psdData[psdId] && psdData[psdId].items) {
                            isAvailable = psdData[psdId].items.some(i => i.itemId == option.value);
                        }

                        if (isAvailable) {
                            option.style.display = '';
                            option.disabled = false;
                        } else {
                            option.style.display = 'none';
                            option.disabled = true;
                        }
                    });

                    // If current value is now hidden/disabled, clear it
                    if (currentValue && select.options[select.selectedIndex]?.disabled) {
                        select.value = "";
                    }
                });
            }

            function resetAllLineItems() {
                // Clear values first
                body.querySelectorAll('.line-item-row').forEach(row => {
                    row.querySelector('input, select').value = '';
                    row.querySelectorAll('input').forEach(i => i.value = '');
                    row.querySelector('.item-select').value = '';
                });

                // Remove extra rows
                while (body.querySelectorAll('.line-item-row').length > 1) {
                    body.lastElementChild.remove();
                }
                reindex();
                calcTotals();
                updateItemSelection();
            }

            if (ddlSupp) {
                ddlSupp.addEventListener('change', function () {
                    const supplierId = this.value;
                    filterPsdOptions(supplierId);

                    ddlPsd.value = '';
                    resetAllLineItems();
                    filterItemDropdowns();
                    updateItemSelection();
                });
            }

            if (ddlPsd) {
                ddlPsd.addEventListener('change', function () {
                    const id = this.value;

                    resetAllLineItems();

                    if (id && psdData[id]) {
                        const d = psdData[id];
                        if (d.supplierId && ddlSupp) ddlSupp.value = d.supplierId;
                    }
                    filterItemDropdowns();
                    updateItemSelection();
                });

                // Initial
                const initialPsd = ddlPsd.value;
                if (ddlSupp && ddlSupp.value) filterPsdOptions(ddlSupp.value, initialPsd);
                if (initialPsd) filterItemDropdowns();
            }

            // Disable already selected items (Unique Item Selection)
            function updateItemSelection() {
                const selects = document.querySelectorAll('.item-select');
                const selectedItems = Array.from(selects)
                    .map(select => select.value)
                    .filter(val => val !== "");

                selects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;
                        if (option.style.display === 'none') return; // Skip filtered items

                        if (selectedItems.includes(option.value) && option.value !== currentValue) {
                            option.disabled = true;
                            option.style.backgroundColor = '#f8f9fa';
                            option.style.color = '#adb5bd';
                        } else {
                            option.disabled = false;
                            option.style.backgroundColor = '';
                            option.style.color = '';
                        }
                    });
                });
            }

            // Initial call
            updateItemSelection();

            // Form Validation Enhancement
            const form = document.getElementById('purchaseForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    // Check for validation errors first
                    if (document.querySelectorAll('.is-invalid').length > 0) {
                        e.preventDefault();
                        alert('Please fix validation errors before saving.');
                        return false;
                    }

                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn && !submitBtn.disabled) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
                    }
                });
            }
        });
    </script>
}
