@page "{id:long}"
@model YIS.Pages.Purchase.InvoiceViewModel
@{
    ViewData["Title"] = "Purchase Invoice View";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Purchase Invoice @Model.Invoice.InvoiceNo - YIS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: #525659;
            color: #212529;
            margin: 0;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }

        .actions-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #212529;
            color: white;
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

        .back-link {
            text-decoration: none;
            color: #dee2e6;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .back-link:hover { color: #fff; }

        .btn-group-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .btn {
            border: none;
            padding: 7px 16px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        .btn-print { background: #495057; color: white; }
        .btn-print:hover { background: #6c757d; }
        .btn-download { background: #0d6efd; color: white; }
        .btn-download:hover { background: #0b5ed7; }
        .btn-movement { background: #198754; color: white; }
        .btn-movement:hover { background: #157347; }

        .page-container {
            width: 210mm;
            min-height: 297mm;
            background: white;
            margin: 50px auto 20px;
            padding: 12mm 10mm;
            box-sizing: border-box;
            position: relative;
            box-shadow: 0 4px 15px rgba(0,0,0,0.35);
        }

        .inv-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .company-title {
            font-size: 20px;
            font-weight: 800;
            color: #0d6efd;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .sub-title {
            font-size: 11px;
            color: #6c757d;
            margin: 2px 0 0;
        }

        .doc-badge {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 8px 14px;
            text-align: right;
        }

        .doc-title {
            font-size: 16px;
            font-weight: 800;
            color: #212529;
            margin: 0;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .doc-no {
            font-size: 14px;
            font-weight: 700;
            color: #0d6efd;
            margin-top: 2px;
        }

        .party-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .party-card {
            border: 1px solid #e9ecef;
            border-radius: 4px;
            padding: 10px 12px;
            background-color: #fcfcfd;
            font-size: 11.5px;
            line-height: 1.45;
        }

        .party-card-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            color: #6c757d;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 3px;
        }

        .party-name {
            font-size: 13px;
            font-weight: 700;
            color: #111;
            margin-bottom: 4px;
        }

        .meta-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin-bottom: 16px;
        }

        .meta-table td {
            padding: 5px 8px;
            border: 1px solid #e9ecef;
        }

        .meta-label {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
            width: 18%;
        }

        .meta-val {
            color: #111;
            width: 32%;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin-bottom: 16px;
        }

        .items-table th {
            background-color: #f1f3f5;
            color: #343a40;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 9.5px;
            letter-spacing: 0.5px;
            padding: 7px 8px;
            border: 1px solid #dee2e6;
            text-align: left;
        }

        .items-table td {
            padding: 6px 8px;
            border: 1px solid #dee2e6;
            vertical-align: middle;
        }

        .items-table tfoot td {
            background-color: #f8f9fa;
            font-weight: 700;
            border-top: 2px solid #dee2e6;
        }

        .text-end { text-align: right !important; }
        .text-center { text-align: center !important; }

        .basis-badge {
            display: inline-block;
            font-size: 10px;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 3px;
        }
        .basis-comm {
            background-color: #cfe2ff;
            color: #084298;
            border: 1px solid #b6d4fe;
        }
        .basis-net {
            background-color: #e2e3e5;
            color: #41464b;
            border: 1px solid #d3d6d8;
        }

        .doc-footer {
            margin-top: 25px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding-top: 15px;
            border-top: 1px solid #dee2e6;
            font-size: 10px;
            color: #6c757d;
        }

        .sign-box {
            text-align: center;
            width: 150px;
        }
        .sign-line {
            border-bottom: 1px solid #333;
            height: 35px;
            margin-bottom: 4px;
        }

        @@media print {
            body { background: white !important; padding: 0 !important; }
            .actions-bar { display: none !important; }
            .page-container {
                margin: 0 !important;
                padding: 8mm 6mm !important;
                box-shadow: none !important;
                width: 100% !important;
            }
        }
    </style>
</head>
<body>

    <div class="actions-bar">
        <div>
            <a href="/Purchase/Index" class="back-link">
                <i class="bi bi-arrow-left"></i> Back to Purchase List
            </a>
        </div>
        <div class="btn-group-actions">
            @if (Model.Invoice.RefPsdId.HasValue && Model.Invoice.RefPsdId.Value > 0)
            {
                <a href="/Reports/PsdRecordTrack/@Model.Invoice.RefPsdId" class="btn btn-movement" target="_blank">
                    <i class="bi bi-diagram-3"></i> Movement Ledger
                </a>
            }
            <button class="btn btn-print" onclick="window.print()">
                <i class="bi bi-printer"></i> Print
            </button>
            <button class="btn btn-download" onclick="downloadPdf()">
                <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </button>
        </div>
    </div>

    <div class="page-container" id="printableArea">
        <!-- Header -->
        <div class="inv-header">
            <div>
                <h1 class="company-title">@Model.Invoice.BuyerName</h1>
                @if (!string.IsNullOrEmpty(Model.Invoice.BuyerOwnerName))
                {
                    <div class="sub-title">Owner / Proprietor: <strong>@Model.Invoice.BuyerOwnerName</strong></div>
                }
                <div class="sub-title">NTN: @Model.Invoice.BuyerNtn | @Model.Invoice.BuyerProvince</div>
                <div class="sub-title">@Model.Invoice.BuyerAddress</div>
            </div>
            <div class="doc-badge">
                <div class="doc-title">PURCHASE INVOICE</div>
                <div class="doc-no">@Model.Invoice.InvoiceNo</div>
                <div class="sub-title">Date: <strong>@Model.Invoice.Date</strong></div>
                <div style="margin-top: 4px;">
                    <span class="basis-badge @(Model.Invoice.IsCommissionBased ? "basis-comm" : "basis-net")">
                        @Model.Invoice.BasisText
                    </span>
                </div>
            </div>
        </div>

        <!-- Supplier & Buyer Details -->
        <div class="party-section">
            <div class="party-card">
                <div class="party-card-title"><i class="bi bi-truck me-1"></i> Supplier (Seller)</div>
                <div class="party-name">@Model.Invoice.SupplierName</div>
                <div><strong>NTN:</strong> @Model.Invoice.SupplierNtn</div>
                <div><strong>Contact:</strong> @Model.Invoice.SupplierContact</div>
                <div><strong>Address:</strong> @Model.Invoice.SupplierAddress</div>
            </div>
            <div class="party-card">
                <div class="party-card-title"><i class="bi bi-building me-1"></i> Buyer (Billed To)</div>
                <div class="party-name">@Model.Invoice.BuyerName</div>
                <div><strong>NTN:</strong> @Model.Invoice.BuyerNtn</div>
                <div><strong>Province:</strong> @Model.Invoice.BuyerProvince</div>
                <div><strong>Address:</strong> @Model.Invoice.BuyerAddress</div>
            </div>
        </div>

        <!-- Meta Table -->
        <table class="meta-table">
            <tr>
                <td class="meta-label">Source Soda (PSD):</td>
                <td class="meta-val">
                    @if (!string.IsNullOrEmpty(Model.Invoice.RefPsdNo))
                    {
                        <strong>@Model.Invoice.RefPsdNo</strong>
                    }
                    else
                    {
                        <span class="text-muted">Direct Purchase</span>
                    }
                </td>
                <td class="meta-label">Supplier Bill / DC #:</td>
                <td class="meta-val">@(string.IsNullOrEmpty(Model.Invoice.SupplierBillNo) ? "-" : Model.Invoice.SupplierBillNo)</td>
            </tr>
            <tr>
                <td class="meta-label">Payment Terms:</td>
                <td class="meta-val">
                    @(Model.Invoice.TermsDays.HasValue && Model.Invoice.TermsDays > 0 ? $"{Model.Invoice.TermsDays} Days" : "Immediate / Cash")
                </td>
                <td class="meta-label">Payment Mode:</td>
                <td class="meta-val">@Model.Invoice.PaymentMode</td>
            </tr>
            <tr>
                <td class="meta-label">Contract Basis:</td>
                <td class="meta-val"><strong>@Model.Invoice.BasisText</strong></td>
                <td class="meta-label">Commission Info:</td>
                <td class="meta-val">
                    @if (Model.Invoice.IsCommissionBased)
                    {
                        <span>@(Model.Invoice.CommPer ?? 0)% @(Model.Invoice.CommAmt.HasValue ? $"(- PKR {Model.Invoice.CommAmt:N2})" : "") @(!string.IsNullOrEmpty(Model.Invoice.CommAgent) ? $"| Agent: {Model.Invoice.CommAgent}" : "")</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A (Net Rate)</span>
                    }
                </td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(Model.Invoice.Remarks))
            {
                <tr>
                    <td class="meta-label">Remarks:</td>
                    <td class="meta-val" colspan="3">@Model.Invoice.Remarks</td>
                </tr>
            }
        </table>

        <!-- Items Table -->
        <table class="items-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 30px;">#</th>
                    <th>Item Description</th>
                    <th class="text-center" style="width: 80px;">HS Code</th>
                    <th class="text-end" style="width: 80px;">Bags</th>
                    <th class="text-end" style="width: 90px;">Total Lbs</th>
                    <th class="text-end" style="width: 80px;">Rate</th>
                    <th class="text-end" style="width: 100px;">Basic Amount</th>
                    <th class="text-center" style="width: 60px;">GST %</th>
                    <th class="text-end" style="width: 90px;">Sales Tax</th>
                    <th class="text-end" style="width: 110px;">Net Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int idx = 1;
                }
                @foreach (var item in Model.Invoice.Items)
                {
                    <tr>
                        <td class="text-center text-muted">@idx</td>
                        <td><strong>@item.ItemName</strong></td>
                        <td class="text-center text-muted">@item.HsCode</td>
                        <td class="text-end fw-bold">@item.Qty.ToString("N2")</td>
                        <td class="text-end">@item.Lbs.ToString("N2")</td>
                        <td class="text-end">@item.Rate.ToString("F4")</td>
                        <td class="text-end">@item.ValueExcl.ToString("N2")</td>
                        <td class="text-center">@(item.TaxPer > 0 ? $"{item.TaxPer}%" : "0%")</td>
                        <td class="text-end">@item.TaxAmt.ToString("N2")</td>
                        <td class="text-end fw-bold text-dark">@item.ValueIncl.ToString("N2")</td>
                    </tr>
                    idx++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-center text-uppercase">Total</td>
                    <td class="text-end">@Model.Invoice.TotalQty.ToString("N2")</td>
                    <td class="text-end">@Model.Invoice.TotalLbs.ToString("N2")</td>
                    <td></td>
                    <td class="text-end">@Model.Invoice.TotalBasic.ToString("N2")</td>
                    <td></td>
                    <td class="text-end">@Model.Invoice.TotalTax.ToString("N2")</td>
                    <td class="text-end text-primary" style="font-size: 12px;">@Model.Invoice.GrandTotal.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- Footer Signatures -->
        <div class="doc-footer">
            <div style="max-width: 55%;">
                @if (!string.IsNullOrEmpty(Model.Invoice.BuyerTermsDetails))
                {
                    <div style="font-weight: 700; color: #333; margin-bottom: 2px;">Terms & Conditions:</div>
                    <div style="white-space: pre-line;">@Model.Invoice.BuyerTermsDetails</div>
                }
            </div>
            <div style="display: flex; gap: 30px;">
                <div class="sign-box">
                    <div class="sign-line"></div>
                    <div>Received By</div>
                </div>
                <div class="sign-box">
                    <div class="sign-line"></div>
                    <div>Authorized Signature</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function downloadPdf() {
            var element = document.getElementById('printableArea');
            var opt = {
                margin:       [5, 5, 5, 5],
                filename:     '@Model.Invoice.InvoiceNo' + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, letterRendering: true, scrollY: 0 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>

