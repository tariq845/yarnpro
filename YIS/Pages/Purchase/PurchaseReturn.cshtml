@page
@model YIS.Pages.Purchase.PurchaseReturnModel
@{
    ViewData["Title"] = "Purchase Return (Debit Note)";
}

<div class="row mb-3">
    <div class="col-sm-8">&nbsp;</div>
    <div class="col-md-2 col-sm-2 text-end">
    </div>
    <div class=" col-md-2 col-sm-2 text-end">
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" id="purchaseReturnForm">
            <h5 class="card-title mb-4">
                Debit Note (Purchase Return)
                <span class="badge bg-light text-dark fs-6 float-end">@Model.DisplayEntryNumber</span>
                @if (Model.IsPosted)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success me-2 float-end fs-6">
                        <i class="bi bi-bank me-1"></i> Ledger Posted
                    </span>
                }
            </h5>

            @if (Model.IsPosted)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-lock-fill flex-shrink-0 me-2 fs-4"></i>
                    <div>
                        <strong>Locked:</strong> This debit note has been posted to the ledger and cannot be edited.
                    </div>
                </div>
            }
            
            <input type="hidden" asp-for="Entry.EntryId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Row 1: Basic Info -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryDate" class="form-label">Date <span class="text-danger">*</span></label>
                    <input asp-for="Entry.EntryDate" type="date" class="form-control" required disabled="@Model.IsPosted" />
                    <span asp-validation-for="Entry.EntryDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryAttribute1" class="form-label">Supplier <span class="text-danger">*</span></label>
                     <select asp-for="Entry.EntryAttribute1" class="form-select" asp-items="Model.SupplierList" required disabled="@Model.IsPosted">
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span asp-validation-for="Entry.EntryAttribute1" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2: References -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Entry.EntryRefNo" class="form-label">Against Pur No</label>
                    <select asp-for="Entry.EntryRefNo" class="form-select" asp-items="Model.PurchaseList" disabled="@Model.IsPosted">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                 <div class="col-md-3 mb-3">
                    <label asp-for="Entry.EntryRefCode" class="form-label">Supp Pur No</label>
                    <input asp-for="Entry.EntryRefCode" class="form-control" placeholder="Optional" disabled="@Model.IsPosted" />
                </div>
                <div class="col-md-3 mb-3">
                     <label asp-for="Entry.EntryTermsDays" class="form-label">Payment Terms (Days)</label>
                     <input asp-for="Entry.EntryTermsDays" type="number" class="form-control" min="0" disabled="@Model.IsPosted" />
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="mb-4">
                <h6 class="mt-3 mb-3 text-muted border-bottom pb-2">Return Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle shadow-sm" id="lineItemsTable">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 20%;">Item <span class="text-danger">*</span></th>
                                <th style="width: 10%;">Qty <span class="text-danger">*</span></th>
                                <th style="width: 10%;">LBS</th>
                                <th style="width: 10%;">Rate <span class="text-danger">*</span></th>
                                <th style="width: 12%;">Amount</th>
                                <th style="width: 8%;">GST %</th>
                                <th style="width: 10%;">GST Amt</th>
                                <th style="width: 12%;">Net Amt</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineItemsBody">
                            @for(int i=0; i< Model.LineItems.Count; i++)
                            {
                                <tr class="line-item-row">
                                    <input type="hidden" name="LineItems[@i].EntryId" value="@Model.LineItems[i].EntryId" />
                                    <td>
                                        <select name="LineItems[@i].ItemId" class="form-select form-select-sm item-select" required disabled="@Model.IsPosted">
                                            <option value="">-- Select --</option>
                                            @foreach(var item in Model.ItemList) {
                                                if(Model.LineItems[i].ItemId?.ToString() == item.Value) { <option value="@item.Value" selected>@item.Text</option> }
                                                else { <option value="@item.Value">@item.Text</option> }
                                            }
                                        </select>
                                    </td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Qty" value="@Model.LineItems[i].Qty" class="form-control form-control-sm qty-input text-end" required disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Lbs" value="@Model.LineItems[i].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.0001" name="LineItems[@i].Rate" value="@(Model.LineItems[i].Rate?.ToString("F4"))" class="form-control form-control-sm rate-input text-end" required disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].Amount" value="@Model.LineItems[i].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].GstPercent" value="@Model.LineItems[i].GstPercent" class="form-control form-control-sm gst-percent-input text-end" disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].TaxAmount" value="@Model.LineItems[i].TaxAmount" class="form-control form-control-sm gst-amount-input text-end bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td><input type="number" step="0.01" name="LineItems[@i].NetAmount" value="@Model.LineItems[i].NetAmount" class="form-control form-control-sm net-amount-input text-end fw-bold bg-light" readonly disabled="@Model.IsPosted" /></td>
                                    <td class="text-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-link p-0 text-danger remove-row-btn"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-muted small text-uppercase">
                                    <div class="d-flex justify-content-between align-items-center">
                                        @if (!Model.IsPosted)
                                        {
                                            <button type="button" class="btn btn-primary px-3 shadow-sm border-0" id="btnAddRow" title="Add Item">
                                                Add +
                                            </button>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span>Grand Totals:</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" id="grandTotalAmount" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly value="0.00" />
                                </td>
                                <td></td>
                                <td>
                                    <input type="text" id="grandTotalGst" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly value="0.00" />
                                </td>
                                <td>
                                    <input type="text" id="grandTotalNet" class="form-control form-control-sm fw-bold text-end text-success bg-white border-0" readonly value="0.00" />
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            
            <!-- Remarks & Commission -->
             <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Entry.EntryRemarks" class="form-label">Remarks</label>
                    <textarea asp-for="Entry.EntryRemarks" class="form-control" rows="4" placeholder="Enter remarks" disabled="@Model.IsPosted"></textarea>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-muted mb-3">Commission Details</h6>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Apply Commission?</label></div>
                                <div class="col-6">
                                    <select asp-for="Entry.EntryAttribute5" class="form-select form-select-sm" id="ddlCommission" disabled="@Model.IsPosted">
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Agent</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryAttribute4" class="form-control form-control-sm" id="txtCommAgent" placeholder="Agent Name" disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">Percentage (%)</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommPer" class="form-control form-control-sm text-end bg-light" id="txtCommPer" type="number" step="0.01" min="0" readonly value="10" disabled="@Model.IsPosted" />
                                </div>
                            </div>
                            
                            <div class="row mb-2 align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0 fw-bold">Comm. Amount</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommAmt" class="form-control form-control-sm text-end fw-bold bg-white" id="txtCommAmt" readonly disabled="@Model.IsPosted" />
                                </div>
                            </div>

                            <div class="row align-items-center">
                                <div class="col-6"><label class="small text-muted mb-0">SUKRI</label></div>
                                <div class="col-6">
                                    <input asp-for="Entry.EntryCommSukri" class="form-control form-control-sm text-end" id="txtSukri" type="number" step="0.01" min="0" value="@(Model.Entry?.EntryCommSukri?.ToString("0.00") ?? "0.00")" disabled="@Model.IsPosted" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Purchase/PurchaseReturnIndex" class="btn btn-outline-secondary px-4">Cancel</a>
                    @if (!Model.IsPosted)
                    {
                        <button type="submit" class="btn btn-outline-success px-5">Save</button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<template id="rowTemplate">
    <tr class="line-item-row">
        <input type="hidden" name="LineItems[__INDEX__].EntryId" value="0" />
        <td>
             <select name="LineItems[__INDEX__].ItemId" class="form-select form-select-sm item-select" required>
                <option value="">-- Select --</option>
                @if(Model.ItemList != null) {
                    foreach(var item in Model.ItemList) { <option value="@item.Value">@item.Text</option> }
                }
            </select>
        </td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Qty" class="form-control form-control-sm qty-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Lbs" class="form-control form-control-sm lbs-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.0001" name="LineItems[__INDEX__].Rate" class="form-control form-control-sm rate-input text-end" required /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].Amount" class="form-control form-control-sm amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].GstPercent" class="form-control form-control-sm gst-percent-input text-end" /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].TaxAmount" class="form-control form-control-sm gst-amount-input text-end bg-light" readonly /></td>
        <td><input type="number" step="0.01" name="LineItems[__INDEX__].NetAmount" class="form-control form-control-sm net-amount-input text-end fw-bold bg-light" readonly /></td>
        <td class="text-center"><button type="button" class="btn btn-link p-0 text-danger remove-row-btn"><i class="bi bi-trash"></i></button></td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const purchaseData = {};
            @if(Model.PurchaseEntriesForJs != null)
            {
                foreach(var p in Model.PurchaseEntriesForJs)
                {
                    @:purchaseData['@p.EntryNumber'] = {
                    @:    supplierId: '@p.SupplierId',
                    @:    text: '@p.DisplayText',
                    @:    items: [
                    if(p.Items != null)
                    {
                        var i = 0;
                        foreach(var item in p.Items)
                        {
                            @:{ itemId: @item.ItemId, itemName: '@item.ItemName.Replace("'", "\\'")', qty: @item.Qty, rate: @item.Rate }@(i < p.Items.Count - 1 ? "," : "")
                            i++;
                        }
                    }
                    @:    ]
                    @:};
                }
            }

            const body = document.getElementById('lineItemsBody');
            const btn = document.getElementById('btnAddRow');
            const template = document.getElementById('rowTemplate');
            
            // Filter elements
            const ddlSupp = document.getElementById('Entry_EntryAttribute1'); // Supplier
            const ddlPur = document.getElementById('Entry_EntryRefNo'); // Purchase Ref
            
            // Grand Total Elements
            const grandTotalAmountInput = document.getElementById('grandTotalAmount');
            const grandTotalGstInput = document.getElementById('grandTotalGst');
            const grandTotalNetInput = document.getElementById('grandTotalNet');
            
            // Commission Elements
            const commissionSelect = document.getElementById('ddlCommission');
            const commAgentInput = document.getElementById('txtCommAgent');
            const commPerInput = document.getElementById('txtCommPer');
            const commAmtInput = document.getElementById('txtCommAmt');
            const sukriInput = document.getElementById('txtSukri');

            function calcRow(row) {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;

                // Auto-calculate LBs = Qty * 100
                const lbsInput = row.querySelector('.lbs-input');
                lbsInput.value = (qty * 100).toFixed(2);

                const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
                const amt = qty * rate;
                row.querySelector('.amount-input').value = amt.toFixed(2);
                
                const gstPer = parseFloat(row.querySelector('.gst-percent-input').value) || 0;
                const gstAmt = amt * (gstPer / 100);
                row.querySelector('.gst-amount-input').value = gstAmt.toFixed(2);
                
                const net = amt + gstAmt;
                row.querySelector('.net-amount-input').value = net.toFixed(2);
            }

            function calcTotals() {
                let tAmount = 0;
                let tGst = 0;
                let tNet = 0;
                
                body.querySelectorAll('.line-item-row').forEach(row => {
                    tAmount += parseFloat(row.querySelector('.amount-input').value) || 0;
                    tGst += parseFloat(row.querySelector('.gst-amount-input').value) || 0;
                    tNet += parseFloat(row.querySelector('.net-amount-input').value) || 0;
                });
                
                grandTotalAmountInput.value = tAmount.toFixed(2);
                grandTotalGstInput.value = tGst.toFixed(2);
                grandTotalNetInput.value = tNet.toFixed(2);
                
                calculateCommission(tNet);
            }

            function calculateCommission(totalNet) {
                 if (commissionSelect && commissionSelect.value === 'Yes') {
                    const commPer = parseFloat(commPerInput.value) || 0;
                    const commAmt = totalNet * (commPer / 100);
                    commAmtInput.value = commAmt.toFixed(2);
                } else {
                    if(commAmtInput) commAmtInput.value = '0.00';
                }
            }
            
            function toggleCommissionFields() {
                if(!commissionSelect) return;
                
                const isCommission = commissionSelect.value === 'Yes';
                if(commAgentInput) commAgentInput.disabled = !isCommission;
                if(commPerInput) commPerInput.disabled = !isCommission;
                
                if (!isCommission) {
                    if(commAgentInput) { commAgentInput.value = ''; commAgentInput.style.backgroundColor = '#e9ecef'; }
                    if(commPerInput) { commPerInput.value = '10'; commPerInput.style.backgroundColor = '#e9ecef'; }
                    if(commAmtInput) commAmtInput.value = '0.00';
                } else {
                    if(commAgentInput) { commAgentInput.style.backgroundColor = ''; }
                    if(commPerInput) { commPerInput.value = '10'; commPerInput.readOnly = true; commPerInput.style.backgroundColor = '#e9ecef'; }
                    calcTotals();
                }
            }

            // Bind Events
            body.addEventListener('input', function(e) {
                if(e.target.matches('.qty-input, .rate-input, .gst-percent-input')) {
                    const row = e.target.closest('tr');
                    calcRow(row);
                    calcTotals();
                }
            });

            body.addEventListener('click', function(e) {
                if(e.target.closest('.remove-row-btn')) {
                    if(body.children.length > 1) {
                        e.target.closest('tr').remove();
                        calcTotals();
                        reindex(); 
                        updateItemSelection();
                    } else {
                        alert("At least one item required");
                    }
                }
            });
            
            // Commission Events
            if(commissionSelect) commissionSelect.addEventListener('change', toggleCommissionFields);
            // Initial Toggle
            toggleCommissionFields();
            
            // Initial Calc
            body.querySelectorAll('.line-item-row').forEach(row => calcRow(row));
            calcTotals();

            function reindex() {
                 Array.from(body.children).forEach((row, idx) => {
                    row.querySelectorAll('input, select').forEach(i => {
                        const name = i.getAttribute('name');
                        if(name) i.setAttribute('name', name.replace(/LineItems\[\d+\]/, `LineItems[${idx}]`));
                    });
                });
            }

            function filterPurchaseOptions(supplierId, selectedValue = "") {
                if(!ddlPur) return;
                
                const firstOption = ddlPur.options[0];
                ddlPur.innerHTML = '';
                ddlPur.appendChild(firstOption);

                const filtered = Object.keys(purchaseData).filter(key => 
                    !supplierId || purchaseData[key].supplierId == supplierId
                );

                filtered.forEach(key => {
                    const opt = document.createElement('option');
                    opt.value = key;
                    opt.text = purchaseData[key].text;
                    ddlPur.appendChild(opt);
                });

                if(selectedValue && filtered.includes(selectedValue)) {
                    ddlPur.value = selectedValue;
                } else if (!filtered.includes(ddlPur.value)) {
                    ddlPur.value = "";
                }
            }

            function filterItemDropdowns() {
                const purId = ddlPur.value;
                const selects = document.querySelectorAll('.item-select');
                const templateSelect = template.content.querySelector('.item-select');
                
                const allSelects = [...selects];
                if(templateSelect) allSelects.push(templateSelect);

                allSelects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;
                        
                        let isAvailable = true;
                        if (purId && purchaseData[purId] && purchaseData[purId].items) {
                            isAvailable = purchaseData[purId].items.some(i => i.itemId == option.value);
                            // Also optionally check if not already returned? Logic can be complex.
                            // For now just check if item exists in original purchase.
                        }

                        if (isAvailable) {
                            option.style.display = '';
                            option.disabled = false;
                        } else {
                            option.style.display = 'none';
                            option.disabled = true;
                        }
                    });

                    // If current value is now hidden/disabled, clear it
                    if (currentValue && select.options[select.selectedIndex]?.disabled) {
                        select.value = "";
                    }
                });
            }

            function resetAllLineItems() {
                // Clear values first
                 body.querySelectorAll('.line-item-row').forEach(row => {
                    row.querySelector('input, select').value = ''; 
                    row.querySelectorAll('input').forEach(i => i.value = '');
                    row.querySelector('.item-select').value = '';
                });

                // Remove extra rows
                while (body.querySelectorAll('.line-item-row').length > 1) {
                    body.lastElementChild.remove();
                }
                reindex();
                calcTotals();
                updateItemSelection();
            }

            if(ddlSupp) {
                ddlSupp.addEventListener('change', function() {
                    const supplierId = this.value;
                    filterPurchaseOptions(supplierId);
                    
                    ddlPur.value = '';
                    resetAllLineItems();
                    filterItemDropdowns();
                    updateItemSelection();
                });
            }

            if(ddlPur) {
                ddlPur.addEventListener('change', function() {
                    const id = this.value;
                    
                    resetAllLineItems();
                    
                    if(id && purchaseData[id]) {
                         const d = purchaseData[id];
                         if(d.supplierId && ddlSupp) ddlSupp.value = d.supplierId;
                    }
                    filterItemDropdowns();
                    updateItemSelection();
                });
                
                // Initial
                const initialPur = ddlPur.value;
                if(ddlSupp && ddlSupp.value) filterPurchaseOptions(ddlSupp.value, initialPur);
                if(initialPur) filterItemDropdowns();
            }

            // Disable already selected items
            function updateItemSelection() {
                const selects = document.querySelectorAll('.item-select');
                const selectedItems = Array.from(selects)
                    .map(select => select.value)
                    .filter(val => val !== "");

                selects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (option.value === "") return;
                        if (option.style.display === 'none') return; // Skip filtered items
                        
                        if (selectedItems.includes(option.value) && option.value !== currentValue) {
                            option.disabled = true;
                            option.style.backgroundColor = '#f8f9fa';
                            option.style.color = '#adb5bd';
                        } else {
                            option.disabled = false;
                            option.style.backgroundColor = '';
                            option.style.color = '';
                        }
                    });
                });
            }

            if(btn) {
                btn.onclick = function() {
                    const idx = body.children.length;
                    const clone = template.content.cloneNode(true);
                     clone.querySelectorAll('input, select').forEach(i => {
                         const name = i.getAttribute('name');
                         if(name) i.setAttribute('name', name.replace('__INDEX__', idx));
                    });
                    
                    // Attach events to new row
                    const newRow = clone.querySelector('tr');
                    // We need to attach input listener to new row inputs, but the current code binds via delegation on body 'input' event, which is fine.
                    // But we need to listen to 'change' on select for updateItemSelection
                    
                    body.appendChild(clone);
                    updateItemSelection();
                };
            }
            
            // Listen for changes on item selects
            body.addEventListener('change', function(e) {
                if(e.target.matches('.item-select')) {
                    updateItemSelection();

                    // Auto-fill GST default 18%
                    const row = e.target.closest('tr');
                    const gstInput = row.querySelector('.gst-percent-input');
                    if (gstInput && (!gstInput.value || parseFloat(gstInput.value) === 0)) {
                        gstInput.value = '18.00';
                    }

                    // Auto-fill from purchase data if available
                    const itemId = e.target.value;
                    const purId = ddlPur ? ddlPur.value : '';
                    if (purId && purchaseData[purId] && itemId) {
                        const purItem = purchaseData[purId].items.find(i => i.itemId == itemId);
                        if (purItem) {
                            row.querySelector('.qty-input').value = purItem.qty;
                            row.querySelector('.rate-input').value = parseFloat(purItem.rate).toFixed(4);
                        }
                    }
                    calcRow(row);
                    calcTotals();
                }
            });

            // Initial call
            updateItemSelection();
        });
    </script>
}
