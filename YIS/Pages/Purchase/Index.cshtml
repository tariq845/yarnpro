@page
@model YIS.Pages.Purchase.IndexModel
@{
    ViewData["Title"] = "Purchase Entries";
}

<link rel="stylesheet" href="~/css/categories.css" />

<div>
    <!-- Search and Filter Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <form method="get" id="purchaseSearchForm" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SortDir" id="sortDirInput" value="@Model.SortDir" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                        @if (Model.PsdId.HasValue)
                        {
                            <input type="hidden" name="PsdId" value="@Model.PsdId" />
                        }

                        <div class="position-relative flex-grow-1">
                            <i class="bi bi-search yis-cat-search-icon"></i>
                            <input type="text" 
                                   name="SearchTerm"
                                   class="form-control yis-cat-search-input pe-4" 
                                   id="purchaseSearch" 
                                   list="purchaseSearchDatalist"
                                   placeholder="Search (e.g. pur-1, 1, supplier)..."
                                   value="@Model.SearchTerm"
                                   autocomplete="off"
                                   hx-get="/Purchase"
                                   hx-include="#purchaseSearchForm"
                                   hx-trigger="input changed delay:400ms, search"
                                   hx-target="#table-container"
                                   hx-select="#table-container"
                                   hx-push-url="true">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="javascript:void(0)" 
                                   onclick="clearSearchInput('purchaseSearch', 'purchaseSearchForm')"
                                   class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none"
                                   title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </a>
                            }
                            <datalist id="purchaseSearchDatalist">
                                @foreach (var item in Model.SearchSuggestions)
                                {
                                    <option value="@item">@item</option>
                                }
                            </datalist>
                        </div>

                        <!-- Up to Down / Down to Up Sort Direction Button -->
                        <button type="button" 
                                class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                id="btnToggleSort"
                                onclick="toggleSortDirection('sortDirInput', 'purchaseSearchForm')"
                                title="@(Model.SortDir == "asc" ? "Sort: Oldest first (Up to Down). Click for Newest first." : "Sort: Newest first (Down to Up). Click for Oldest first.")">
                            <i class="bi @(Model.SortDir == "asc" ? "bi-sort-up text-primary fw-bold" : "bi-sort-down text-dark fw-bold") fs-6"></i>
                            <span class="small d-none d-lg-inline">@(Model.SortDir == "asc" ? "Oldest First" : "Newest First")</span>
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    @if (Model.Entries != null && Model.Entries.Any())
                    {
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <h6 class="text-muted text-uppercase mb-0 text-center"
                                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Total Purchases :
                                    <span class="fw-bold fs-6 text-dark">
                                        @Model.Pagination.TotalItems
                                    </span>
                                </h6>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 text-end d-flex justify-content-end align-items-center gap-2">
                    <a asp-page-handler="DownloadExcel" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PsdId="@Model.PsdId" class="btn btn-outline-success text-nowrap" title="Export to Excel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                    <a href="/Purchase/Entry" class="btn btn-primary text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Purchase
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm" id="table-container">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 px-4 py-3" style="width: 10%;">Purchase #</th>
                            <th class="border-0 px-4 py-3" style="width: 10%;">Date</th>
                            <th class="border-0 px-4 py-3" style="width: 14%;">Supplier</th>
                            <th class="border-0 px-4 py-3">Narration / Details</th>
                            <th class="border-0 px-4 py-3" style="width: 10%;">Status</th>
                            <th class="border-0 px-4 py-3 text-center" style="width: 10%;">Return (DN)</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 11%;">Grand Total</th>
                            <th class="border-0 px-4 py-3 text-end" style="width: 12%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entries != null && Model.Entries.Any())
                        {
                            foreach (var item in Model.Entries)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <a href="/Purchase/Entry?id=@item.EntryId"
                                           class="text-decoration-none fw-semibold text-danger">
                                            PUR-@item.EntryNumber
                                        </a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@(item.EntryDate?.ToString("dd-MM-yyyy"))</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-medium text-dark">@item.SupplierName</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.LineDetails != null && item.LineDetails.Any())
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var itm in item.LineDetails)
                                                {
                                                    <div class="d-flex flex-wrap align-items-center gap-1">
                                                        <span class="fw-bold text-dark">@itm.ItemName</span>
                                                        @if (itm.Qty.HasValue && itm.Qty > 0)
                                                        {
                                                            <span class="badge bg-light text-dark border"><i class="bi bi-box me-1"></i>@itm.Qty?.ToString("N0") Bags</span>
                                                        }
                                                        @if (itm.Lbs.HasValue && itm.Lbs > 0)
                                                        {
                                                            <span class="badge bg-light text-secondary border">@itm.Lbs?.ToString("N2") Lbs</span>
                                                        }
                                                        @if (itm.Rate.HasValue && itm.Rate > 0)
                                                        {
                                                            <span class="badge bg-light text-success border">Rate: @itm.Rate?.ToString("N2")</span>
                                                        }
                                                    </div>
                                                }
                                                @if (item.EntryRefNo.HasValue)
                                                {
                                                    <div class="mt-1">
                                                        <a href="/Purchase/SodaView/@item.EntryRefNo" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none" style="font-size: 11px;" title="View Purchase Soda Contract PDF">
                                                            <i class="bi bi-file-earmark-text me-1"></i>Soda: PSD-@item.PsdNumber <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                                        </a>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Remarks) && item.Remarks != "Purchase Invoice" && item.Remarks != "-")
                                                {
                                                    <div class="text-muted small mt-1 fst-italic">@item.Remarks</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                @if (item.EntryRefNo.HasValue)
                                                {
                                                    <a href="/Purchase/SodaView/@item.EntryRefNo" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary text-decoration-none" style="font-size: 11px;" title="View Purchase Soda Contract PDF">
                                                        <i class="bi bi-file-earmark-text me-1"></i>Soda: PSD-@item.PsdNumber <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Remarks) && item.Remarks != "Purchase Invoice" && item.Remarks != "-")
                                                {
                                                    <div class="text-muted small mt-1">@item.Remarks</div>
                                                }
                                                else if (!item.EntryRefNo.HasValue)
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.IsPosted)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-semibold" style="font-size: 11px; padding: 5px 10px;">
                                                <i class="bi bi-check-circle-fill me-1"></i> Posted
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning fw-semibold" style="font-size: 11px; padding: 5px 10px;">
                                                <i class="bi bi-pencil-fill me-1"></i> Draft
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        @if (item.HasReturn)
                                        {
                                            <a href="/Purchase/PurchaseReturnIndex?SearchTerm=@item.ReturnNumber"
                                               class="badge bg-danger-subtle text-danger border border-danger-subtle text-decoration-none"
                                               title="View Purchase Return">
                                                <i class="bi bi-arrow-return-left me-1"></i>@item.ReturnNumber
                                                <span class="d-block mt-1 fw-bold">@item.ReturnAmount.ToString("N2")</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <span class="fw-bold text-success">@item.GrandTotalNet?.ToString("N2")</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            <a href="/Purchase/InvoiceView/@item.EntryId" class="btn btn-sm btn-outline-info" title="View / Print Purchase PDF" target="_blank">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>
                                            @if (!item.IsPosted)
                                            {
                                                <form method="post" asp-page-handler="PostToLedger" asp-route-id="@item.EntryId" 
                                                      onsubmit="return confirm('Post PUR-@item.EntryNumber to ledger? This action cannot be undone and will lock the record.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Post to Ledger">
                                                        <i class="bi bi-send-fill"></i>
                                                    </button>
                                                </form>

                                                <form method="post" 
                                                      asp-page-handler="Delete" 
                                                      asp-route-id="@item.EntryId" 
                                                      onsubmit="return confirm('Are you sure you want to delete this purchase entry?');">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="UnpostFromLedger" asp-route-id="@item.EntryId"
                                                      onsubmit="return confirm('Unpost PUR-@item.EntryNumber from ledger?\n\nThis will delete the GL entries (Debit + Credit) from the TRANS table.\n\nThe purchase entry will remain but become editable again.')">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Unpost from Ledger">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No Purchase Entries Found</h5>
                                        <p class="text-muted">Create your first purchase entry to get started</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('submit', function (e) {
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');

            if (btn && (btn.title === 'Post to Ledger' || 
                        btn.title === 'Unpost from Ledger' ||
                form.getAttribute('asp-page-handler') === 'PostToLedger' || 
                form.getAttribute('asp-page-handler') === 'UnpostFromLedger')) {
                
                setTimeout(() => {
                    if (!e.defaultPrevented) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    }
                }, 10);
            }
        });
    </script>
}
