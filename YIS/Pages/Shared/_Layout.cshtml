@using System.Text.Json
@{
    var currentPath = Context.Request.Path.Value ?? "";
    var rolePermissionsJson = Context.Session.GetString("RolePermissions");
    var permissionsMap = string.IsNullOrEmpty(rolePermissionsJson)
    ? new Dictionary<string, JsonElement>()
    : JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(rolePermissionsJson);

    bool HasUrlAccess(string url)
    {
        if (string.IsNullOrEmpty(url) || url == "/" || url == "/Dashboard" || url == "/Login" || url == "/AccessDenied" || url
        == "/Logout" || url.Contains("."))
            return true;

        // Exact match check
        if (permissionsMap != null && permissionsMap.ContainsKey(url))
        {
            var perm = permissionsMap[url];
            return perm.TryGetProperty("CanRead", out var canReadProp) && canReadProp.GetBoolean();
        }

        // Default: Allow if not explicitly restricted in the dictionary
        // (to avoid blocking internal/system pages not registered in menus)
        return true;
    }

    if (!HasUrlAccess(currentPath))
    {
        Context.Response.Redirect("/AccessDenied");
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yarn Pro</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/img/Favicon.png" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" />

    <!-- TomSelect CSS (Smart Searchable Dropdowns) -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">

    <!-- Flatpickr CSS (Strict DD-MM-YYYY Datepicker) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        .flatpickr-calendar {
            font-family: 'Inter', sans-serif !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.12) !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
        }
        .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange {
            background: #0d6efd !important;
            border-color: #0d6efd !important;
        }
        input.flatpickr-input[readonly] {
            background-color: #fff !important;
            cursor: pointer;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Permanent Toast Container -->
    <div id="toast-container"
        style="position: fixed; top: 70px; right: 15px; z-index: 999999; display: flex; flex-direction: column; gap: 10px; pointer-events: none;">
    </div>

    @if (YIS.Helpers.AuthHelper.IsImpersonating(Context))
    {
        var targetUserName = User.Identity?.Name ?? "User";
        var adminName = YIS.Helpers.AuthHelper.GetOriginalAdminName(Context) ?? "Administrator";

        <div class="impersonation-bar shadow-sm d-flex justify-content-between align-items-center px-4 py-2"
             style="background: linear-gradient(90deg, #d97706 0%, #b45309 100%); color: #ffffff; position: sticky; top: 0; z-index: 99999; font-size: 0.9rem;">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill fs-5 me-2 text-warning"></i>
                <span>
                    <strong>PROXY MODE ACTIVE:</strong> You are viewing the system as
                    <span class="badge bg-light text-dark fw-bold px-2 py-1 mx-1">@targetUserName</span>
                    (Original Admin: <em>@adminName</em>)
                </span>
            </div>
            <a href="/StopImpersonation" class="btn btn-sm btn-light text-dark fw-bold px-3 py-1 shadow-sm d-flex align-items-center text-decoration-none">
                <i class="bi bi-box-arrow-left me-1 text-danger"></i>
                Switch Back to Admin
            </a>
        </div>
    }

    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Sidebar Overlay (Mobile) -->
        <div class="sidebar-overlay"></div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Navbar -->
            @await Html.PartialAsync("_Navbar")

            <!-- Content Area -->
            <div class="content-wrapper">
                <!-- Page Title -->
                @if (ViewData["Title"] != null)
                {
                    <h1 class="page-title-main">@ViewData["Title"]</h1>
                }

                <!-- Breadcrumb -->
                <div class="breadcrumb-container">
                    <nav class="breadcrumb">
                        <a href="/Dashboard" class="breadcrumb-item">
                            <i class="bi bi-house-door"></i>
                            <span>Home</span>
                        </a>

                        @if (ViewData["BreadcrumbParent"] != null)
                        {
                            <i class="bi bi-chevron-right breadcrumb-separator"></i>
                            @if (ViewData["BreadcrumbParentUrl"] != null)
                            {
                                <a href="@ViewData["BreadcrumbParentUrl"]" class="breadcrumb-item">
                                    @ViewData["BreadcrumbParent"]
                                </a>
                            }
                            else
                            {
                                <span class="breadcrumb-item">@ViewData["BreadcrumbParent"]</span>
                            }
                        }

                        @if (ViewData["Title"] != null && ViewData["Title"].ToString() != "Dashboard")
                        {
                            <i class="bi bi-chevron-right breadcrumb-separator"></i>
                            <span class="breadcrumb-item active">@ViewData["Title"]</span>
                        }
                    </nav>
                </div>

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- HTMX -->
    <!-- HTMX -->
    <script src="~/lib/htmx/htmx.min.js"></script>

    <!-- Bootstrap Bundle (includes Popper) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- TomSelect JS (Smart Searchable Dropdowns) -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <!-- Dashboard JS -->
    <script src="~/js/dashboard.js"></script>

    <!-- Toast Data for JS -->
    <div id="toast-data" style="display:none;" data-success="@(TempData["StatusMessage"] ?? "")"
        data-error="@(TempData["ErrorMessage"] ?? "")" data-warning="@(TempData["WarningMessage"] ?? "")"
        data-info="@(TempData["InfoMessage"] ?? "")"></div>

    <!-- Flatpickr JS (Strict DD-MM-YYYY format across all inputs) -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        function initDatePickers(container) {
            var root = container || document;
            var dateInputs = root.querySelectorAll("input[type='date']");
            dateInputs.forEach(function (el) {
                if (!el._flatpickr) {
                    flatpickr(el, {
                        dateFormat: "Y-m-d",
                        altInput: true,
                        altFormat: "d-m-Y",
                        allowInput: true
                    });
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            initDatePickers();
        });

        if (typeof htmx !== 'undefined') {
            document.body.addEventListener('htmx:afterSwap', function (evt) {
                initDatePickers(evt.target);
            });
        }

        function toggleSortDirection(inputId, formId) {
            var input = document.getElementById(inputId || 'sortDirInput');
            var form = document.getElementById(formId || 'searchForm') || (input ? input.closest('form') : null);
            if (input) {
                input.value = (input.value === 'asc') ? 'desc' : 'asc';
                if (form) {
                    var searchInput = form.querySelector('input[name="SearchTerm"]');
                    if (window.htmx && searchInput && searchInput.getAttribute('hx-get')) {
                        htmx.trigger(searchInput, 'search');
                    } else {
                        form.submit();
                    }
                }
            }
        }

        function clearSearchInput(inputId, formId) {
            var input = document.getElementById(inputId || 'searchInput');
            var form = document.getElementById(formId || 'searchForm') || (input ? input.closest('form') : null);
            if (input) {
                input.value = '';
                if (form) {
                    if (window.htmx && input.getAttribute('hx-get')) {
                        htmx.trigger(input, 'search');
                    } else {
                        form.submit();
                    }
                }
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>