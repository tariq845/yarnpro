        @if (!string.IsNullOrEmpty(activeCompanyName))
        {
            <div class=" d-flex align-items-center">
                <span
                    class=" text-dark  d-flex align-items-center">
                    <i class="bi bi-building-check me-2 text-primary"></i>
                    <span class="fw-bold">@activeCompanyName</span>
                </span>
            </div>
        }
    </div>

    <div class="navbar-right">
        <!-- Quick Add Button -->
        <!-- <button class="btn btn-primary" style="padding: 8px 16px;">
            <i class="bi bi-plus-lg"></i>
            <span>Quick Add</span>
        </button> -->

        <!-- Notifications -->
       @*  <div class="dropdown">
