        <!-- User Menu -->
        <div class="dropdown">
            <div class="navbar-user dropdown-toggle no-arrow" data-bs-toggle="dropdown" aria-expanded="false"
                style="cursor:pointer;">
                @{
                    string userName = User.Identity?.Name ?? "Guest";
                    string initials = "G";
                    if (!string.IsNullOrEmpty(userName) && userName != "Guest")
                    {
                        var parts = userName.Split(' ');
                        if (parts.Length > 1)
                        {
                            initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                        }
                        else
                        {
                            initials = userName.Substring(0, 1).ToUpper();
                        }
                    }
                }
                <div class="navbar-user-avatar">@initials</div>
                <div class="navbar-user-info">
                    <div class="navbar-user-name">@userName</div>
                </div>
                <i class="bi bi-chevron-down" style="color: var(--text-secondary);"></i>
            </div>
            <div class="dropdown-menu dropdown-menu-end">
                <a href="/Profile" class="dropdown-item">
                    <i class="bi bi-person"></i>
                    <span>My Profile</span>
                </a>
                <a href="/SelectCompany" class="dropdown-item">
                    <i class="bi bi-building"></i>
                    <span>Change Company</span>
                </a>
                <!-- <a href="/Settings" class="dropdown-item">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a> -->
                <!-- <a href="/Billing" class="dropdown-item">
                    <i class="bi bi-credit-card"></i>
                    <span>Billing</span>
                </a> -->
                <div class="dropdown-divider"></div>
                <a href="/Logout" class="dropdown-item" style="color: var(--danger-color);">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </div>
</header>
