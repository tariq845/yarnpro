@model YIS.Models.PaginationViewModel

@{
    if (Model == null) return;

    string GetPageUrl(int pageNum, int? pageSize = null)
    {
        var query = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in Context.Request.Query.Keys)
        {
            query[key] = Context.Request.Query[key]!;
        }
        query["currentPage"] = pageNum.ToString();
        query["pageSize"] = (pageSize ?? Model.PageSize).ToString();
        return "?" + string.Join("&", query.Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value)}"));
    }

    int startItem = Model.StartItem;
    int endItem = Model.EndItem;
}

<style>
    .mui-pagination-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        padding: 12px 18px;
        font-size: 13px;
        color: #64748b;
        user-select: none;
        background: transparent;
    }

    .mui-pagination-label {
        font-weight: 500;
        color: #64748b;
        margin-bottom: 0;
        font-size: 13px;
    }

    .mui-pagination-select {
        border: none;
        background-color: transparent;
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        padding: 2px 18px 2px 4px;
        cursor: pointer;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 2px center;
        background-size: 11px;
        transition: color 0.15s ease;
    }

    .mui-pagination-select:hover {
        color: #0f172a;
    }

    .mui-pagination-range {
        font-weight: 500;
        color: #1e293b;
        font-size: 13px;
        min-width: 55px;
        text-align: center;
    }

    .mui-pagination-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: #475569;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease;
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .mui-pagination-btn:hover:not(.disabled) {
        background-color: #f1f5f9;
        color: #0f172a;
    }

    .mui-pagination-btn.disabled {
        color: #cbd5e1 !important;
        cursor: default;
        pointer-events: none;
    }

    .mui-pagination-btn i {
        font-size: 13px;
    }
</style>

<div class="mui-pagination-bar flex-wrap">
    <!-- Rows per page selector -->
    <div class="d-flex align-items-center gap-1">
        <span class="mui-pagination-label">Rows per page:</span>
        <select class="mui-pagination-select" 
                id="paginationPageSizeSelect" 
                onchange="handlePageSizeChange(this.value)"
                title="Rows per page">
            @foreach (var opt in Model.PageSizeOptions)
            {
                if (opt == Model.PageSize)
                {
                    <option value="@opt" selected>@opt</option>
                }
                else
                {
                    <option value="@opt">@opt</option>
                }
            }
        </select>
    </div>

    <!-- Range Indicator: e.g. 1-5 of 5 -->
    <div class="mui-pagination-range">
        @startItem-@endItem of @Model.TotalItems
    </div>

    <!-- Navigation chevrons: < and > -->
    <div class="d-flex align-items-center gap-1">
        <!-- Previous Page -->
        <a class="mui-pagination-btn @(!Model.HasPreviousPage ? "disabled" : "")" 
           href="@(Model.HasPreviousPage ? GetPageUrl(Model.CurrentPage - 1) : "javascript:void(0)")"
           title="Previous page"
           aria-label="Previous page">
            <i class="bi bi-chevron-left"></i>
        </a>

        <!-- Next Page -->
        <a class="mui-pagination-btn @(!Model.HasNextPage ? "disabled" : "")" 
           href="@(Model.HasNextPage ? GetPageUrl(Model.CurrentPage + 1) : "javascript:void(0)")"
           title="Next page"
           aria-label="Next page">
            <i class="bi bi-chevron-right"></i>
        </a>
    </div>
</div>

<script>
    if (typeof handlePageSizeChange !== 'function') {
        function handlePageSizeChange(newSize) {
            var url = new URL(window.location.href);
            url.searchParams.set('pageSize', newSize);
            url.searchParams.set('currentPage', '1');
            window.location.href = url.toString();
        }
    }
</script>
