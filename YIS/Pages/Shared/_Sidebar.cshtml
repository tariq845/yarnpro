@using System.Text.Json
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var rolePermissionsJson = Context.Session.GetString("RolePermissions");
    var permissions = string.IsNullOrEmpty(rolePermissionsJson) 
        ? new Dictionary<string, JsonElement>() 
        : JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(rolePermissionsJson);

    bool HasAccess(string url)
    {
        return YIS.Helpers.AuthHelper.CanRead(Context, url);
    }
}

