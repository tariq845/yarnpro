@page
@model YIS.Pages.Purchase.EntryModel
@{
    ViewData["Title"] = "Purchase Entry";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="page-title">Purchase Entry</h2>
        </div>
    </div>

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3" style="background-color: var(--primary-color);
    border-color: var(--primary-color)">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-white"><i class="bi bi-cart-plus me-2"></i> Purchase Entry Details</h5>
                    <span class="badge bg-light text-dark fs-6">@Model.DisplayEntryNumber</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post" id="purchaseForm">
                    <input type="hidden" asp-for="Entry.EntryId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Section: Basic Info -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Entry.EntryDate" class="form-label fw-bold">Entry Date <span class="text-danger">*</span></label>
                            <input asp-for="Entry.EntryDate" class="form-control" type="date" required />
                            <span asp-validation-for="Entry.EntryDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Entry.EntryAttribute1" class="form-label fw-bold">Supplier <span class="text-danger">*</span></label>
                            <select asp-for="Entry.EntryAttribute1" class="form-select" asp-items="Model.SupplierList" required>
                                <option value="">-- Select Supplier --</option>
                            </select>
                            <span asp-validation-for="Entry.EntryAttribute1" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Entry.EntryRefCode" class="form-label fw-bold">Supplier Invoice #</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-receipt"></i></span>
                                <input asp-for="Entry.EntryRefCode" class="form-control" type="number" placeholder="Optional" />
                            </div>
                            <span asp-validation-for="Entry.EntryRefCode" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Section: References (Collapsed visually) -->
                    <div class="row g-3 mb-4 p-3 bg-light rounded border">
                        <div class="col-md-8">
                            <label asp-for="Entry.EntryRefNo" class="form-label fw-bold small text-muted text-uppercase">Reference (Purchase Soda)</label>
                            <select asp-for="Entry.EntryRefNo" class="form-select form-select-sm" asp-items="Model.PurchaseSodaList">
                                <option value="">-- Select Reference (Optional) --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Entry.EntryTermsDays" class="form-label fw-bold small text-muted text-uppercase">Payment Terms (Days)</label>
                            <input asp-for="Entry.EntryTermsDays" class="form-control form-control-sm" type="number" min="0" />
                        </div>
                    </div>

                    <!-- Section: Line Items -->
                    <div class="mb-4">
                        <label class="form-label fw-bold h6 mb-3"><i class="bi bi-list-check me-2"></i> Items</label>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle shadow-sm" id="lineItemsTable">
                                <thead class="bg-dark text-white text-center">
                                    <tr>
                                        <th style="width: 20%;">Item <span class="text-danger">*</span></th>
                                        <th style="width: 10%;">Qty <span class="text-danger">*</span></th>
                                        <th style="width: 10%;">LBS</th>
                                        <th style="width: 10%;">Rate <span class="text-danger">*</span></th>
                                        <th style="width: 12%;">Amount</th>
                                        <th style="width: 8%;">GST %</th>
                                        <th style="width: 10%;">GST Amt</th>
                                        <th style="width: 12%;">Net Amt</th>
                                        <th style="width: 5%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="lineItemsBody">
                                    @for (int i = 0; i < Model.LineItems.Count; i++)
                                    {
                                        <tr class="line-item-row align-middle">
                                            <input type="hidden" name="LineItems[@i].EntryId" value="@Model.LineItems[i].EntryId" />
                                            <td>
                                                <select name="LineItems[@i].ItemId" class="form-select form-select-sm item-select" required>
                                                    <option value="">-- Select --</option>
                                                    @foreach (var item in Model.ItemList)
                                                    {
                                                        if (Model.LineItems[i].ItemId?.ToString() == item.Value)
                                                        {
                                                            <option value="@item.Value" selected>@item.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" name="LineItems[@i].Qty" 
                                                       value="@Model.LineItems[i].Qty" class="form-control form-control-sm text-end qty-input" required />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" name="LineItems[@i].Lbs" 
                                                       value="@Model.LineItems[i].Lbs" class="form-control form-control-sm text-end lbs-input" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" name="LineItems[@i].Rate" 
                                                       value="@Model.LineItems[i].Rate" class="form-control form-control-sm text-end rate-input" required />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" name="LineItems[@i].Amount" 
                                                       value="@Model.LineItems[i].Amount" class="form-control form-control-sm text-end bg-light amount-input" readonly />
                                            </td>
                                             <td>
                                                <input type="number" step="0.01" min="0" name="LineItems[@i].GstPercent" 
                                                       value="@Model.LineItems[i].GstPercent" class="form-control form-control-sm text-end gst-percent-input" />
                                            </td>
                                             <td>
                                                <input type="number" step="0.01" name="LineItems[@i].GstAmount" 
                                                       value="@Model.LineItems[i].GstAmount" class="form-control form-control-sm text-end bg-light gst-amount-input" readonly />
                                            </td>
                                             <td>
                                                <input type="number" step="0.01" name="LineItems[@i].NetAmount" 
                                                       value="@Model.LineItems[i].NetAmount" class="form-control form-control-sm text-end fw-bold bg-light net-amount-input" readonly />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-link p-0 border-0 bg-transparent remove-row-btn" title="Delete">
                                                    <i class="bi bi-trash text-danger"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td colspan="4" class="text-end py-2 align-middle text-uppercase text-muted small">Grand Totals:</td>
                                        <td>
                                            <input type="text" id="grandTotalAmount" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly />
                                        </td>
                                         <td></td>
                                        <td>
                                            <input type="text" id="grandTotalGst" class="form-control form-control-sm fw-bold text-end bg-white border-0" readonly />
                                        </td>
                                        <td>
                                            <input type="text" id="grandTotalNet" class="form-control form-control-sm fw-bold text-end text-success bg-white border-0 fs-6" readonly />
                                        </td>
                                        <td class="text-center align-middle">
                                            <button type="button" class="btn btn-sm btn-primary rounded-circle" id="addRowBtn" title="Add Row">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Section: Commission & Remarks -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                             <label asp-for="Entry.EntryRemarks" class="form-label fw-bold">Remarks</label>
                             <textarea asp-for="Entry.EntryRemarks" class="form-control" rows="2" placeholder="Any additional notes..."></textarea>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold text-muted mb-3">Commission Details</h6>
                                    
                                    <div class="row mb-2 align-items-center">
                                         <div class="col-6"><label class="small text-muted mb-0">Apply Commission?</label></div>
                                         <div class="col-6">
                                             <select asp-for="Entry.EntryAttribute5" class="form-select form-select-sm" id="ddlCommission">
                                                <option value="No">No</option>
                                                <option value="Yes">Yes</option>
                                            </select>
                                         </div>
                                    </div>
                                    
                                    <div class="row mb-2 align-items-center">
                                         <div class="col-6"><label class="small text-muted mb-0">Agent</label></div>
                                         <div class="col-6">
                                              <select asp-for="Entry.EntryAttribute4" class="form-select form-select-sm" asp-items="Model.CommissionAgentList" id="ddlCommAgent">
                                                <option value="">-- Select --</option>
                                            </select>
                                         </div>
                                    </div>

                                     <div class="row mb-2 align-items-center">
                                         <div class="col-6"><label class="small text-muted mb-0">Percentage (%)</label></div>
                                         <div class="col-6">
                                              <input asp-for="Entry.EntryCommPer" class="form-control form-control-sm text-end" id="txtCommPer" type="number" step="0.01" min="0" />
                                         </div>
                                    </div>
                                    
                                     <div class="row mb-2 align-items-center">
                                         <div class="col-6"><label class="small text-muted mb-0 fw-bold">Comm. Amount</label></div>
                                         <div class="col-6">
                                              <input asp-for="Entry.EntryCommAmt" class="form-control form-control-sm text-end fw-bold bg-white" id="txtCommAmt" readonly />
                                         </div>
                                    </div>

                                     <div class="row align-items-center">
                                         <div class="col-6"><label class="small text-muted mb-0">Sukria</label></div>
                                         <div class="col-6">
                                               <input asp-for="Entry.EntryCommSukri" class="form-control form-control-sm text-end" id="txtSukri" type="number" step="0.01" min="0" />
                                         </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/Purchase/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5"><i class="bi bi-save me-2"></i> Save</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<!-- Template for new row -->
<template id="lineItemRowTemplate">
    <tr class="line-item-row align-middle">
        <input type="hidden" name="LineItems[__INDEX__].EntryId" value="0" />
        <td>
            <select name="LineItems[__INDEX__].ItemId" class="form-select form-select-sm item-select" required>
                <option value="">-- Select --</option>
                @foreach (var item in Model.ItemList)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </td>
        <td>
            <input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Qty" class="form-control form-control-sm text-end qty-input" required />
        </td>
        <td>
            <input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Lbs" class="form-control form-control-sm text-end lbs-input" />
        </td>
        <td>
            <input type="number" step="0.01" min="0" name="LineItems[__INDEX__].Rate" class="form-control form-control-sm text-end rate-input" required />
        </td>
        <td>
            <input type="number" step="0.01" name="LineItems[__INDEX__].Amount" class="form-control form-control-sm text-end bg-light amount-input" readonly />
        </td>
        <td>
            <input type="number" step="0.01" min="0" name="LineItems[__INDEX__].GstPercent" class="form-control form-control-sm text-end gst-percent-input" />
        </td>
        <td>
            <input type="number" step="0.01" name="LineItems[__INDEX__].GstAmount" class="form-control form-control-sm text-end bg-light gst-amount-input" readonly />
        </td>
        <td>
            <input type="number" step="0.01" name="LineItems[__INDEX__].NetAmount" class="form-control form-control-sm text-end fw-bold bg-light net-amount-input" readonly />
        </td>
        <td class="text-center">
           <button type="button"
                                                    class="btn btn-link p-0 border-0 bg-transparent remove-row-btn"
                                                    title="Delete">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const lineItemsBody = document.getElementById('lineItemsBody');
            const addRowBtn = document.getElementById('addRowBtn');
            const grandTotalAmountInput = document.getElementById('grandTotalAmount');
            const grandTotalGstInput = document.getElementById('grandTotalGst');
            const grandTotalNetInput = document.getElementById('grandTotalNet');
            const template = document.getElementById('lineItemRowTemplate');

            // Commission Elements
            const commissionSelect = document.getElementById('ddlCommission');
            const commAgentSelect = document.getElementById('ddlCommAgent');
            const commPerInput = document.getElementById('txtCommPer');
            const commAmtInput = document.getElementById('txtCommAmt');
            const sukriInput = document.getElementById('txtSukri');

            // Calculate row values
            function calculateRow(row) {
                const qtyInput = row.querySelector('.qty-input');
                const rateInput = row.querySelector('.rate-input');
                const amountInput = row.querySelector('.amount-input');
                const gstPercentInput = row.querySelector('.gst-percent-input');
                const gstAmountInput = row.querySelector('.gst-amount-input');
                const netAmountInput = row.querySelector('.net-amount-input');

                const qty = parseFloat(qtyInput.value) || 0;
                const rate = parseFloat(rateInput.value) || 0;
                
                // 1. Amount
                const amount = qty * rate;
                amountInput.value = amount.toFixed(2);

                // 2. GST
                const gstPercent = parseFloat(gstPercentInput.value) || 0;
                const gstAmount = amount * (gstPercent / 100);
                gstAmountInput.value = gstAmount.toFixed(2);

                // 3. Net Amount
                const netAmount = amount + gstAmount;
                netAmountInput.value = netAmount.toFixed(2);
            }

            // Calculate all totals
            function calculateTotals() {
                let totalAmount = 0;
                let totalGst = 0;
                let totalNet = 0;

                const rows = lineItemsBody.querySelectorAll('.line-item-row');
                rows.forEach(row => {
                    const amountInput = row.querySelector('.amount-input');
                    const gstAmountInput = row.querySelector('.gst-amount-input');
                    const netAmountInput = row.querySelector('.net-amount-input');

                    totalAmount += parseFloat(amountInput.value) || 0;
                    totalGst += parseFloat(gstAmountInput.value) || 0;
                    totalNet += parseFloat(netAmountInput.value) || 0;
                });

                grandTotalAmountInput.value = totalAmount.toFixed(2);
                grandTotalGstInput.value = totalGst.toFixed(2);
                grandTotalNetInput.value = totalNet.toFixed(2);

                calculateCommission(totalAmount);
            }

            // Calculate Commission
            function calculateCommission(totalBasicAmount) {
                if (commissionSelect.value === 'Yes') {
                    const commPer = parseFloat(commPerInput.value) || 0;
                    const commAmt = totalBasicAmount * (commPer / 100);
                    commAmtInput.value = commAmt.toFixed(2);
                } else {
                    commAmtInput.value = '0.00';
                }
            }

            function toggleCommissionFields() {
                const isCommission = commissionSelect.value === 'Yes';
                commAgentSelect.disabled = !isCommission;
                commPerInput.disabled = !isCommission;
                sukriInput.disabled = !isCommission;

                if (!isCommission) {
                    commAgentSelect.value = '';
                    commPerInput.value = '0';
                    sukriInput.value = '';
                    commAmtInput.value = '0.00';
                    
                    // Gray out styling
                    commAgentSelect.style.backgroundColor = '#e9ecef';
                    commPerInput.style.backgroundColor = '#e9ecef';
                    sukriInput.style.backgroundColor = '#e9ecef';
                } else {
                    commAgentSelect.style.backgroundColor = '';
                    commPerInput.style.backgroundColor = '';
                    sukriInput.style.backgroundColor = '';
                    // Recalculate based on existing total
                    calculateTotals(); 
                }
            }

            // Re-index rows for correct Model Binding
            function reindexRows() {
                const rows = lineItemsBody.querySelectorAll('.line-item-row');
                rows.forEach((row, index) => {
                    row.querySelectorAll('input, select').forEach(input => {
                        if (input.name) {
                            input.name = input.name.replace(/LineItems\[\d+\]/, `LineItems[${index}]`);
                        }
                    });
                });
            }

            // Add new row
            addRowBtn.addEventListener('click', function () {
                const index = lineItemsBody.querySelectorAll('.line-item-row').length;
                const clone = template.content.cloneNode(true);
                const row = clone.querySelector('tr');

                // Replace Index placeholder
                row.innerHTML = row.innerHTML.replace(/__INDEX__/g, index);
                
                lineItemsBody.appendChild(row);
                attachRowEvents(row);
            });

            // Attach events to row inputs
            function attachRowEvents(row) {
                const inputs = row.querySelectorAll('input');
                inputs.forEach(input => {
                    input.addEventListener('input', function () {
                        calculateRow(row);
                        calculateTotals();
                    });
                });

                const removeBtn = row.querySelector('.remove-row-btn');
                removeBtn.addEventListener('click', function () {
                    if (lineItemsBody.querySelectorAll('.line-item-row').length > 1) {
                        row.remove();
                        reindexRows();
                        calculateTotals();
                    } else {
                        alert("At least one item is required.");
                    }
                });
            }

            // Initialize existing rows
            const existingRows = lineItemsBody.querySelectorAll('.line-item-row');
            existingRows.forEach(row => {
                attachRowEvents(row);
                // Initial calc for existing data
                calculateRow(row); 
            });
            
            // Initial Totals Calc
            calculateTotals();

            // Commission Events
            if (commissionSelect) commissionSelect.addEventListener('change', toggleCommissionFields);
            if (commPerInput) commPerInput.addEventListener('input', function() {
                const totalAmount = parseFloat(grandTotalAmountInput.value) || 0;
                calculateCommission(totalAmount);
            });
            
            // Initial Toggle
            toggleCommissionFields();
        });
    </script>
}
